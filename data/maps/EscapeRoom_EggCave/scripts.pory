const LOCALID_EDD_TRADE_NPC = 1
const LOCALID_TABLET1 = 2
const LOCALID_TABLETS_COOK_NPC = 3
const LOCALID_RARE_CANDY = 4
const LOCALID_TRAPINCH = 5
const LOCALID_TABLET2 = 6
const LOCALID_NURSE = 7


////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_EggCave_MapScripts {
    MAP_SCRIPT_ON_RESUME: EscapeRoom_EggCave_OnResumeMapScripts

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_RETRIEVED_HELD_ITEM, 1: EscapeRoom_MapScripts_RetrievedItemMessage
    ] 
}


script EscapeRoom_EggCave_OnResumeMapScripts {
    call(EscapeRoom_EggCave_DisableBagUse)
    call(EscapeRoom_EggCave_SetLostItemVars)
}

script EscapeRoom_EggCave_DisableBagUse{
    // disable bag use 
    if(flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
}

script EscapeRoom_EggCave_SetLostItemVars{
    // check if held item was retrieved -- sets frame table var if true
    if(flag(FLAG_DO_RECOVERED_ITEM_MESSAGE))
    {
        setvar(VAR_RETRIEVED_HELD_ITEM, 1)
    }
}


////////////////////////////////////////// EVENT SCRIPTS //////////////////////////////////////////


script EscapeRoom_EventScript_TrapinchBlocksPlayer{
    // triggered by trigger tile
    lockall

    // if Trapinch not yet ran from
    if(flag(FLAG_RAN_FROM_TRAPINCH) == FALSE){

        // move Trapinch 1 for single battle
        applymovement(LOCALID_TRAPINCH, TrapinchMoveIn)
        waitmovement(LOCALID_TRAPINCH)
        applymovement(OBJ_EVENT_ID_PLAYER, PlayerFaceUp)
        waitmovement(OBJ_EVENT_ID_PLAYER)

        // play sound
        playmoncry(SPECIES_TRAPINCH, CRY_MODE_ENCOUNTER)
        delay(40)
        waitmoncry

        // do battle
        call(EscapeRoom_EventScript_TrapinchBattle)
        
        ////// if battle won (ran away) ////// 

        // remove Trapinch 
        lockall
        fadescreen(FADE_TO_BLACK)
        setflag(FLAG_HIDE_TRAPINCH)
        removeobject(LOCALID_TRAPINCH)
        fadescreen(FADE_FROM_BLACK)

        // trapinch went away message
        msgbox(TrapinchWentAway, MSGBOX_AUTOCLOSE)
        waitmessage
        
        // set flags and prevent future trigger
        setvar(VAR_EGGCAVE_MAPSCRIPT_TRAPINCH_TRIGGER, 1)
        setflag(FLAG_RAN_FROM_TRAPINCH)

        // execute nurse script
        delay(30)
        call(EscapeRoom_EventScript_RescueNurse)
    }
    releaseall
}


movement PlayerFaceUp{
    face_up
}

movement TrapinchMoveIn{
    face_down
    walk_faster_down * 2
}

script EscapeRoom_EventScript_TrapinchBattle{
    lockall

    // backup party state
    backupplayerparty

    // allow items (wild battle)
    if(flag(FLAG_TOGGLE_BAG_USE) == TRUE){
        clearflag(FLAG_TOGGLE_BAG_USE)
    }

    createmon(
        side=1,
        slot=0,
        species=SPECIES_TRAPINCH,
        level=90,
        nature=3, // adamant
        abilityNum=1, // arena trap
        gender=1,
        move1=MOVE_EARTHQUAKE
        // evs
        hpEv=0,
        defEv=0,
        atkEv=252, 
        spDefEv=4,
        speedEv=252,
        // ivs
        hpIv=31,
        atkIv=31,
        defIv=31,
        speedIv=31,
        spAtkIv=31,
        spDefIv=31
    )
    dowildbattle
    releaseall
}

script EscapeRoom_EventScript_RescueNurse{
    // move to player
    playse(SE_PIN)
    applymovement(LOCALID_NURSE, MoveNurseFaceRight)
    waitmovement(LOCALID_NURSE)
    applymovement(LOCALID_NURSE, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_NURSE)
    delay(30)
    applymovement(LOCALID_NURSE, MoveNurseToPlayer)
    waitmovement(LOCALID_NURSE)

    // face to nurse
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerFaceLeft)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    // scenario: no heal required
    msgbox(NurseMessage1, MSGBOX_AUTOCLOSE)
    waitmessage

    // givemoney
    addmoney(2000)
    lockall
    message(MoneyReceived)
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare
    delay(10)
    closemessage
    
    // check if heal required
    partymonhasfainted
    lockall

    // scenario: heal player
    if(var(VAR_RESULT) != PARTY_SIZE){
        msgbox(NurseMessageHeal1, MSGBOX_DEFAULT)

        special(HealPlayerParty)
        playse(SE_USE_ITEM)
        lockall
        waitse
        delay(10)
        waitmessage
    }
    lockall
    
    // message
    msgbox(NurseMessage2, MSGBOX_AUTOCLOSE)
    waitmessage
    

    // move player aside
    applymovement(OBJ_EVENT_ID_PLAYER, MovePlayerAside)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    // move away
    applymovement(LOCALID_NURSE, MoveNurseAway)
    waitmovement(LOCALID_NURSE)

    // remove object
    playse(SE_EXIT)
    delay(5)
    removeobject(LOCALID_NURSE)
    setflag(FLAG_NURSE_RESCUED)
    waitse
}

movement MoveNurseFaceRight {
    face_right
}

movement MoveNurseToPlayer{
    face_up
    walk_fast_up
    face_right
    walk_fast_right * 2
}

movement MoveNurseAway {
    walk_fast_right * 3
    face_down
    walk_fast_down
}

movement MovePlayerAside {
    face_up
    walk_up
    face_down
}

movement PlayerFaceLeft {
    face_left
}


script EscapeRoom_EggCave_EventScript_FindRareCandy{
    lockall
    finditem(ITEM_RARE_CANDY)
    removeobject(LOCALID_RARE_CANDY)
    setflag(FLAG_RARE_CANDY_OBTAINED)
    releaseall
}

////// TEXT ///////

text TrapinchWentAway{
    "The Trapinch disappeared into the\n"
    "ground."
}

text NurseMessage1{
    "Thank you so much!\n"
    "That Pokémon would not let me out!\p"
    "I don't know what I would've done if\n"
    "it weren't for you.\p"
    "Here, take this.\n"
    "Call it a rescue reward!"
}

text NurseMessageHeal1{
    "It also looks like your Pokémon got\n"
    "hurt in battle.\p"
    "Allow me to fix that."
}

text NurseMessage2{
    "Take care!"
}

text MoneyReceived{
    "{PLAYER} received ¥2.000!"
}