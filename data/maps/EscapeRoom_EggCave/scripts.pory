const LOCALID_EDD_TRADE_NPC = 1
const LOCALID_TABLET1 = 2
const LOCALID_TABLETS_COOK_NPC = 3
const LOCALID_RARE_CANDY = 4
const LOCALID_TRAPINCH = 5
const LOCALID_TABLET2 = 6
const LOCALID_2000_CASH = 7


////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_EggCave_MapScripts {
    MAP_SCRIPT_ON_RESUME: EscapeRoom_EggCave_OnResumeMapScripts

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_RETRIEVED_HELD_ITEM, 1: EscapeRoom_MapScripts_RetrievedItemMessage
    ] 
}


script EscapeRoom_EggCave_OnResumeMapScripts {
    call(EscapeRoom_EggCave_DisableBagUse)
    call(EscapeRoom_EggCave_SetLostItemVars)
}

script EscapeRoom_EggCave_DisableBagUse{
    // disable bag use 
    if(flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
}

script EscapeRoom_EggCave_SetLostItemVars{
    // check if held item was retrieved -- sets frame table var if true
    if(flag(FLAG_DO_RECOVERED_ITEM_MESSAGE))
    {
        setvar(VAR_RETRIEVED_HELD_ITEM, 1)
    }
}



script EscapeRoom_EventScript_TrapinchBlocksPlayer{
    // triggered by trigger tile
    lockall

    // if Trapinch not yet ran from
    if(flag(FLAG_RAN_FROM_TRAPINCH) == FALSE){
        
        // move Trapinch
        applymovement(LOCALID_TRAPINCH, TrapinchMoveIn)
        waitmovement(LOCALID_TRAPINCH)

        // face trapinch
        applymovement(OBJ_EVENT_ID_PLAYER, PlayerFaceUp)
        waitmovement(OBJ_EVENT_ID_PLAYER)

        // play sound
        playmoncry(SPECIES_TRAPINCH, CRY_MODE_ENCOUNTER)
        delay(40)
	    waitmoncry

        // do battle
        call(EscapeRoom_EventScript_TrapinchBattle)

        ////// if battle won (ran away) ////// 

        // remove Trapinch 
        playse(SE_EXIT)
        fadescreen(FADE_TO_BLACK)
        setflag(FLAG_HIDE_TRAPINCH)
        removeobject(LOCALID_TRAPINCH)
        fadescreen(FADE_FROM_BLACK)

        // set flags and prevent future trigger
        setvar(VAR_EGGCAVE_MAPSCRIPT_TRAPINCH_TRIGGER, 1)
        setflag(FLAG_RAN_FROM_TRAPINCH)
    }
    releaseall
}

movement PlayerFaceUp{
    face_up
}

movement TrapinchMoveIn{
    face_down
    walk_faster_down * 2
}

script EscapeRoom_EventScript_TrapinchBattle{
    lockall

    // backup party state
    backupplayerparty

    // allow items (wild battle)
    if(flag(FLAG_TOGGLE_BAG_USE) == TRUE){
        clearflag(FLAG_TOGGLE_BAG_USE)
    }

    // set annihilape battle
    createmon(
        side=1,
        slot=0,
        species=SPECIES_TRAPINCH,
        level=80,
        nature=3, // adamant
        abilityNum=1, // arena trap
        gender=1,
        move1=MOVE_EARTHQUAKE
        // evs
        hpEv=4,
        defEv=0,
        atkEv=252, 
        spDefEv=252,
        // ivs
        hpIv=31,
        atkIv=31,
        defIv=31,
        speedIv=31,
        spAtkIv=31,
        spDefIv=31
    )
    dowildbattle
    releaseall
}

script EscapeRoom_EggCave_EventScript_FindRareCandy{
    lockall
    finditem(ITEM_RARE_CANDY)
    removeobject(LOCALID_RARE_CANDY)
    setflag(FLAG_RARE_CANDY_OBTAINED)
    releaseall
}

script EscapeRoom_EggCave_EventScript_Find2000Cash{
    lockall
    addmoney(2000)
    message("{PLAYER} received ¥2.000!")
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare
    removeobject(LOCALID_2000_CASH)
    setflag(FLAG_2000_CASH_OBTAINED)
    releaseall
}

