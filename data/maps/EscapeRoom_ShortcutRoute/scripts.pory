
const LOCALID_SMASH_ROCK = 1
const LOCALID_MAP_SWITCH3 = 2
const LOCALID_CHOICE_SPECS = 3
const LOCALID_STARDUST = 4


mapscripts EscapeRoom_ShortcutRoute_MapScripts {
    MAP_SCRIPT_ON_LOAD: SetWallOnLoad
}


script SetWallOnLoad{
    if(flag(FLAG_MAP_SWITCHES_SOLVED) == FALSE){
        setmetatile(8, 0, METATILE_Cave_EntranceCover, TRUE)
        setmetatile(9, 0, METATILE_Cave_EntranceCover, TRUE)
        setmetatile(10, 0, METATILE_Cave_EntranceCover, TRUE)
        setmetatile(8, 1, METATILE_Cave_SealedChamberBraille_Mid, TRUE)
        setmetatile(9, 1, METATILE_Cave_SealedChamberBraille_Mid, TRUE)
        setmetatile(10, 1, METATILE_Cave_SealedChamberBraille_Mid, TRUE) 
    }
}


script EscapeRoom_ShortcutRoute_EventScript_FindChoiceSpecs{
    lockall
    finditem(ITEM_CHOICE_SCARF)
    removeobject(LOCALID_CHOICE_SPECS)
    setflag(FLAG_CHOICE_SPECS_OBTAINED)
    releaseall
}

script EscapeRoom_ShortcutRoute_EventScript_FindStardust{
    lockall
    finditem(ITEM_STARDUST)
    removeobject(LOCALID_STARDUST)
    setflag(FLAG_STARDUST_OBTAINED)
    releaseall
}


