
const LOCALID_SMASH_ROCK = 1
const LOCALID_MAP_SWITCH3 = 2
const LOCALID_ROCK1 = 3
const LOCALID_ROCK2 = 4
const LOCALID_ROCK3 = 5
const LOCALID_ROCK4 = 6
const LOCALID_DRUG_HIKER = 7
const LOCALID_TM_TRICK = 8
const LOCALID_TRAINER0 = 9
const LOCALID_EXP_CANDY = 10

////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_ShortcutRoute_MapScripts {
    // MAP_SCRIPT_ON_LOAD: SetWallOnLoad
    MAP_SCRIPT_ON_TRANSITION: CheckResetRocks
    MAP_SCRIPT_ON_RESUME: EscapeRoom_ShortcutRoute_OnResumeMapScripts

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_RETRIEVED_HELD_ITEM, 1: EscapeRoom_MapScripts_RetrievedItemMessage
        VAR_DO_ERROR_MESSAGE, 1: EscapeRoom_MapScripts_DoErrorMessage
    ] 
}


script EscapeRoom_ShortcutRoute_OnResumeMapScripts {
    call(CheckIfBerryJuiceObtained)
    call(EscapeRoom_ShortcutRoute_DisableBagUse)
    call(EscapeRoom_ShortcutRoute_SetLostItemVars)
}

script EscapeRoom_ShortcutRoute_DisableBagUse{
    // disable bag use 
    if(flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
}

script EscapeRoom_ShortcutRoute_SetLostItemVars{
    // check if held item was retrieved -- sets frame table var if true
    if(flag(FLAG_DO_RECOVERED_ITEM_MESSAGE))
    {
        setvar(VAR_RETRIEVED_HELD_ITEM, 1)
    }
}


// manually set wall locations if used
script SetWallOnLoad{
    if(flag(FLAG_MAP_SWITCHES_SOLVED) == FALSE){
        setmetatile(8, 0, METATILE_Cave_EntranceCover, TRUE)
        setmetatile(9, 0, METATILE_Cave_EntranceCover, TRUE)
        setmetatile(10, 0, METATILE_Cave_EntranceCover, TRUE)
        setmetatile(8, 1, METATILE_Cave_SealedChamberBraille_Mid, TRUE)
        setmetatile(9, 1, METATILE_Cave_SealedChamberBraille_Mid, TRUE)
        setmetatile(10, 1, METATILE_Cave_SealedChamberBraille_Mid, TRUE) 
    }
}

script CheckResetRocks{
    call(ResetSmashRock1)
    call(ResetShuckleSmashRocks)
}


script ResetSmashRock1{
    // reset rock smash rock1 untill rock2 is cleared (prevent potential softlock)
    if(!(flag(FLAG_HIDE_SMASH_ROCK1) && flag(FLAG_HIDE_SMASH_ROCK2))){
        if(flag(FLAG_HIDE_SMASH_ROCK2) == FALSE){
            clearflag(FLAG_HIDE_SMASH_ROCK1)
        }
        else{
            setflag(FLAG_HIDE_SMASH_ROCK1)
        }
    }
}

script ResetShuckleSmashRocks{
    // reset shuckle rocks until berry juice obtained
    if(!flag(FLAG_BERRY_JUICE_OBTAINED)){
        clearflag(FLAG_SHUCKLE_SMASH_ROCK1)
        clearflag(FLAG_SHUCKLE_SMASH_ROCK2)
        clearflag(FLAG_SHUCKLE_SMASH_ROCK3)
        clearflag(FLAG_SHUCKLE_SMASH_ROCK4)
    }
}

script CheckIfBerryJuiceObtained{
    if(flag(FLAG_BERRY_JUICE_OBTAINED) == FALSE){
        // check held items for berry juice (only 2 pokemon party at this stage)
        checkpartyitem(0)
        if(var(VAR_0x8005) == ITEM_BERRY_JUICE){  // if item in party slot 0
            setflag(FLAG_BERRY_JUICE_OBTAINED)
        }
        checkpartyitem(1)
        if(var(VAR_0x8005) == ITEM_BERRY_JUICE){  // if item in party slot 1
            setflag(FLAG_BERRY_JUICE_OBTAINED)
        }

        // check bag for berry juice
        checkitem(ITEM_BERRY_JUICE)
        if(var(VAR_RESULT) == TRUE){
            setflag(FLAG_BERRY_JUICE_OBTAINED)
            removelostitem(ITEM_JABOCA_BERRY)
        }


        if(flag(FLAG_BERRY_JUICE_OBTAINED) == TRUE){
            // ERROR CHECK
            // - trainer 4 defeated
            // - jaboca berry used
            checkpartyitem(0)
            copyvar(VAR_0x8006, VAR_0x8005)
            checkpartyitem(1)
            copyvar(VAR_0x8007, VAR_0x8005)

            checkitem(ITEM_JABOCA_BERRY)
            copyvar(VAR_TEMP_4, VAR_RESULT)

            if(!flag(FLAG_TRAINER4_DEFEATED)
                || (var(VAR_0x8006) == ITEM_JABOCA_BERRY || var(VAR_0x8007) == ITEM_JABOCA_BERRY)
                || var(VAR_TEMP_4) == TRUE)
            {
                // do error message
                setvar(VAR_DO_ERROR_MESSAGE, 1)
            }
        }
    }
}


////////////////////////////////////////// EVENT SCRIPTS //////////////////////////////////////////


script HikerSellAbilityCapsule{
    lock
    faceplayer
    if(flag(FLAG_ABILITY_CAPSULE_BOUGHT) == FALSE){

        // ask buy drugs
        msgbox(RockSmashNPCsellDrugs, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){

            // check enough money
            checkmoney(1025)
            if(var(VAR_RESULT) == FALSE){
                // not enough money message
                msgbox(RockSmashNPCnotEnoughMoney, MSGBOX_AUTOCLOSE)
                waitmessage
                releaseall
                end
            }

            removemoney(1025)

            // give Ability Capsule
            giveitem(ITEM_ABILITY_CAPSULE)

            // final message
            msgbox(RockSmashNPCsellAcceptedMessage, MSGBOX_AUTOCLOSE)
            waitmessage

            setflag(FLAG_ABILITY_CAPSULE_BOUGHT)
            // setflag(FLAG_MENTAL_HERB_SOLD_OUT)


            // ERROR CHECK
            // - 0 money
            // - trainer 5 defeated
            // - berry juice used
            checkpartyitem(0)
            copyvar(VAR_0x8006, VAR_0x8005)
            checkpartyitem(1)
            copyvar(VAR_0x8007, VAR_0x8005)

            checkitem(ITEM_BERRY_JUICE)
            copyvar(VAR_TEMP_4, VAR_RESULT)

            checkexactmoney(0)
            if(var(VAR_RESULT) == FALSE
                || !flag(FLAG_TRAINER5_DEFEATED)
                || (var(VAR_0x8006) == ITEM_BERRY_JUICE || var(VAR_0x8007) == ITEM_BERRY_JUICE)
                || var(VAR_TEMP_4) == TRUE)
            {
                lockall
                msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
                waitmessage
                releaseall
            }
        }
        else{
            // sell declined message
            msgbox(RockSmashNPCsellDeclined, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    else{
        // final message
        msgbox(RockSmashNPCFinalMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
}

script FindTmTrickItem{
    lockall
    finditem(ITEM_TM38)
    removeobject(LOCALID_TM_TRICK)
    setflag(FLAG_TM_TRICK_OBTAINED)
    releaseall
}

script FindExpCandy{
    lockall
    finditem(ITEM_EXP_CANDY_S)
    removeobject(LOCALID_EXP_CANDY)
    setflag(FLAG_EXP_CANDY_OBTAINED)
    releaseall
}


text RockSmashNPCsellDrugs{
    "Hey kid, wanna buy some dru- OH HEY!\p"

    "You're the one who smashed that rock\n"
    "for me, aren't you?\p"

    "For you I've got a special offer!\n"
    "An Ability Capsule for only ¥1025.\l"
    "What do you say?"
}

text RockSmashNPCsellDeclined{
    "You know where to find me."
}

text RockSmashNPCnotEnoughMoney{
    "Come back when you have the money."
}

text RockSmashNPCsellAcceptedMessage{
    "Pleasure doing business."
}

text RockSmashNPCFinalMessage{
    "Move along now."
}