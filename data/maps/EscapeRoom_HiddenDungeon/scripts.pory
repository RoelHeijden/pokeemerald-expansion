
const LOCALID_TRAINER11 = 5
const LOCALID_BAGON_TRADER = 6
const LOCALID_DUNGEON_GUARD = 11
const LOCALID_HINT_GUY_2 = 12
const LOCALID_MOVE_RELEARNER = 13
const LOCALID_YAMASK_NPC = 14


////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_HiddenDungeon_MapScripts {
    MAP_SCRIPT_ON_RESUME: EscapeRoom_HiddenDungeon_MapScript_OnResumeScripts
    MAP_SCRIPT_ON_TRANSITION: EscapeRoom_HiddenDungeon_MapScript_OnTransitionScripts

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1: EscapeRoom_MapScripts_FindBallAferUse
        VAR_RETRIEVED_HELD_ITEM, 1: EscapeRoom_MapScripts_RetrievedItemMessage
        VAR_ASK_RESET_PREDAMAGE, 1: EscapeRoom_MapScripts_AskResetPredamage
        VAR_ASK_WARP_BACK, 1: EscapeRoom_MapScripts_AskWarpBack
        VAR_DO_SOMETHING_WRONG_MESSAGE, 1: EscapeRoom_MapScripts_SomethingWrongMessage
    ] 
}


script EscapeRoom_HiddenDungeon_MapScript_OnTransitionScripts{
    // keep dungeon guard moved from the door
    if(flag(FLAG_DUNGEON_ENTRY_GRANTED)){
        setobjectxyperm(LOCALID_DUNGEON_GUARD, 4, 8)
        setobjectmovementtype(LOCALID_DUNGEON_GUARD, MOVEMENT_TYPE_FACE_RIGHT)
    }

    // keep trainer11 moved away
    if(flag(FLAG_TRAINER11_DEFEATED)){
        setobjectxyperm(LOCALID_TRAINER11, 59, 8)
        setobjectmovementtype(LOCALID_TRAINER11, MOVEMENT_TYPE_FACE_DOWN)
    }
}

script EscapeRoom_HiddenDungeon_MapScript_OnResumeScripts{
    call(EscapeRoom_HiddenDungeon_DisableBagUse)
    call(EscapeRoom_HiddenDungeon_SetLostItemVars)
    call(EscapeRoom_MapScripts_CheckIfSecretPowerObtained)
    call(EscapeRoom_HiddenDungeon_CheckIfToxicOrbObtained)
    call(EscapeRoom_HiddenDungeon_CheckIfSSTicketObtained)

    // check if ask pre-damage restore
    // sets var if true
    call(EscapeRoom_MapScripts_CheckIfAskPreDamage)

    // check if ask warp back to previous section
    // sets var if true
    call(EscapeRoom_MapScripts_CheckIfAskWarpBack)

    // clear flag used in CheckIfAskPreDamage and CheckIfAskWarpBack
    if(flag(FLAG_PLAYER_JUST_LOST)){
        clearflag(FLAG_PLAYER_JUST_LOST)  
    }
} 

script EscapeRoom_HiddenDungeon_DisableBagUse{
    // disable bag use 
    if(flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
}

script EscapeRoom_HiddenDungeon_SetLostItemVars{
    // check if held item was retrieved -- sets frame table var if true
    if(flag(FLAG_DO_RECOVERED_ITEM_MESSAGE))
    {
        setvar(VAR_RETRIEVED_HELD_ITEM, 1)
    }
}

script EscapeRoom_HiddenDungeon_CheckIfToxicOrbObtained{
    if(!flag(FLAG_TOXIC_ORB_OBTAINED)){
        checkpartyitem(0)
        if(var(VAR_RESULT) == TRUE && var(VAR_0x8005) == ITEM_TOXIC_ORB){
            setflag(FLAG_TOXIC_ORB_OBTAINED)
        }
        checkpartyitem(1)
        if(var(VAR_RESULT) == TRUE && var(VAR_0x8005) == ITEM_TOXIC_ORB){
            setflag(FLAG_TOXIC_ORB_OBTAINED)
        }
        checkitem(ITEM_TOXIC_ORB)
        if(var(VAR_RESULT) == TRUE){
            setflag(FLAG_TOXIC_ORB_OBTAINED)
        }

        // if toxic orb succesfully obtained
        if(flag(FLAG_TOXIC_ORB_OBTAINED)){

            // used for hints
            setflag(FLAG_TOXIC_ORB_STOLEN_AT_SOME_POINT)

            // ERROR CHECK
            // - 0 money
            // - Annihilape learned Thief
            // - Annihilape still in party
            // - Trainer7b not defeated
            // - Trainer9 defeated
            // - Trainer10 not defeated
            checkexactmoney(0)
            copyvar(VAR_TEMP_4, VAR_RESULT) 
            checkpartymon(SPECIES_ANNIHILAPE)
            copyvar(VAR_TEMP_5, VAR_RESULT)
            istaughtmovepresent(SPECIES_ANNIHILAPE, MOVE_THIEF)
            if(var(VAR_RESULT) == FALSE ||
                var(VAR_TEMP_4) == FALSE ||
                var(VAR_TEMP_5) == PARTY_SIZE ||
                flag(FLAG_TRAINER7B_DEFEATED) ||
                !flag(FLAG_TRAINER9_DEFEATED) ||
                flag(FLAG_TRAINER10_DEFEATED)) 
            {
                setvar(VAR_DO_SOMETHING_WRONG_MESSAGE, 1)
            }
        }
    }
}

script EscapeRoom_MapScripts_SomethingWrongMessage{
    lockall
    setvar(VAR_DO_SOMETHING_WRONG_MESSAGE, 0)
    msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}

// easter egg ss ticket steal
script EscapeRoom_HiddenDungeon_CheckIfSSTicketObtained{
    if(!flag(FLAG_SS_TICKET_OBTAINED)){
        checkitem(ITEM_SS_TICKET)
        if(var(VAR_RESULT) == TRUE){
            setflag(FLAG_SS_TICKET_OBTAINED)
        }
    }
}


////////////////////////////////////////// EVENT SCRIPTS //////////////////////////////////////////


// Bagon trade
script EscapeRoom_HiddenDungeon_TradeAipomLiepardForBagon{
    lock
    faceplayer

    // post trade 
    if(flag(FLAG_AIPOM_LIEPARD_TRADE_ACCEPTED) == TRUE){
        msgbox(BagonTradePostTrade, MSGBOX_NPC)
        waitmessage

        // remove NPC
        fadescreen(FADE_TO_BLACK)
        playse(SE_EXIT)
        delay(15)
        removeobject(LOCALID_BAGON_TRADER)
        setflag(FLAG_HIDE_BAGON_TRADER)
        fadescreen(FADE_FROM_BLACK)
        waitse
    }
    else{
        // ask trade
        msgbox(AskBagonTrade, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){

            // check if pokemon in party
            checkpartymon(SPECIES_AIPOM)
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot for bye-bye message
            if(var(VAR_RESULT) == PARTY_SIZE)
            {
                msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
                waitmessage
                releaseall
                end
            }
            checkpartymon(SPECIES_LIEPARD)
            copyvar(VAR_0x8005, VAR_RESULT) // store monslot for bye-bye message - in 0x8005
            if(var(VAR_RESULT) == PARTY_SIZE)
            {
                msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
                waitmessage
                releaseall
                end
            }

            // obtain Bagon message
            message(BagonReceivedMessage)
            playfanfare(MUS_OBTAIN_ITEM)
            lockall
            waitfanfare

            // bye bye message Aipom
            special(BufferMonNickname)
            msgbox(ByeByeMonDynamic, MSGBOX_DEFAULT)
            waitmessage
            lockall

            // bye bye message Liepard
            copyvar(VAR_0x8004, VAR_0x8005)
            special(BufferMonNickname)
            msgbox(ByeByeMonDynamic, MSGBOX_DEFAULT)
            waitmessage

            // actually trade pokemon
            removemon(SPECIES_AIPOM)
            removemon(SPECIES_LIEPARD)
            lockall
            givemon(
                SPECIES_BAGON,
                34,
                item=ITEM_RAINBOW_PASS, // entry card
                abilityNum=2, // sheer force 
                nature=NATURE_MODEST,
                gender=MON_MALE,
                move1=MOVE_HIDDEN_POWER, // psychic
                move2=MOVE_SUBSTITUTE,
                move3=MOVE_NONE,
                move4=MOVE_NONE,
                // EVs:
                spAtkEv=252,
                speedEv=252,
                // IVs (Hidden Power Psychic: 31/30/31/31/31/30)
                hpIv=1, // shelgon ohko'd by Jigglypuff
                atkIv=0,
                defIv=1,
                spAtkIv=31,
                spDefIv=31,
                speedIv=30
            )
            setflag(FLAG_AIPOM_LIEPARD_TRADE_ACCEPTED)
        }
        // trade declined
        else{
            msgbox(BagonTradeDeclined, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    releaseall
}


// Dungeon guard
script EscapeRoom_HiddenDungeon_DungeonGuard{
    lockall
    faceplayer

    if(flag(FLAG_DUNGEON_ENTRY_GRANTED)){
        // post script message
        msgbox(DungeonGuardPostEntry, MSGBOX_DEFAULT)
        waitmessage
    }
    else{
        // intro message
        msgbox(DungeonGuardIntro, MSGBOX_DEFAULT)
        waitmessage

        // check card
        checkitem(ITEM_RAINBOW_PASS)
        if(var(VAR_RESULT) == TRUE){

            // shows card message
            msgbox(DungeonGuardShowsCard, MSGBOX_DEFAULT)
            waitmessage

            // entry given message
            msgbox(DungeonGuardGivesEntry, MSGBOX_AUTOCLOSE)
            waitmessage

            // move NPC away
            applymovement(LOCALID_DUNGEON_GUARD, GuardMoveAway)
            waitmovement(LOCALID_DUNGEON_GUARD)
            copyobjectxytoperm(LOCALID_DUNGEON_GUARD)
            
            setflag(FLAG_DUNGEON_ENTRY_GRANTED)
        }
    }
    releaseall
}

movement GuardMoveAway {
    face_left
    walk_left
    face_right
}


// trigger NPC script
script EscapeRoom_HiddenDungeon_FinaleReachedTrigger{
    lockall

    if(!flag(FLAG_YAMASK_OBTAINED)){

        // exclamation mark and face to player
        applymovement(LOCALID_YAMASK_NPC, _face_right)
        waitmovement(LOCALID_YAMASK_NPC)
        playse(SE_PIN)
        applymovement(LOCALID_YAMASK_NPC, Common_Movement_ExclamationMark)
        waitmovement(LOCALID_YAMASK_NPC)
        delay(30)

        // face player left
        applymovement(OBJ_EVENT_ID_PLAYER, _face_left)
        waitmovement(OBJ_EVENT_ID_PLAYER)

        // set respawn
        setrespawn(HEAL_LOCATION_ESCAPE_ROOM_FINAL_BATTLE)
        setvar(VAR_RESPAWN_AT_SECTION_X, 3)
        setvar(VAR_LOCATED_AT_SECTION_X, 3)

        // dialogue
        msgbox(YamaskGuyMainMessage, MSGBOX_DEFAULT)
        waitmessage

        // trade Bagon for Yamask
        call(EscapeRoom_HiddenDungeon_BagonYamaskTrade)

        // Post dialogue ("you have everything you need!")
        msgbox(YamaskGuyPostTradeMessage, MSGBOX_AUTOCLOSE)
        waitmessage

        // move player up
        applymovement(OBJ_EVENT_ID_PLAYER, PlayerMoveUp)
        waitmovement(OBJ_EVENT_ID_PLAYER)

        // remove TM Secret Power
        call(EscapeRoom_HiddenDungeon_RemoveTMSecretPower)
    }
    else{
        // face to player
        applymovement(LOCALID_YAMASK_NPC, _face_right)
        waitmovement(LOCALID_YAMASK_NPC)

        // face player left
        applymovement(OBJ_EVENT_ID_PLAYER, _face_left)
        waitmovement(OBJ_EVENT_ID_PLAYER)

        // Post dialogue ("you have everything you need!")
        msgbox(YamaskGuyPostTradeMessage, MSGBOX_AUTOCLOSE)
        waitmessage

        // move player up
        applymovement(OBJ_EVENT_ID_PLAYER, PlayerMoveUp)
        waitmovement(OBJ_EVENT_ID_PLAYER)
    }
    releaseall
}

movement PlayerMoveUp{
    face_up
    walk_up
}

script EscapeRoom_HiddenDungeon_BagonYamaskTrade{
    // check if Bagon in party (sanity check)
    checkpartymon(SPECIES_BAGON)
    copyvar(VAR_0x8004, VAR_RESULT) // store monslot for bye-bye message
    if(var(VAR_RESULT) == PARTY_SIZE)
    {
        msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        // releaseall
        // end
    }

    // obtain Yamask message
    message(YamaskReceivedMessage)
    playfanfare(MUS_OBTAIN_ITEM)
    lockall
    waitfanfare

    // bye bye message Bagon
    special(BufferMonNickname)
    msgbox(ByeByeMonDynamic, MSGBOX_DEFAULT)
    waitmessage
    lockall

    // actually trade Pokemon
    removemon(SPECIES_BAGON)
    removemon(SPECIES_SHELGON) // also remove any Shelgon juussssttt in case
    givemon(
        SPECIES_YAMASK_GALAR,
        5,
        abilityNum=0, // wandering spirit
        nature=NATURE_HASTY,
        gender=MON_MALE, 
        move1=MOVE_ASTONISH,
        move2=MOVE_HAZE,
        move3=MOVE_NONE,
        move4=MOVE_NONE,
        // EVs:
        hpEv=0, 
        // IVs:
        hpIv=0,
        atkIv=31,
        defIv=0,
        speedIv=31,
        spAtkIv=31,
        spDefIv=31
    )

    // set flag
    setflag(FLAG_YAMASK_OBTAINED)
}

script EscapeRoom_HiddenDungeon_RemoveTMSecretPower{
    // remove TM Secret Power
    checkpartyitem(0)
    if(var(VAR_RESULT) == TRUE && var(VAR_0x8005) == ITEM_TM43){
        removepartyitem(0)
    }
    checkpartyitem(1)
    if(var(VAR_RESULT) == TRUE && var(VAR_0x8005) == ITEM_TM43){
        removepartyitem(1)
    }
    checkitem(ITEM_TM43)
    if(var(VAR_RESULT) == TRUE){
        removeitem(ITEM_TM43)
    }
}


script EscapeRoom_HiddenDungeon_YamaskGuy{
    lock

    // different message post trainer 11
    if(!flag(FLAG_TRAINER11_DEFEATED)){
        msgbox(YamaskGuyPostTradeMessage, MSGBOX_NPC)
        waitmessage
    }
    else{
        msgbox(YamaskGuyFinalMessage, MSGBOX_NPC)
        waitmessage
    }

    releaseall
}


// move relearner
script EscapeRoom_HiddenDungeon_MoveRelearner{
    lockall
    faceplayer

    // main message
    msgbox(MoveRelearnerMainMessage, MSGBOX_DEFAULT)
    waitmessage

    // choose pokemon
    special(ChooseMonForMoveRelearner)
    waitstate

    // // choose move
    // if(var(VAR_0x8004) != PARTY_NOTHING_CHOSEN){
    //     special(TeachMoveRelearnerMove)
    //     waitstate
    // }

    // end message
    msgbox(MoveRelearnerEndMessage, MSGBOX_DEFAULT)
    waitmessage


    releaseall
}


// moveset sign
script EscapeRoom_HiddenDungeon_MovesetSign{
    lockall
    msgbox(Trainer11_MovesetSign, MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}


////////////////////////////////////////// TEXT //////////////////////////////////////////


// TRADE NPC 5 - Aipom Liepard Bagon
text AskBagonTrade{
    "Trying to get past the guard?\p"

    "I might be able to help you out.\n"
    "How badly do you want in?\p"

    "Give me your Pokémon and I'll get you\n"
    "in that restricted area.\p"

    "You can have my Bagon so you won't be\n"
    "stuck without a partner.\p"

    "Do we have a deal?"
}

text BagonReceivedMessage{
    "{PLAYER} received a Bagon!"
}

text BagonTradeDeclined{
    "Suit yourself."
}

text BagonTradePostTrade{
    "Hehehehe!"
}


// DUNGEON GUARD

text DungeonGuardIntro{
    "Access to this zone is restricted.\p"
    "I'll need to see an entry card, or you\n"
    "are not getting through."
}

text DungeonGuardShowsCard{
    "(You hesitantly hold up your rainbow-\n"
    "colored entry card.)"
}

text DungeonGuardGivesEntry{
    "Hmmm...\p"
    "This doesn't look like one of our usual\n"
    "entry cards.\p" 
    "...\p"
    "Honestly, I've seen stranger cards make\n"
    "it through.\p"
    "You're clear to enter."
}

text DungeonGuardPostEntry{
    // "You're not very normal, are you?\n"
    // "Just don't cause any trouble"
    "Hm... Cute entry card though."
}


// Yamask trade NPC
