


////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_HiddenDungeon_MapScripts {
    MAP_SCRIPT_ON_RESUME: EscapeRoom_HiddenDungeon_MapScript_OnResumeScripts

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1: EscapeRoom_MapScripts_FindBallAferUse
        VAR_RETRIEVED_HELD_ITEM, 1: EscapeRoom_MapScripts_RetrievedItemMessage
        VAR_ASK_RESET_PREDAMAGE, 1: EscapeRoom_MapScripts_AskResetPredamage
    ] 
}



script EscapeRoom_HiddenDungeon_MapScript_OnResumeScripts{
    call(EscapeRoom_HiddenDungeon_DisableBagUse)
    call(EscapeRoom_HiddenDungeon_SetLostItemVars)
    call(EscapeRoom_MapScripts_CheckIfAskPreDamage)
    call(EscapeRoom_HiddenDungeon_CheckIfSecretPowerObtained)
} 

script EscapeRoom_HiddenDungeon_DisableBagUse{
    // disable bag use 
    if(flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
}

script EscapeRoom_HiddenDungeon_SetLostItemVars{
    // check if held item was retrieved -- sets frame table var if true
    if(flag(FLAG_DO_RECOVERED_ITEM_MESSAGE))
    {
        setvar(VAR_RETRIEVED_HELD_ITEM, 1)
    }
}

script EscapeRoom_HiddenDungeon_CheckIfSecretPowerObtained{
    if(flag(FLAG_SECRET_POWER_LEARNED) && !flag(FLAG_SECRET_POWER_COMPLETED)){
        setflag(FLAG_SECRET_POWER_COMPLETED)
        clearflag(FLAG_SECRET_POWER_LEARNED) // for secret garden guard messaging
    }
}



////////////////////////////////////////// EVENT SCRIPTS //////////////////////////////////////////





