text PrimeapeGrave_main{
//  "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"    -- max length
    "It's an old grave.\p"
    "Do you want to dig up the grave in\n"
    "in search for treasure?"
}

text PrimeapeGrave_youSure1{
    "Are you sure about this?"
}

text PrimeapeGrave_youSure2{
    "Do you really want to rob a grave?"
}

text PrimeapeGrave_youSure3{
    "Are you REALLY sure?"
}

text PrimeapeGrave_DigTheGrave{
    "You carefully dig through the soil...\p"
    "...\p"
    "...\p"
    "...\p"
    "...\p"
    "..."
}

text PrimeapeGrave_DigTheGrave2{
    "You carefully dig through the soil...\p"
    "..."
}

text PrimeapeGrave_FindNothingMessage{
    "You find nothing but dirt."
}

text PrimeapeGrave_PostDigNothingMessage{
    "It's an old grave."
}

text PrimeapeGrave_PostDigMessage{
    "Let's never doing this again..."
}

text PrimeapeGrave_PostScriptMessage{
    "Some things are better left buried."
}

