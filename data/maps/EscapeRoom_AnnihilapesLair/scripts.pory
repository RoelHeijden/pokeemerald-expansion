
const LOCALID_PRIMEAPE_BALL = 14


////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_AnnihilapesLair_MapScripts {
    MAP_SCRIPT_ON_LOAD: SpawnDungeonEntranceOnLoad
    MAP_SCRIPT_ON_RESUME: EscapeRoom_AnnihilapesLair_MapScript_OnResumeScripts

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1: EscapeRoom_MapScripts_FindBallAferUse
        VAR_RETRIEVED_HELD_ITEM, 1: EscapeRoom_MapScripts_RetrievedItemMessage
    ] 
}

// manually set wall locations
script SpawnDungeonEntranceOnLoad{
    if(flag(FLAG_MAP_SWITCHES_SOLVED) == TRUE){
        setmetatile(6, 0, METATILE_MeteorFalls_CaveEntrance_Top, TRUE)
        setmetatile(5, 1, METATILE_MeteorFalls_CaveEntrance_Left, TRUE)
        setmetatile(6, 1, METATILE_MeteorFalls_CaveEntrance_Bottom, FALSE)
        setmetatile(7, 1, METATILE_MeteorFalls_CaveEntrance_Right, TRUE) 
    }
}


script EscapeRoom_AnnihilapesLair_MapScript_OnResumeScripts{
    call(EscapeRoom_AnnihilapesLair_ReturnBall)
    call(EscapeRoom_AnnihilapesLair_DisableBagUse)
    call(EscapeRoom_AnnihilapesLair_SetLostItemVars)
} 

script EscapeRoom_AnnihilapesLair_ReturnBall{
    // check for ball return -- sets frame table var if true
    if(flag(FLAG_BALL_USED) && !flag(FLAG_ZERAORA_CAUGHT)){
        setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1)
    }
}

script EscapeRoom_AnnihilapesLair_DisableBagUse{
    // disable bag use 
    if(flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
}

script EscapeRoom_AnnihilapesLair_SetLostItemVars{
    // check if held item was retrieved -- sets frame table var if true
    if(flag(FLAG_DO_RECOVERED_ITEM_MESSAGE))
    {
        setvar(VAR_RETRIEVED_HELD_ITEM, 1)
    }
}


////////////////////////////////////////// EVENT SCRIPTS //////////////////////////////////////////


script EscapeRoom_AnnihilapesLair_FindPrimeape{
    lockall

    // obtain primeape
    givemon(
        SPECIES_PRIMEAPE,
        44,
        ball=ITEM_TIMER_BALL,
        item=ITEM_MAX_REVIVE,
        abilityNum=2, // Defiant
        nature=NATURE_CALM,
        gender=MON_FEMALE,
        move1=MOVE_RAGE_FIST,
        move2=MOVE_TAUNT,
        move3=MOVE_NONE,
        move4=MOVE_NONE,
        // EVs:
        hpEv=252,
        defEv=0,
        spDefEv=8
        // IVs:
        hpIv=31,
        atkIv=0,
        defIv=0,  // final battle Heatran Struggle damage >63%
        spAtkIv=31,
        spDefIv=31,
        speedIv=10
    )  

    // remove item
    removeobject(LOCALID_PRIMEAPE_BALL)
    setflag(FLAG_PRIMEAPE_OBTAINED)

    // set rare candy flag
    setflag(FLAG_MAX_REVIVE_OBTAINED)

    // primeape obtained message
    playfanfare(MUS_OBTAIN_ITEM)
    message(PrimeapeObtainMessage)
    waitfanfare
    waitmessage

    // nickname
    msgbox(NicknameThisPokemonMessage2, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
    closemessage
    releaseall
}

script EscapeRoom_AnnihilapesLair_PrimeapeGrave1{
    lockall
    msgbox(PrimeapeGraveNothing, MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}

script EscapeRoom_AnnihilapesLair_PrimeapeGrave2{
    lockall
    msgbox(PrimeapeGraveNothing, MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}

text PrimeapeGraveNothing{
    "..."
}
