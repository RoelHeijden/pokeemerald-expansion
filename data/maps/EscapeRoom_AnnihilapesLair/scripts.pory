

////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_AnnihilapesLair_MapScripts {
    MAP_SCRIPT_ON_RESUME: EscapeRoom_AnnihilapesLair_MapScript_OnResumeScripts

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1: EscapeRoom_MapScripts_FindBallAferUse
        VAR_RETRIEVED_HELD_ITEM, 1: EscapeRoom_MapScripts_RetrievedItemMessage
    ] 
}


script EscapeRoom_AnnihilapesLair_MapScript_OnResumeScripts{
    call(EscapeRoom_AnnihilapesLair_ReturnBall)
    call(EscapeRoom_AnnihilapesLair_DisableBagUse)
    call(EscapeRoom_AnnihilapesLair_SetLostItemVars)
} 

script EscapeRoom_AnnihilapesLair_ReturnBall{
    // check for ball return -- sets frame table var if true
    if(flag(FLAG_BALL_USED) && !flag(FLAG_ZERAORA_CAUGHT)){
        setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1)
    }
}

script EscapeRoom_AnnihilapesLair_DisableBagUse{
    // disable bag use 
    if(flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
}

script EscapeRoom_AnnihilapesLair_SetLostItemVars{
    // check if held item was retrieved -- sets frame table var if true
    if(flag(FLAG_DO_RECOVERED_ITEM_MESSAGE))
    {
        setvar(VAR_RETRIEVED_HELD_ITEM, 1)
    }
}



