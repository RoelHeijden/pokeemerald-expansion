


////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_AnnihilapesLair_MapScripts {
    MAP_SCRIPT_ON_LOAD: SpawnDungeonEntranceOnLoad
    MAP_SCRIPT_ON_RESUME: EscapeRoom_AnnihilapesLair_MapScript_OnResumeScripts

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1: EscapeRoom_MapScripts_FindBallAferUse
        VAR_RETRIEVED_HELD_ITEM, 1: EscapeRoom_MapScripts_RetrievedItemMessage
    ] 
}

// manually set wall locations
script SpawnDungeonEntranceOnLoad{
    if(flag(FLAG_MAP_SWITCHES_SOLVED) == TRUE){
        setmetatile(6, 0, METATILE_MeteorFalls_CaveEntrance_Top, TRUE)
        setmetatile(5, 1, METATILE_MeteorFalls_CaveEntrance_Left, TRUE)
        setmetatile(6, 1, METATILE_MeteorFalls_CaveEntrance_Bottom, FALSE)
        setmetatile(7, 1, METATILE_MeteorFalls_CaveEntrance_Right, TRUE) 
    }
}


script EscapeRoom_AnnihilapesLair_MapScript_OnResumeScripts{
    call(EscapeRoom_AnnihilapesLair_ReturnBall)
    call(EscapeRoom_AnnihilapesLair_DisableBagUse)
    call(EscapeRoom_AnnihilapesLair_SetLostItemVars)
} 

script EscapeRoom_AnnihilapesLair_ReturnBall{
    // check for ball return -- sets frame table var if true
    if(flag(FLAG_BALL_USED) && !flag(FLAG_ZERAORA_CAUGHT)){
        setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1)
    }
}

script EscapeRoom_AnnihilapesLair_DisableBagUse{
    // disable bag use 
    if(flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
}

script EscapeRoom_AnnihilapesLair_SetLostItemVars{
    // check if held item was retrieved -- sets frame table var if true
    if(flag(FLAG_DO_RECOVERED_ITEM_MESSAGE))
    {
        setvar(VAR_RETRIEVED_HELD_ITEM, 1)
    }
}


////////////////////////////////////////// EVENT SCRIPTS //////////////////////////////////////////


script EscapeRoom_AnnihilapesLair_FindPrimeape{
    // obtain primeape
    givemon(
        SPECIES_PRIMEAPE,
        44,
        ball=ITEM_TIMER_BALL,
        item=ITEM_MAX_REVIVE,
        abilityNum=2, // Defiant
        nature=NATURE_CALM,
        gender=MON_FEMALE,
        move1=MOVE_RAGE_FIST,
        move2=MOVE_TAUNT,
        move3=MOVE_NONE,
        move4=MOVE_NONE,
        // EVs:
        hpEv=252,
        defEv=0,
        spDefEv=8
        // IVs:
        hpIv=31,
        atkIv=0,
        defIv=0,  // final battle Heatran Struggle damage >63%
        spAtkIv=31,
        spDefIv=31,
        speedIv=10
    )  

    // set annihilape as fainted
    healpartymon(SPECIES_PRIMEAPE, reverse=TRUE)

    // remove item
    setflag(FLAG_PRIMEAPE_OBTAINED)

    // set rare candy flag
    setflag(FLAG_MAX_REVIVE_OBTAINED)

    // primeape obtained message
    setflag(FLAG_FANFARE_NO_MUSIC_RESUME)
    playfanfare(MUS_OBTAIN_ITEM)
    message(PrimeapeObtainMessage)
    waitfanfare
    waitmessage

    // nickname
    msgbox(NicknameThisPokemonMessage2, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
    closemessage
}

script EscapeRoom_AnnihilapesLair_PrimeapeGrave1{
    lockall

    // some things meant to be burried
    if(flag(FLAG_GRAVE1_ROBBED)){
        msgbox(PrimeapeGrave_PostScriptMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        return
    }

    // dig up grave?
    msgbox(PrimeapeGrave_main, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){

        msgbox(PrimeapeGrave_youSure1, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){

            msgbox(PrimeapeGrave_youSure2, MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES){

                msgbox(PrimeapeGrave_youSure3, MSGBOX_YESNO)
                if(var(VAR_RESULT) == YES){
                    
                    call(EscapeRoom_AnnihilapesLair_PrimeapeGrave_DigGrave)
                    setflag(FLAG_GRAVE1_ROBBED)
                }
            }
        }
    }
    releaseall
}

script EscapeRoom_AnnihilapesLair_PrimeapeGrave2{
    lockall

    // some things meant to be burried
    if(flag(FLAG_GRAVE1_ROBBED)){
        msgbox(PrimeapeGrave_PostScriptMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        return
    }

    // just an old grave
    if(flag(FLAG_GRAVE2_ROBBED)){
        msgbox(PrimeapeGrave_PostDigNothingMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        return
    }

    // dig up grave?
    msgbox(PrimeapeGrave_main, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){

        msgbox(PrimeapeGrave_youSure1, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){

            msgbox(PrimeapeGrave_youSure2, MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES){

                msgbox(PrimeapeGrave_youSure3, MSGBOX_YESNO)
                if(var(VAR_RESULT) == YES){

                    // dig grave
                    msgbox(PrimeapeGrave_DigTheGrave2, MSGBOX_DEFAULT)
                    waitmessage
                    
                    // you find nothing
                    msgbox(PrimeapeGrave_FindNothingMessage, MSGBOX_AUTOCLOSE)
                    waitmessage
                    setflag(FLAG_GRAVE2_ROBBED)
                }
            }
        }
    }
    releaseall
}


script EscapeRoom_AnnihilapesLair_PrimeapeGrave_DigGrave{
    fadeoutbgm(0)
    delay(20)

    // dig grave
    msgbox(PrimeapeGrave_DigTheGrave, MSGBOX_AUTOCLOSE)
    waitmessage

    // exclamation mark
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    delay(50)

    // ground shakes and roar
    call(EscapeRoom_AnnihilapesLair_PrimeapeGrave_ApeRoar)
    delay(20)

    // obtain primeape
    call(EscapeRoom_AnnihilapesLair_FindPrimeape)

    // final message
    delay(10)
    msgbox(PrimeapeGrave_PostDigMessage, MSGBOX_AUTOCLOSE)
    waitmessage

    fadeinbgm(0)
}

script EscapeRoom_AnnihilapesLair_PrimeapeGrave_ApeRoar{
    playmoncry(SPECIES_GROUDON, CRY_MODE_NORMAL)
	special(DoSealedChamberShakingEffect_Short)
    delay(10)
    special(DoSealedChamberShakingEffect_Short)
    delay(10)
    special(DoSealedChamberShakingEffect_Short)
    delay(10)
    special(DoSealedChamberShakingEffect_Short)

    // msgbox(GravestoneAnnihilapesRoar, MSGBOX_AUTOCLOSE)
    waitmoncry
	// waitmessage
}


