// MOVE DELETER NPC

script EscapeRoom_MoveDeleterNPC{
    lockall
    faceplayer

    // stop deleting moves once Bagon is obtained
    if(flag(FLAG_AIPOM_LIEPARD_TRADE_ACCEPTED)){
        msgbox(MoveDeleterOutOfBusiness, MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
        end
    }

    msgbox(AskDeleteMove, MSGBOX_MOVE_DELETER)

    // standard move deleter script
    if(var(VAR_RESULT) == 0){
        setflag(FLAG_IN_MOVE_DELETER_SCRIPT)
        call(EscapeRoom_ChooseMoveToDelete)
        clearflag(FLAG_IN_MOVE_DELETER_SCRIPT)
    }
    // restore moves
    elif(var(VAR_RESULT) == 1){
        call(EscapeRoom_RestoreMoveset)
        releaseall
        end
    }

    // goodbye message
    msgbox(MoveDeleterComeAgain, MSGBOX_AUTOCLOSE)
    releaseall
}

script EscapeRoom_ChooseMoveToDelete{
    // reset mon and move slot vars
    setvar(VAR_MOVE_DELETE_MONSLOT_BACKUP, 6)  // PARTY_SIZE
    setvar(VAR_MOVE_DELETER_CHOSEN_SLOT, 4)    // MAX_MON_MOVES

    // choose mon
	special(ChoosePartyMon)
	waitstate
}

script EscapeRoom_RestoreMoveset{
    // flag to detect if no moves were restored at all
    setflag(FLAG_TEMP_5)

    // Liepard
    restoremonmoveset(SPECIES_LIEPARD)
    if(var(VAR_RESULT) == TRUE){
        call(EscapeRoom_MoveRestoredSound)
        clearflag(FLAG_TEMP_5)
        clearflag(FLAG_LIEPARD_MOVE_DELETED)

        // moves restored message
        checkpartymon(SPECIES_LIEPARD)
        copyvar(VAR_0x8004, VAR_RESULT) // store monslot for move restore message
        special(BufferMonNickname)
        msgbox(MovesRestoredMessage, MSGBOX_DEFAULT)
        waitmessage
    }

    // Aipom
    restoremonmoveset(SPECIES_AIPOM)
    if(var(VAR_RESULT) == TRUE){
        call(EscapeRoom_MoveRestoredSound)
        clearflag(FLAG_TEMP_5)
        clearflag(FLAG_AIPOM_MOVE_DELETED)

        // moves restored message
        checkpartymon(SPECIES_AIPOM)
        copyvar(VAR_0x8004, VAR_RESULT) // store monslot for move restore message
        special(BufferMonNickname)
        msgbox(MovesRestoredMessage, MSGBOX_DEFAULT)
        waitmessage
    }

    // Dunsparce
    restoremonmoveset(SPECIES_DUNSPARCE)
    if(var(VAR_RESULT) == TRUE){
        call(EscapeRoom_MoveRestoredSound)
        clearflag(FLAG_TEMP_5)
        clearflag(FLAG_DUNSPARCE_MOVE_DELETED)

        // moves restored message
        checkpartymon(SPECIES_DUNSPARCE)
        copyvar(VAR_0x8004, VAR_RESULT) // store monslot for move restore message
        special(BufferMonNickname)
        msgbox(MovesRestoredMessage, MSGBOX_DEFAULT)
        waitmessage
    }

    // no moves restored
    if (flag(FLAG_TEMP_5) == TRUE)
    {
        msgbox(NoMovesRestoredMessage, MSGBOX_AUTOCLOSE)
        clearflag(FLAG_TEMP_5)
    }
}

script EscapeRoom_MoveRestoredSound{
    delay(5)
    playse(SE_NOTE_E)
    delay(5)
    playse(SE_NOTE_G)
    delay(5)
    playse(SE_NOTE_C_HIGH)
    waitse
}


