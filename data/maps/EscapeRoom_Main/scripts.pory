script EscapeRoom_EventScript_AnnihilapeBattle{
    createmon(
        side=1,
        slot=0,
        species=SPECIES_ANNIHILAPE,
        level=100,
        nature=22,
        abilityNum=2,
        gender=1,
        hpEv=184,
        defEv=72,
        spAtkEv=252,
        move1=MOVE_MIMIC
    )
    dowildbattle
}


