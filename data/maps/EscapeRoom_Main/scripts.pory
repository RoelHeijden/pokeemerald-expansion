const LOCALID_TRAINER4 = 14
const LOCALID_NURSE2 = 15
const LOCALID_HINT_GUY2 = 16
const LOCALID_ANTI_SOFTLOCK_GUY2 = 17
const LOCALID_LIEPARD = 18
const LOCALID_SMEARGLE_NPC = 19
const LOCALID_TRAINER5 = 20
const LOCALID_CUT_TREE = 21
const LOCALID_LIEPARD_COLLAR = 22
const LOCALID_TRAINER1 = 23
const LOCALID_DUNSPARCE_BUYER = 24
const LOCALID_ROCK_SMASH_NPC = 25
const LOCALID_SHOP1 = 26
const LOCALID_SHOP2 = 27
const LOCALID_MAP_SWITCH2 = 28
