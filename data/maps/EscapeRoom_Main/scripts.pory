script EscapeRoom_EventScript_SpawnAnnihilape{
    fadeoutbgm(0)
    clearflag(FLAG_HIDE_ANNIHILAPE)

    playmoncry(SPECIES_GROUDON, CRY_MODE_NORMAL)
	special(DoSealedChamberShakingEffect_Short)
    delay(10)
    special(DoSealedChamberShakingEffect_Short)
    delay(10)
    special(DoSealedChamberShakingEffect_Short)
    delay(10)
    special(DoSealedChamberShakingEffect_Short)

    msgbox(GravestoneAnnihilapesRoar, MSGBOX_AUTOCLOSE)
    waitmoncry
	waitmessage
    fadeinbgm(0)

    setflag(FLAG_ANNIHILAPE_SPAWNED)
}

script EscapeRoom_EventScript_SafetyGogglesStatue{
    lockall

    // goggles still there
    if(flag(FLAG_GOGGLES_SNATCHED) == FALSE){
        // check if Snatch Zera in party
        checkpartymove(MOVE_SNATCH)
        if(var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_ZERAORA){

            // set nickname to var
            checkpartymon(SPECIES_ZERAORA)
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot for bye-bye message
            special(BufferMonNickname)

            // ask snatch goggles
            msgbox(Goggles_Statue_AskSnatch, MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES){

                // only allow Goggles Snatch if Zera is lvl 43
                checkpartymonlevel(43)
                if(var(VAR_RESULT) != PARTY_SIZE){
                    setflag(FLAG_GOGGLES_SNATCHED)
                    call(EscapeRoom_EventScript_SnatchSafetyGoggles)
                }
                else{
                    closemessage
                    delay(40)
                    msgbox(Goggles_Statue_ZeraNotReady, MSGBOX_DEFAULT)
                    waitmessage
                }
            }
        }
        // regular message
        else{
            msgbox(Goggles_Statue_Main, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    // goggles already taken
    else{
        msgbox(GogglesAlreadySnatchedMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }

    releaseall
}

script EscapeRoom_EventScript_SnatchSafetyGoggles{
    // takes goggles
    closemessage
    fadeoutbgm(0)
    delay(10)
    msgbox(GogglesSnatchStart, MSGBOX_AUTOCLOSE)
    waitmessage
    delay(40)
    finditem(ITEM_SAFETY_GOGGLES)
    
    // curse happens
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    delay(50)
    playse(SE_M_NIGHTMARE)  // alternatives: SE_M_SWEET_SCENT, SE_M_NIGHTMARE, SE_M_HAZE
    special(DoSealedChamberShakingEffect_Short)
    delay(10)
    special(DoSealedChamberShakingEffect_Short)
    waitse
    msgbox(GogglesCurseHappens, MSGBOX_AUTOCLOSE)    
    waitmessage
    fadeinbgm(0)

    // remove Snatch with   
    checkpartymon(SPECIES_ZERAORA)
    copyvar(VAR_0x8001, VAR_RESULT)
    setvar(VAR_0x8002, MOVE_SNATCH)
    setvar(VAR_0x8003, MOVE_NONE)
    replacemove(VAR_0x8001, VAR_0x8002, VAR_0x8003) 
}

script EscapeRoom_EventScript_AnnihilapeStatue{
    lockall
    msgbox(AnnihilapeStatueMessage, MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}


//// GAME END //// 

script EscapeRoom_EventScript_EndGame{
    lockall
	setrespawn(HEAL_LOCATION_ESCAPE_ROOM_NURSE1)

    // enter boat
    delay(20)
    if(var(VAR_FACING) == DIR_SOUTH){
        applymovement(OBJ_EVENT_ID_PLAYER, EnterBoat2)
        waitmovement(OBJ_EVENT_ID_PLAYER)
    }
    elif(var(VAR_FACING) == DIR_WEST){
        applymovement(OBJ_EVENT_ID_PLAYER, EnterBoat1)
        waitmovement(OBJ_EVENT_ID_PLAYER)
    }
    hideobjectat(OBJ_EVENT_ID_PLAYER, MAP_ESCAPE_ROOM_MAIN)
    delay(15)

    applymovement(LOCALID_CHAMPION, ChampionEnterBoat)
    waitmovement(LOCALID_CHAMPION)
    removeobject(LOCALID_CHAMPION)
    delay(35)

    // start moving boat
    applymovement(LOCALID_BOAT, BoatSailAway)

    // fade music and screen
    fadeoutbgm(0)
    fadescreenspeed(FADE_TO_BLACK, 8)

    // end credits
	special(GameClear)
	waitstate
	releaseall
	end
}

movement EnterBoat1{
    face_down
    walk_down
}
movement EnterBoat2{
    face_right
    walk_right
    face_down
    walk_down * 2
}
movement ChampionEnterBoat{
    face_right
    walk_right
    face_down
    walk_down
}
movement BoatSailAway{
    face_down
    walk_slow_down * 7
}


//// ESCAPE ROPE EASTER EGG ////

script EscapeRoom_EventScript_EscapeRopeEE_message1{
    lockall
    setvar(VAR_ESCAPE_ROPE_EE_STATE, 2)
    playfanfare(MUS_OBTAIN_BADGE)
    msgbox(EscapeRoomEndCongratz)
    waitfanfare
    waitmessage
    releaseall
}

script EscapeRoom_EventScript_EscapeRopeEE_message2andwarp{
    setvar(VAR_ESCAPE_ROPE_EE_STATE, 3)
    msgbox(EscapeRopeEEMessage2, MSGBOX_AUTOCLOSE)
    waitmessage
    warpteleport(MAP_ESCAPE_ROOM_MAIN, 47, 17)
    waitstate
}



