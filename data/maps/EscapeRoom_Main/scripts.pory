script EscapeRoom_EventScript_MapSwitch4{
    lockall

    // end if already solved
    if(flag(FLAG_MAP_SWITCHES_SOLVED) == TRUE){
        msgbox(MApSwitchesAlreadySolved, MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
        end
    }

    // set flag that fourth switch has been found
    if(flag(FLAG_MAP_SWITCH_4_FOUND) == FALSE){
        setflag(FLAG_MAP_SWITCH_4_FOUND)
    }

    // ask to change tablet direction
    if(var(VAR_MAP_SWITCH_4) == 0){
        msgbox(MapSwitchPointedNorthTablet4, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_4) == 1){
        msgbox(MapSwitchPointedEastTablet4, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_4) == 2){
        msgbox(MapSwitchPointedSouthTablet4, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_4) == 3){
        msgbox(MapSwitchPointedWestTablet4, MSGBOX_YESNO)
    }

    // change direction
    if(var(VAR_RESULT) == YES){
        playse(SE_CLICK)
        addvar(VAR_MAP_SWITCH_4, 1)
        msgbox(RotatedSwitchSoundMessage, MSGBOX_AUTOCLOSE)
        waitmessage

        // full circle: back to north
        if(var(VAR_MAP_SWITCH_4) >= 4){
            setvar(VAR_MAP_SWITCH_4, 0)
        }
        
        // check for correct solution
        call(EscapeRoom_EventScript_CheckSwitchesCorrect)
    }
    releaseall
}

script EscapeRoom_EventScript_CheckSwitchesCorrect{
    if(
        var(VAR_MAP_SWITCH_1) == 2 &&  // south -- Bag
        var(VAR_MAP_SWITCH_2) == 0 &&  // north -- Trainer card
        var(VAR_MAP_SWITCH_3) == 3 &&  // west  -- Pokedex
        var(VAR_MAP_SWITCH_4) == 3     // west  -- Pokemon screen
    ){
        call(EscapeRoom_EventScript_SwitchesOpenDoorSequence)
    }
}

script EscapeRoom_EventScript_SwitchesOpenDoorSequence{
    fadeoutbgm(0)
    playse(SE_TRUCK_MOVE)
	special(DoSealedChamberShakingEffect_Long)
    waitstate
    delay(40)
	special(DoSealedChamberShakingEffect_Short)
	waitstate
	playse(SE_DOOR)
    delay(40)
    msgbox(MapSwitchDoorOpened, MSGBOX_DEFAULT)
	closemessage
    fadeinbgm(0)      
    setflag(FLAG_MAP_SWITCHES_SOLVED)
}


//// ANNIHILAPE'S LAIR ////

script EscapeRoom_EventScript_AnnihilapeBattle{
    lockall

    // backup party state
    backupplayerparty

    // allow items (wild battle)
    if(flag(FLAG_TOGGLE_BAG_USE) == TRUE){
        clearflag(FLAG_TOGGLE_BAG_USE)
    }

    // set annihilape battle
    createmon(
        side=1,
        slot=0,
        species=SPECIES_ANNIHILAPE,
        // item=ITEM_SILK_SCARF,
        level=100,
        nature=17, // Quiet
        abilityNum=2,
        gender=2,
        move1=MOVE_MIMIC
        // evs
        hpEv=12,
        defEv=0,
        spAtkEv=252, 
        spDefEv=244,
        // ivs
        hpIv=31,
        atkIv=31,
        defIv=31,
        speedIv=31,
        spAtkIv=31,
        spDefIv=31
    )
    dowildbattle
    releaseall
}

script EscapeRoom_EventScript_GraveStone1{
    lockall
    msgbox(GravestoneNoneMessage, MSGBOX_AUTOCLOSE)
    waitmessage

    // end if final check was reached
    if(flag(FLAG_GRAVESTONE_CHECK4) == TRUE){
        end
    }

    if (flag(FLAG_GRAVESTONE_CHECK1) == FALSE &&
        flag(FLAG_GRAVESTONE_CHECK2) == FALSE &&
        flag(FLAG_GRAVESTONE_CHECK3) == FALSE){
        msgbox(GravestoneClick1Message, MSGBOX_AUTOCLOSE)
        waitmessage    
        // set first flag
        setflag(FLAG_GRAVESTONE_CHECK1)
    }
    else{
        // reset msg
        msgbox(GravestoneResetMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        clearflag(FLAG_GRAVESTONE_CHECK1)
    }

    // clear flags
    clearflag(FLAG_GRAVESTONE_CHECK2)
    clearflag(FLAG_GRAVESTONE_CHECK3)


    releaseall
}

