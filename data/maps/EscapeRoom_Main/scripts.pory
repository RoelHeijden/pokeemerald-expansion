script EscapeRoom_EventScript_MapSwitch4{
    lockall

    // end if already solved
    if(flag(FLAG_MAP_SWITCHES_SOLVED) == TRUE){
        msgbox(MApSwitchesAlreadySolved, MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
        end
    }

    // set flag that fourth switch has been found
    if(flag(FLAG_MAP_SWITCH_4_FOUND) == FALSE){
        setflag(FLAG_MAP_SWITCH_4_FOUND)
    }

    // ask to change tablet direction
    if(var(VAR_MAP_SWITCH_4) == 0){
        msgbox(MapSwitchPointedNorthTablet4, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_4) == 1){
        msgbox(MapSwitchPointedEastTablet4, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_4) == 2){
