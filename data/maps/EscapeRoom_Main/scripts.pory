    faceplayer
    msgbox(MartNPC_AskToShop, MSGBOX_DEFAULT)
    waitmessage
    pokemart(EscapeRoom_Shop_items)
    msgbox(MartNPC_SayGoodbye, MSGBOX_AUTOCLOSE)
