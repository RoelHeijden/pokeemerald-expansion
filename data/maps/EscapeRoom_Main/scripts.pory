        28,
        abilityNum=2, // anticipation
        nature=NATURE_NAUGHTY,
        gender=MON_MALE, 
        move1=MOVE_STEEL_ROLLER,
        move2=MOVE_BLOCK,
        move3=MOVE_INGRAIN,
        move4=MOVE_NONE,
        // EVs:
        hpEv=0, 
        atkEv=252,
        spDefEv=0, 
        defEv=0,
        // IVs:
        hpIv=0,
        atkIv=31,
        defIv=0,
        speedIv=31,
        spAtkIv=31,
        spDefIv=0
    )
    givemon(
        SPECIES_FLORGES,
        22,
        ball=ITEM_HEAVY_BALL,
        item=ITEM_ELECTRIC_SEED,
        abilityNum=2, // symbiosis
        nature=21, // gentle
        gender=MON_FEMALE,
        move1=MOVE_NATURE_POWER,
        move2=MOVE_GRASS_KNOT,
        move3=MOVE_GRASSY_TERRAIN,
        move4=MOVE_CAMOUFLAGE,
        // EVs:
        hpEv=252,
        spDefEv=252,
        // IVs:
        hpIv=31,
        atkIv=0,
        defIv=0,
        speedIv=31,
        spAtkIv=0,
        spDefIv=31
    )

    setflag(FLAG_SYS_POKEMON_GET)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 2)
}

