script EscapeRoom_EventScript_Trainer5{
    // if assist in party and trainer not yet defeated
    // reject battle
    checkpartymove(MOVE_ASSIST)
    if(var(VAR_RESULT) != PARTY_SIZE && flag(FLAG_TRAINER5_DEFEATED) == FALSE){
        lock
        msgbox(Trainer5_RemoveAssistMessage, MSGBOX_NPC)
        releaseall
        end
    }

    // clear item return flags before the battle
    if(!flag(FLAG_TRAINER5_DEFEATED)){
        clearflag(FLAG_BERRY_JUICE_CONSUMED)
        clearflag(FLAG_DUSK_STONE_CONSUMED)
        clearflag(FLAG_JABOCA_CONSUMED)
        clearflag(FLAG_SAFETY_GOGGLES_CONSUMED)
    }

    // battle
    trainerbattle_double(
        TRAINER_CUSTOM_TRAINER5, 
        Trainer5_Intro, 
        Trainer5_Outro, 
        DoubleBattle_NotEnoughMons,
        event_script=EscapeRoom_EventScript_Trainer5PostBattle,
    )
    msgbox(Trainer5_PostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

