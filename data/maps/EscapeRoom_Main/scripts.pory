        msgbox(RotatedSwitchSoundMessage, MSGBOX_AUTOCLOSE)
        waitmessage

        // full circle: back to north
        if(var(VAR_MAP_SWITCH_4) >= 4){
            setvar(VAR_MAP_SWITCH_4, 0)
        }
        
        // check for correct solution
        call(EscapeRoom_EventScript_CheckSwitchesCorrect)
    }
    releaseall
}

script EscapeRoom_EventScript_CheckSwitchesCorrect{
    if(
        var(VAR_MAP_SWITCH_1) == 2 &&  // south -- Pokemon screen contest moves
        var(VAR_MAP_SWITCH_2) == 2 &&  // south -- Bag
        var(VAR_MAP_SWITCH_3) == 3 &&  // west  -- Pokedex pokemon size
        var(VAR_MAP_SWITCH_4) == 3     // west  -- Save menu
    ){
        call(EscapeRoom_EventScript_SwitchesOpenDoorSequence)
        setflag(FLAG_HIDE_ANNIHILAPE) // remove Annihilape
    }
}

script EscapeRoom_EventScript_SwitchesOpenDoorSequence{
    fadeoutbgm(0)
    playse(SE_TRUCK_MOVE)
	special(DoSealedChamberShakingEffect_Long)
    waitstate
    delay(40)
	special(DoSealedChamberShakingEffect_Short)
	waitstate
	playse(SE_DOOR)
    delay(40)
    msgbox(MapSwitchDoorOpened, MSGBOX_DEFAULT)
	closemessage
    fadeinbgm(0)      
    setflag(FLAG_MAP_SWITCHES_SOLVED)
}


//// ANNIHILAPE'S LAIR ////

script EscapeRoom_EventScript_AnnihilapeBattle{
    lockall

    // backup party state
    backupplayerparty

    // allow items (wild battle)
    if(flag(FLAG_TOGGLE_BAG_USE) == TRUE){
        clearflag(FLAG_TOGGLE_BAG_USE)
    }

    // set annihilape battle
    createmon(
        side=1,
        slot=0,
        species=SPECIES_ANNIHILAPE,
        // item=ITEM_SILK_SCARF,
        level=100,
        nature=17, // Quiet
        abilityNum=2,
        gender=2,
        move1=MOVE_MIMIC
        // evs
        hpEv=12,
        defEv=0,
        spAtkEv=252, 
        spDefEv=244,
        // ivs
        hpIv=31,
        atkIv=31,
        defIv=31,
        speedIv=31,
        spAtkIv=31,
        spDefIv=31
    )
    dowildbattle
    releaseall
}

script EscapeRoom_EventScript_GraveStone1{
    lockall
    msgbox(GravestoneNoneMessage, MSGBOX_AUTOCLOSE)
    waitmessage

    // end if final check was reached
    if(flag(FLAG_GRAVESTONE_CHECK4) == TRUE){
        end
    }

    if (flag(FLAG_GRAVESTONE_CHECK1) == FALSE &&
        flag(FLAG_GRAVESTONE_CHECK2) == FALSE &&
        flag(FLAG_GRAVESTONE_CHECK3) == FALSE){
        msgbox(GravestoneClick1Message, MSGBOX_AUTOCLOSE)
        waitmessage    
        // set first flag
        setflag(FLAG_GRAVESTONE_CHECK1)
    }
    else{
        // reset msg
        msgbox(GravestoneResetMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        clearflag(FLAG_GRAVESTONE_CHECK1)
    }

    // clear flags
    clearflag(FLAG_GRAVESTONE_CHECK2)
    clearflag(FLAG_GRAVESTONE_CHECK3)


    releaseall
}

