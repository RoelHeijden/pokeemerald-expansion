script EscapeRoom_EventScript_TradePoochForSmeargle{
    lockall
    faceplayer

    // post trade 
    if(flag(FLAG_POOCH_TRADE_ACCEPTED) == TRUE){
        msgbox(PoochTradePostTrade, MSGBOX_NPC)
        waitmessage
    }
    else{
        // ask trade
        msgbox(AskPoochSmeargleTrade, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){

            // check if pokemon in party
            checkpartymon(SPECIES_POOCHYENA)
            if(var(VAR_RESULT) == PARTY_SIZE)
            {
                msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
                waitmessage
                releaseall
                end
            }

            // first heal if liepard is fainted (would allow double skip)
            partymonhasfainted
            lockall
            if(var(VAR_RESULT) != PARTY_SIZE){
                if(var(VAR_0x8004) == SPECIES_LIEPARD){
                    msgbox(HealBeforeTradeMessage, MSGBOX_DEFAULT)
                    waitmessage
                    special(HealPlayerParty)
                    playse(SE_USE_ITEM)
                    waitse
                    msgbox(HealedBeforeTradeMessage, MSGBOX_AUTOCLOSE)
                    waitmessage
                }
            }

            // trade pokemon
            removemon(SPECIES_POOCHYENA)
            lockall
            givemon(
                SPECIES_SMEARGLE,
                30,
                abilityNum=0, // own tempo
                nature=15, // Modest
                gender=0, 
                move1=MOVE_SWITCHEROO,
                move2=MOVE_UPROAR,
                move3=MOVE_SURF,
                move4=MOVE_CONVERSION_2,
                // EVs:
                hpEv=0, 
                spAtkEv=252,
                // IVs:
                hpIv=31,
                atkIv=31,
                defIv=31,
                speedIv=31,
                spAtkIv=31,
                spDefIv=28 // Resisted Krook Uproar (x1.5) ohkos
            )
            lockall
            setflag(FLAG_POOCH_TRADE_ACCEPTED)

            message(SmeargleReceivedMessage)
            playfanfare(MUS_OBTAIN_ITEM)
            lockall
            waitfanfare
            msgbox(PoochTradeAccepted, MSGBOX_AUTOCLOSE)
            waitmessage
        }
        // trade declined
        else{
            msgbox(PoochTradeDeclined, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    releaseall
}


