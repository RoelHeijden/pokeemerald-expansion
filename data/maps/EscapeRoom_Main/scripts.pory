        move1=MOVE_NATURE_POWER,
        move2=MOVE_GRASS_KNOT,
        move3=MOVE_GRASSY_TERRAIN,
        move4=MOVE_CAMOUFLAGE,
        // EVs:
        hpEv=252,
        spDefEv=252,
        // IVs:
        hpIv=31,
        atkIv=0,
        defIv=0,
        speedIv=31,
        spAtkIv=0,
        spDefIv=31
    )

    setflag(FLAG_SYS_POKEMON_GET)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 2)
}

