script EscapeRoom_EventScript_GraveStone1{
    lockall
    msgbox(GravestoneNoneMessage, MSGBOX_AUTOCLOSE)
    waitmessage

    // end if final check was reached
    if(flag(FLAG_GRAVESTONE_CHECK4) == TRUE){
        end
    }

    if (flag(FLAG_GRAVESTONE_CHECK1) == FALSE &&
        flag(FLAG_GRAVESTONE_CHECK2) == FALSE &&
        flag(FLAG_GRAVESTONE_CHECK3) == FALSE){
        msgbox(GravestoneClick1Message, MSGBOX_AUTOCLOSE)
        waitmessage    
        // set first flag
        setflag(FLAG_GRAVESTONE_CHECK1)
    }
    else{
        // reset msg
        msgbox(GravestoneResetMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        clearflag(FLAG_GRAVESTONE_CHECK1)
    }

    // clear flags
    clearflag(FLAG_GRAVESTONE_CHECK2)
    clearflag(FLAG_GRAVESTONE_CHECK3)


    releaseall
}

script EscapeRoom_EventScript_GraveStone2{
    lockall
    msgbox(GravestoneNoneMessage, MSGBOX_AUTOCLOSE)
    waitmessage

    // end if final check was reached
    if(flag(FLAG_GRAVESTONE_CHECK4) == TRUE){
        end
    }
    elif(flag(FLAG_GRAVESTONE_CHECK1) == TRUE ||
        flag(FLAG_GRAVESTONE_CHECK2) == TRUE ||
        flag(FLAG_GRAVESTONE_CHECK3) == TRUE){
        // reset msg
        msgbox(GravestoneResetMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }

    // clear flags
    clearflag(FLAG_GRAVESTONE_CHECK1)
    clearflag(FLAG_GRAVESTONE_CHECK2)
    clearflag(FLAG_GRAVESTONE_CHECK3)

    releaseall
}

script EscapeRoom_EventScript_GraveStone3{
    lockall
    msgbox(GravestoneNoneMessage, MSGBOX_AUTOCLOSE)
    waitmessage

    // end if final check was reached
    if(flag(FLAG_GRAVESTONE_CHECK4) == TRUE){
        end
    }

    if(flag(FLAG_GRAVESTONE_CHECK2) == TRUE)
    {
        msgbox(GravestoneClick3Message, MSGBOX_AUTOCLOSE)
        waitmessage
        // set third flag
        setflag(FLAG_GRAVESTONE_CHECK3)
    }
    elif(flag(FLAG_GRAVESTONE_CHECK1) == TRUE ||
        flag(FLAG_GRAVESTONE_CHECK3) == TRUE){
        // reset msg
        msgbox(GravestoneResetMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        clearflag(FLAG_GRAVESTONE_CHECK3)
    }
    else{
        clearflag(FLAG_GRAVESTONE_CHECK3)
    }
    // clear flags
    clearflag(FLAG_GRAVESTONE_CHECK1)
    clearflag(FLAG_GRAVESTONE_CHECK2)  

    releaseall
}

