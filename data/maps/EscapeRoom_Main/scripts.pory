script EscapeRoom_EventScript_AntiSoftlockGuy{
    faceplayer
    lockall

    // if no potential softlocks:
    msgbox(AntiSoftlockIntroMessage)
    msgbox(AntiSoftlockNoActionMessage)
    releaseall
}

script EscapeRoom_EventScript_LostGlassesNPC{
    lockall
    faceplayer
    msgbox(LostGlassesNPCmainMessage, MSGBOX_AUTOCLOSE)

    // if lost glasses obtained
    checkitem(ITEM_WISE_GLASSES)
    if(var(VAR_RESULT) == TRUE){

        // sanity check - check for poochyena in party
        checkpartymon(SPECIES_POOCHYENA)
        if(var(VAR_RESULT) == PARTY_SIZE)
        {
            msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
            waitmessage
            releaseall
            end
        }

        // display exclamation mark
        playse(SE_PIN)
        applymovement(LOCALID_GLASSES_GUY, Common_Movement_ExclamationMark)
        waitmovement(LOCALID_GLASSES_GUY)
        lockall

        msgbox(LostGlassesNPCGlassesFoundMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        call(EscapeRoom_EventScript_ObtainLiepard)
        lockall
        removeitem(ITEM_WISE_GLASSES)
        msgbox(LostGlassesNPCendMessage, MSGBOX_AUTOCLOSE)
        waitmessage 

        // walk away
        applymovement(LOCALID_GLASSES_GUY, EscapeRoom_Movement_LostGlassesNPC)
        waitmovement(LOCALID_GLASSES_GUY)
        delay(30)
        removeobject(LOCALID_GLASSES_GUY)

        // reset spawn and heal location
        call(EscapeRoom_EventScript_RelocateNurseNPC)

        // re allow Custap Berry
        clearflag(FLAG_CUSTAP_SOLD_OUT)
    }
    releaseall
    end
}

script EscapeRoom_EventScript_ObtainLiepard{
    lockall
    givemon(
        SPECIES_LIEPARD,
        50,
        abilityNum=2, // Prankster
        nature=17, // Quiet - make Krook outspeed if scarfed
        gender=0, 
        move1=MOVE_ASSIST,
        move2=MOVE_TRICK,
        move3=MOVE_ROCK_SMASH,
        move4=MOVE_ECHOED_VOICE,
        // EVs:
        atkEv=140, 
        spAtkEv=252,
        speedEv=0,
        // IVs:
        hpIv=31,
        atkIv=31,
        defIv=18, // for krook struggle >50%
        speedIv=31,
        spAtkIv=31,
        spDefIv=31
    )    
    message(LiepardObtainMessage)
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare
}

movement EscapeRoom_Movement_LostGlassesNPC{
    walk_left * 8
}

script EscapeRoom_EventScript_RelocateNurseNPC{
    setrespawn(HEAL_LOCATION_ESCAPE_ROOM_NURSE2)

    // player stops
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    delay(20)

    // move Nurse to player
    addobject(LOCALID_NURSE_DUMMY)
    applymovement(LOCALID_NURSE_DUMMY, EscapeRoom_Movement1_Nurse1NPC)
    waitmovement(LOCALID_NURSE_DUMMY)

    // dialogue and move player
    applymovement(OBJ_EVENT_ID_PLAYER, EscapeRoom_Movement_PlayerFaceRight)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    msgbox(RunningNurseMessage, MSGBOX_NPC)
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER, EscapeRoom_Movement_PlayerMoveAway)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    // move nurse out of screen
    applymovement(LOCALID_NURSE_DUMMY, EscapeRoom_Movement2_Nurse1NPC)
    waitmovement(LOCALID_NURSE_DUMMY)
    delay(30)
    removeobject(LOCALID_NURSE_DUMMY)

    // remove nurse 1
    removeobject(LOCALID_NURSE1) 
    setflag(FLAG_HIDE_NURSE1_NPC)
}

movement EscapeRoom_Movement_PlayerFaceRight{
    face_right
}

movement EscapeRoom_Movement1_Nurse1NPC{
    walk_fast_down
    walk_fast_left * 6
    walk_fast_up
    walk_fast_left
}

movement EscapeRoom_Movement_PlayerMoveAway{
    walk_up
    face_down
}

movement EscapeRoom_Movement2_Nurse1NPC{
    walk_fast_left * 9
}

