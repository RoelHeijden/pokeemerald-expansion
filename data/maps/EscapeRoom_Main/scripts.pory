// ONE-WAY ROCK SMASH NPC

script EscapeRoom_RockSmashNPC{
    lock
    msgbox(RockSmashNPCstuck, MSGBOX_NPC)
    waitmessage
    applymovement(LOCALID_ROCK_SMASH_NPC, _face_up)
    waitmovement(LOCALID_ROCK_SMASH_NPC)
    releaseall
}

script EscapeRoom_MoveRockSmashNPC{
    // script triggers if rock is smashed

    // exclamation mark
    playse(SE_PIN)
    applymovement(LOCALID_ROCK_SMASH_NPC, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_ROCK_SMASH_NPC)
    delay(30)
    
    // move NPC up
    applymovement(LOCALID_ROCK_SMASH_NPC, RockSmashNPCMovesUp)
    waitmovement(LOCALID_ROCK_SMASH_NPC)

    // dialogue
    msgbox(RockSmashNPCFarewellMsg, MSGBOX_AUTOCLOSE)
    waitmessage

    // move player away
    applymovement(OBJ_EVENT_ID_PLAYER, EscapeRoom_Movement_PlayerMoveAwayFromRock)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    // move NPC away
    applymovement(LOCALID_ROCK_SMASH_NPC, RockSmashNPCMovesAway)
    waitmovement(LOCALID_ROCK_SMASH_NPC)
    
    // remove object
    playse(SE_EXIT)
    delay(5)
    removeobject(LOCALID_ROCK_SMASH_NPC)
    setflag(FLAG_HIDE_ROCKSMASH_NPC)
    waitse

    // flags
    clearflag(FLAG_HIDE_ROCKSMASH_TUNNEL_NPC)
    setflag(FLAG_ROCK_SMASH_GUY_MOVED)
    
    // prevent Mental Herb restore
    removelostitem(ITEM_MENTAL_HERB)


    // ERROR CHECK
    // - 0 money
    // - trainer 4 defeated
    // - mental herb used
    checkpartyitem(0)
    copyvar(VAR_0x8006, VAR_0x8005)
    checkpartyitem(1)
    copyvar(VAR_0x8007, VAR_0x8005)

    checkitem(ITEM_MENTAL_HERB)
    copyvar(VAR_TEMP_4, VAR_RESULT)

    checkexactmoney(0)
    if(var(VAR_RESULT) == FALSE
        || !flag(FLAG_TRAINER4_DEFEATED)
        || (var(VAR_0x8006) == ITEM_MENTAL_HERB || var(VAR_0x8007) == ITEM_MENTAL_HERB)
        || var(VAR_TEMP_4) == TRUE)
    {
        lockall
        msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
    }

}

movement EscapeRoom_Movement_PlayerMoveAwayFromRock {
    walk_right
    walk_down
    face_up
}
movement RockSmashNPCMovesUp {
    walk_up
    face_right
}
movement RockSmashNPCMovesAway {
    walk_right * 3
    face_up
}


// STONE BUY NPC //

script EscapeRoom_TryBuyStonesPC{
    lock

    if(flag(FLAG_JABOCA_OBTAINED)){
        // post script message
        msgbox(StonesBuyNPCPostSellMessage, MSGBOX_NPC)
        waitmessage
    }
    else{
        // Sun Stone
        checkitem(ITEM_SUN_STONE)
        if(var(VAR_RESULT) == TRUE){
            call(EscapeRoom_TryBuyStonesPC_TryBuySunStone)
            end
        }

        // Moon Stone
        checkitem(ITEM_MOON_STONE)
        if(var(VAR_RESULT) == TRUE){
            call(EscapeRoom_TryBuyStonesPC_TryBuyMoonStone)
            end
        }

        // player has none of the trade items
        msgbox(StonesBuyNPCInitialMessage_no_item, MSGBOX_NPC)
        waitmessage
    }

    releaseall
}

script EscapeRoom_TryBuyStonesPC_TryBuySunStone{
    faceplayer
    msgbox(StonesBuyNPCInitialMessage_has_SunStone, MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES){
        removeitem(ITEM_SUN_STONE)
        addmoney(3000)
        lockall
        message(MoneyReceived3000)
        playfanfare(MUS_OBTAIN_ITEM)
        waitfanfare
        delay(10)

        setflag(FLAG_SUN_STONE_SOLD)

        msgbox(StonesBuyNPCSellAcceptedMessage, MSGBOX_NPC)
        waitmessage
    }
    else{
        msgbox(StonesBuyNPCSellDeclinedMessage, MSGBOX_NPC)
        waitmessage
    }
}

script EscapeRoom_TryBuyStonesPC_TryBuyMoonStone{
    faceplayer
    msgbox(StonesBuyNPCInitialMessage_has_MoonStone, MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES){
        removeitem(ITEM_MOON_STONE)
        giveitem(ITEM_JABOCA_BERRY)
        setflag(FLAG_JABOCA_OBTAINED)

        msgbox(StonesBuyNPCSellAcceptedMessage_JabocaBerry, MSGBOX_NPC)
        waitmessage
    }
    else{
        msgbox(StonesBuyNPCSellDeclinedMessage, MSGBOX_NPC)
        waitmessage
    }
}


// SECRET GARDEN GUARD //

script EscapeRoom_SecretGarden_GateEntryNPC_KeepOut{
    lockall

    // exclamation mark
    playse(SE_PIN)
    applymovement(LOCALID_SECRETGARDEN_GUARD, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_SECRETGARDEN_GUARD)
    applymovement(LOCALID_SECRETGARDEN_GUARD, _face_left)
    waitmovement(LOCALID_SECRETGARDEN_GUARD)
    delay(25)

    // message
    msgbox(SecretGardenGuardKeepOut, MSGBOX_AUTOCLOSE)
    waitmessage

    // player move left
    applymovement(OBJ_EVENT_ID_PLAYER, SecretGarden_PlayerMoveLeft)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    releaseall
}

script EscapeRoom_SecretGarden_GateEntryNPC_KickOut{
    lockall

    // exclamation mark
    playse(SE_PIN)
    applymovement(LOCALID_SECRETGARDEN_GUARD, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_SECRETGARDEN_GUARD)
    applymovement(LOCALID_SECRETGARDEN_GUARD, _face_down)
    waitmovement(LOCALID_SECRETGARDEN_GUARD)
    delay(30)

    applymovement(LOCALID_SECRETGARDEN_GUARD, SecretGarden_NPC_move_down)
    waitmovement(LOCALID_SECRETGARDEN_GUARD)
    applymovement(OBJ_EVENT_ID_PLAYER, _face_right)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    // player gets spotted message
    msgbox(SecretGardenGuardSpotted, MSGBOX_AUTOCLOSE)
    waitmessage
    
    // move NPC and player up
    applymovement(LOCALID_SECRETGARDEN_GUARD, SecretGarden_NPC_move_up)
    applymovement(OBJ_EVENT_ID_PLAYER, SecretGarden_PlayerMoveUp)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    lockall // to be sure

    // follow up message
    if(!flag(FLAG_SECRET_POWER_OBTAINED) || flag(FLAG_SECRET_POWER_COMPLETED)){
        msgbox(SecretGardenGuardStayOut, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    elif(!flag(FLAG_SECRET_POWER_COMPLETED)){
        msgbox(SecretGardenGuardRemoveSecretPower, MSGBOX_AUTOCLOSE)
        waitmessage
        lockall

        clearflag(FLAG_TEMP_1) // will notify if Secret Power was removed as item

        // remove TM Secret Power items
        checkpartyitem(0)
        if(var(VAR_RESULT) == TRUE && var(VAR_0x8005) == ITEM_TM43){
            removepartyitem(0)
            setflag(FLAG_TEMP_1)
        }
        checkpartyitem(1)
        if(var(VAR_RESULT) == TRUE && var(VAR_0x8005) == ITEM_TM43){
            removepartyitem(1)
            setflag(FLAG_TEMP_1)
        }
        checkitem(ITEM_TM43)
        if(var(VAR_RESULT) == TRUE){
            removeitem(ITEM_TM43)
            setflag(FLAG_TEMP_1)
        }

        // if Secret Power not held as TM, but move is learned:
        if(!flag(FLAG_TEMP_1)){
            call(EscapeRoom_EventScript_UndoSecretPowerTeach)
        }

        clearflag(FLAG_SECRET_POWER_OBTAINED)
        lockall
    }

    // move player away
    applymovement(OBJ_EVENT_ID_PLAYER, SecretGarden_PlayerMoveLeft)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    releaseall
}

script EscapeRoom_EventScript_UndoSecretPowerTeach{
    // find which pokemon learned Secret Power
    // check bagon
    istaughtmovepresent(SPECIES_BAGON, MOVE_SECRET_POWER)
    if(var(VAR_RESULT) == TRUE){
        setvar(VAR_0x8007, SPECIES_BAGON)

        // check if bagon has evolved to shelgon
        checkpartymon(SPECIES_SHELGON)
        if(var(VAR_RESULT) != PARTY_SIZE){
            setvar(VAR_0x8007, SPECIES_SHELGON)
        }
    }
    // check shelgon
    istaughtmovepresent(SPECIES_SHELGON, MOVE_SECRET_POWER)
    if(var(VAR_RESULT) == TRUE){
        setvar(VAR_0x8007, SPECIES_SHELGON)
    }
    // check primeape
    istaughtmovepresent(SPECIES_PRIMEAPE, MOVE_SECRET_POWER)
    if(var(VAR_RESULT) == TRUE){
        setvar(VAR_0x8007, SPECIES_PRIMEAPE)

        // check if primeape has evolved to annihilape
        checkpartymon(SPECIES_ANNIHILAPE)
        if(var(VAR_RESULT) != PARTY_SIZE){
            setvar(VAR_0x8007, SPECIES_ANNIHILAPE)
        }
    }
    // check annihilape
    istaughtmovepresent(SPECIES_ANNIHILAPE, MOVE_SECRET_POWER)
    if(var(VAR_RESULT) == TRUE){
        setvar(VAR_0x8007, SPECIES_ANNIHILAPE)
    }


    // undo secret power teach
    // (code is taken from undomoveteach)
    istaughtmovepresent(VAR_0x8007, MOVE_SECRET_POWER)
    replacemove2(VAR_0x8007, MOVE_SECRET_POWER, VAR_0x8004)
    removetaughtmove(VAR_0x8007, MOVE_SECRET_POWER)

    // remove taught move from evolution forms as well
    if(var(VAR_0x8007) == SPECIES_PRIMEAPE || var(VAR_0x8007) == SPECIES_ANNIHILAPE){
        removetaughtmove(SPECIES_PRIMEAPE, MOVE_SECRET_POWER)
        removetaughtmove(SPECIES_ANNIHILAPE, MOVE_SECRET_POWER)
    }
    if(var(VAR_0x8007) == SPECIES_BAGON || var(VAR_0x8007) == SPECIES_SHELGON){
        removetaughtmove(SPECIES_BAGON, MOVE_SECRET_POWER)
        removetaughtmove(SPECIES_SHELGON, MOVE_SECRET_POWER)
    }

    // Bagon edge case: Secret Power was overwritten by Flamethrower
    if(var(VAR_0x8007) == SPECIES_BAGON || var(VAR_0x8007) == SPECIES_SHELGON){

        // check if Flamethrower replaced Secret Power
        istaughtmovepresent(SPECIES_BAGON, MOVE_FLAMETHROWER)
        if(var(VAR_0x8004) == MOVE_SECRET_POWER){
            // set secret power taught move to MOVE_NONE instead of Flamethrower
            removetaughtmove(SPECIES_BAGON, MOVE_FLAMETHROWER)
        }
        // if flamethrower replaced another move
        elif(var(VAR_0x8004) != MOVE_NONE && var(VAR_RESULT) == TRUE){

            // put back old move
            if(var(VAR_0x8007) == SPECIES_BAGON){
                replacemove2(SPECIES_BAGON, MOVE_FLAMETHROWER, VAR_0x8004)
                addmonmove(SPECIES_BAGON, MOVE_FLAMETHROWER)
            }
            elif(var(VAR_0x8007) == SPECIES_SHELGON){
                replacemove2(SPECIES_SHELGON, MOVE_FLAMETHROWER, VAR_0x8004)
                addmonmove(SPECIES_SHELGON, MOVE_FLAMETHROWER)
            }
            removetaughtmove(SPECIES_BAGON, MOVE_FLAMETHROWER) 
        }
    }


    // set mon slot correctly for messaging
    // bagon/shelgon lost secret power
    if(var(VAR_0x8007) == SPECIES_BAGON || var(VAR_0x8007) == SPECIES_SHELGON){
        checkpartymon(SPECIES_BAGON)
        if(var(VAR_RESULT) != PARTY_SIZE){
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot
        }
        checkpartymon(SPECIES_SHELGON)
        if(var(VAR_RESULT) != PARTY_SIZE){
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot
        }
    }
    // primeape/annihilape lost secret power
    if(var(VAR_0x8007) == SPECIES_PRIMEAPE || var(VAR_0x8007) == SPECIES_ANNIHILAPE){
        checkpartymon(SPECIES_PRIMEAPE)
        if(var(VAR_RESULT) != PARTY_SIZE){
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot
        }
        checkpartymon(SPECIES_ANNIHILAPE)
        if(var(VAR_RESULT) != PARTY_SIZE){
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot
        }
    }

    // do move unlearned message
    playse(SE_SUCCESS)
    waitse
    special(BufferMonNickname)
    msgbox(MonForgotSecretPower, MSGBOX_AUTOCLOSE)
    waitmessage
}

movement SecretGarden_NPC_move_down {
    walk_fast_down * 2
    face_left
}
movement SecretGarden_NPC_move_up {
    face_up
    walk_up * 2
    face_left
}
movement SecretGarden_PlayerMoveUp {
    face_up
    walk_up * 2
    face_right
}
movement SecretGarden_PlayerMoveLeft {
    face_left
    walk_left
}


//// RANDOM HINT NPCS ////

script EscapeRoom_AnnihilapeHintNPC{
    lock

    // initial message
    if(flag(FLAG_HIDE_ANNIHILAPE) == TRUE){
        msgbox(AnnihilapeHintNoMessage1, MSGBOX_AUTOCLOSE)
        waitmessage
        delay(20)
        faceplayer
        msgbox(AnnihilapeHintNoMessage2, MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(LOCALID_APE_HINT_NPC, _face_up)
        waitmovement(LOCALID_APE_HINT_NPC)
    }
    // if ape has spawned
    else{
        msgbox(AnnihilapeHintMessage, MSGBOX_NPC)
        waitmessage
    }
    releaseall
}

script EscapeRoom_TabletsHintNPC{
    lock
    if(flag(FLAG_TRAINER6_DEFEATED) == FALSE){
        msgbox(FourTabletsHintMessage1, MSGBOX_NPC)
    }
    elif(flag(FLAG_MAP_SWITCHES_SOLVED) == FALSE){
        msgbox(FourTabletsHintMessage2, MSGBOX_NPC)
    }
    else{
        msgbox(FourTabletsHintMessage3, MSGBOX_NPC)
    }
    releaseall
}


