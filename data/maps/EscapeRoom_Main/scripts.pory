//// POST BATTLE SCRIPTS ////

script EscapeRoom_EventScript_PostMatchHeal{
    special(HealPlayerParty)
}

script EscapeRoom_EventScript_Trainer1PostBattle{
    // prevent white herb restore after winning
    clearflag(FLAG_RECOVERED_WHITE_HERB)
    checkpartymon(SPECIES_ZERAORA)
    copyvar(VAR_TEMP_0, VAR_RESULT) // copy mon slot
    if(var(VAR_TEMP_0) != PARTY_SIZE){
        checkpartyitem(VAR_TEMP_0) // sets item in VAR_0x8005
        if(var(VAR_0x8005) == ITEM_WHITE_HERB){
            removepartyitem(VAR_TEMP_0)
        }
    }

    call(EscapeRoom_EventScript_PostMatchHeal)
    call(EscapeRoom_EventScript_TradeZeraForHMCut)
}

script EscapeRoom_EventScript_Trainer2PostBattle{
    // prevent maranga restore after winning
    clearflag(FLAG_RECOVERED_MARANGA)
    checkpartymon(SPECIES_FLORGES)
    copyvar(VAR_TEMP_0, VAR_RESULT) // copy mon slot
    if(var(VAR_TEMP_0) != PARTY_SIZE){
        checkpartyitem(VAR_TEMP_0) // sets item in VAR_0x8005
        if(var(VAR_0x8005) == ITEM_MARANGA_BERRY){
            removepartyitem(VAR_TEMP_0)
        }
    }
    
    call(EscapeRoom_EventScript_PostMatchHeal)
}

script EscapeRoom_EventScript_Trainer3PostBattle{
    // move away from door
    lockall
    msgbox(Trainer3FinalWords, MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_TRAINER3, EscapeRoom_Movement_Trainer3End)
    waitmovement(LOCALID_TRAINER3)
    copyobjectxytoperm(LOCALID_TRAINER3)

    // set flag to keep it moved away
    setflag(FLAG_TRAINER3_DEFEATED)

    // heal 
    call(EscapeRoom_EventScript_PostMatchHeal)

    releaseall
    end
}

movement EscapeRoom_Movement_Trainer3End{
    face_right
    walk_right * 2
    face_left
}


script EscapeRoom_EventScript_Trainer5PostBattle{
    // prevent custap restore after winning
    clearflag(FLAG_RECOVERED_CUSTAP)
    checkpartymon(SPECIES_POOCHYENA)
    copyvar(VAR_TEMP_0, VAR_RESULT) // copy mon slot
    if(var(VAR_TEMP_0) != PARTY_SIZE){
        checkpartyitem(VAR_TEMP_0) // sets item in VAR_0x8005
        if(var(VAR_0x8005) == ITEM_CUSTAP_BERRY){
            removepartyitem(VAR_TEMP_0)
        }
    }
    
    call(EscapeRoom_EventScript_PostMatchHeal)
}


//// POKEMON TRADES ////

script EscapeRoom_EventScript_TradeZeraForHMCut{
    lockall
    msgbox(AskZeraCutTradeMessage, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){

        // check if pokemon in party
        checkpartymon(SPECIES_ZERAORA)
        if(var(VAR_RESULT) == PARTY_SIZE)
        {
            msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
            waitmessage
            releaseall
            end
        }

        // trade pokemon
        setflag(FLAG_ZERA_TRADED)
        removemon(SPECIES_ZERAORA)
        giveitem(ITEM_HM01)
        msgbox(ZeraCutTradeAccepted, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    else{
        msgbox(ZeraCutTradeDeclined, MSGBOX_AUTOCLOSE)
    }
    releaseall
}

script EscapeRoom_EventScript_TradeFerroVsDunsparce{
    lockall
    faceplayer

    // post trade 
    if(flag(FLAG_FERRO_TRADE_ACCEPTED) == TRUE){
        msgbox(FerroTradePostTrade, MSGBOX_NPC)
        waitmessage
    }
    else{
        // ask trade
        msgbox(AskFerroDunsparceTrade, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){

            // check if pokemon in party
            checkpartymon(SPECIES_FERROTHORN)
            if(var(VAR_RESULT) == PARTY_SIZE)
            {
                msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
                waitmessage
                releaseall
                end
            }

            // trade pokemon
            removemon(SPECIES_FERROTHORN)
            givemon(
                SPECIES_DUNSPARCE,
                50,
                abilityNum=2, // rattled
                nature=8, // impish
                gender=0, 
                move1=MOVE_TRUMP_CARD,
                move2=MOVE_AIR_SLASH,
                move3=MOVE_HEX,
                move4=MOVE_COUNTER,
                // EVs:
                hpEv=0, 
                defEv=252,
                // IVs:
                hpIv=0,
                atkIv=0,
                defIv=31,
                speedIv=31,
                spAtkIv=10,
                spDefIv=31
            )
            setflag(FLAG_FERRO_TRADE_ACCEPTED)

            message(DunsparceReceivedMessage)
            playfanfare(MUS_OBTAIN_ITEM)
            waitfanfare

            lockall
            msgbox(FerroTradeAccepted, MSGBOX_AUTOCLOSE)
            waitmessage
        }
        // trade declined
        else{
            msgbox(FerroTradeDeclined, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    releaseall
    end
}

