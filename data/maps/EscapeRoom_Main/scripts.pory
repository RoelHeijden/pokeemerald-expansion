// ANTI SOFTLOCK GUY

script EscapeRoom_EventScript_AntiSoftlockGuy1{
    setflag(FLAG_AT_SOFTLOCK_GUY_1)
    call(EscapeRoom_EventScript_AntiSoftlockGuy)
    clearflag(FLAG_AT_SOFTLOCK_GUY_1)
}

script EscapeRoom_EventScript_AntiSoftlockGuy2{
    call(EscapeRoom_EventScript_AntiSoftlockGuy)
}

script EscapeRoom_EventScript_AntiSoftlockGuy3{
    call(EscapeRoom_EventScript_AntiSoftlockGuy)
}

script EscapeRoom_EventScript_AntiSoftlockGuy{
    faceplayer
    lockall
    msgbox(AntiSoftlockIntroMessage, MSGBOX_DEFAULT)
    waitmessage

    // separate message allows for script to cut back to the option selection
    OptionMenuStart:
        msgbox(AntiSoftlockIntroMessage2, MSGBOX_SOFTLOCK_GUY)

        // return lost items 
        if(var(VAR_RESULT) == 0){
            call(EscapeRoom_EventScript_ReturnLostItems)
        }

        // undo used items
        elif(var(VAR_RESULT) == 1){
            call(EscapeRoom_EventScript_UndoUsedItems)
        }

        // undo other actions
        elif(var(VAR_RESULT) == 2){
            call(EscapeRoom_EventScript_UndoOtherActions)
        }

        // B press
        else{
            msgbox(AntiSoftlockOutro, MSGBOX_AUTOCLOSE)
            waitmessage
            releaseall
            end
        }
    
    // presents options again
    if(flag(FLAG_ANTI_SOFTLOCK_LOOP)){
        clearflag(FLAG_ANTI_SOFTLOCK_LOOP)
        goto(OptionMenuStart)
    }
    releaseall
    end
}

// return items
script EscapeRoom_EventScript_ReturnLostItems{
    // clear flags
    clearflag(FLAG_TEMP_1) // an item was returned and heal required
    clearflag(FLAG_TEMP_2) // an item was returned, no heal
    clearflag(FLAG_TEMP_3) // mental herb return while mental herb sack active


    //// FIELD ITEMS ////

    // escape rope
    if(flag(FLAG_RETURN_ESCAPE_ROPE)){
        giveitem(ITEM_ESCAPE_ROPE)
        clearflag(FLAG_RETURN_ESCAPE_ROPE)
        setflag(FLAG_TEMP_2) // no heal
    }

    // berry juice
    if(flag(FLAG_RETURN_BERRY_JUICE)){
        giveitem(ITEM_BERRY_JUICE)
        clearflag(FLAG_RETURN_BERRY_JUICE)
        setflag(FLAG_TEMP_2)  // no heal
    }

    // ether
    if(flag(FLAG_RETURN_ETHER)){
        giveitem(ITEM_ETHER)
        clearflag(FLAG_RETURN_ETHER)

        // only heal if Camouflage has 1/1 pp
        checkmonmove0pp(SPECIES_FLORGES, MOVE_CAMOUFLAGE)
        if(var(VAR_RESULT) == TRUE){
            setflag(FLAG_TEMP_2) // no heal if Camouflage has 0/1 pp
        }
        else{
            setflag(FLAG_TEMP_1)
        }
    }


    //// HELD BATTLE ITEMS ////

    // custap berry
    isitemlost(ITEM_CUSTAP_BERRY)
    if(var(VAR_RESULT) == TRUE){
        removelostitem(ITEM_CUSTAP_BERRY)
        giveitem(ITEM_CUSTAP_BERRY)
        setflag(FLAG_TEMP_1)
    }

    // mental herb
    isitemlost(ITEM_MENTAL_HERB)
    if(var(VAR_RESULT) == TRUE){

        // dont return if in section 1 during first mental herb sack line
        if(flag(FLAG_AT_SOFTLOCK_GUY_1) && flag(FLAG_DUNSPARCE_TRADE_ACCEPTED) && !flag(FLAG_ROCK_SMASH_GUY_MOVED)){
            // fallthrough
        }
        else{
            removelostitem(ITEM_MENTAL_HERB)
            giveitem(ITEM_MENTAL_HERB)
            setflag(FLAG_TEMP_1)

            // if mental herb used for dusknoir sack is active
            if(flag(FLAG_MENTAL_HERB_SACK_ACTIVE)){
                setflag(FLAG_TEMP_3)
            }
        }
    }

    // ring target
    isitemlost(ITEM_RING_TARGET)
    if(var(VAR_RESULT) == TRUE){
        removelostitem(ITEM_RING_TARGET)
        giveitem(ITEM_RING_TARGET)
        setflag(FLAG_TEMP_1)  
    }

    // Jaboca Berry
    isitemlost(ITEM_JABOCA_BERRY)
    if(var(VAR_RESULT) == TRUE){
        removelostitem(ITEM_JABOCA_BERRY)
        giveitem(ITEM_JABOCA_BERRY)
        setflag(FLAG_TEMP_1)  
    }


    //// SPECIAL CASES TRAINER5 ////

    // special case: Dusk Stone (lost at trainer5)
    if(flag(FLAG_DUSK_STONE_CONSUMED) && flag(FLAG_TRAINER5_DEFEATED) && !flag(FLAG_TRAINER6_DEFEATED)){
        clearflag(FLAG_DUSK_STONE_CONSUMED)
        giveitem(ITEM_DUSK_STONE)
        setflag(FLAG_TEMP_2)  // no heal
    }

    // special case: Jaboca Berry (lost at trainer5)
    if(flag(FLAG_JABOCA_CONSUMED) && flag(FLAG_TRAINER5_DEFEATED) && !flag(FLAG_TRAINER6_DEFEATED)){
        clearflag(FLAG_JABOCA_CONSUMED)
        giveitem(ITEM_JABOCA_BERRY)
        setflag(FLAG_TEMP_2)  // no heal
    }

    // special case: Safety Goggles (lost at trainer5)
    if(flag(FLAG_SAFETY_GOGGLES_CONSUMED) && flag(FLAG_TRAINER5_DEFEATED) && !flag(FLAG_TRAINER6_DEFEATED)){
        clearflag(FLAG_SAFETY_GOGGLES_CONSUMED)
        giveitem(ITEM_SAFETY_GOGGLES)
        setflag(FLAG_TEMP_2)  // no heal
    }


    //// HEAL AND MESSAGES ////

    // at least one item was restored
    // heal party and message
    if(flag(FLAG_TEMP_1) || flag(FLAG_TEMP_2)){

        // special case: if Ape sequence
        if(flag(FLAG_RAN_FROM_TRAPINCH) && !flag(FLAG_TRAINER6_DEFEATED) && var(VAR_RESPAWN_SET_AT_NURSE1) == 1){

            // if mental herb retrieved during a mental herb dusknoir sack line (FLAG_TEMP_3)
            if(flag(FLAG_TEMP_3)){
                // heal entire party
                special(HealPlayerParty)

                // message
                msgbox(AntiSoftlockPartyHealed, MSGBOX_DEFAULT)
                waitmessage

                // warp back to section 2
                warpteleport(MAP_ESCAPE_ROOM_MAIN, 23, 11)
                waitstate

            }
            // heal Aipom only
            else{
                healpartymon(SPECIES_AIPOM)

                // message
                msgbox(AntiSoftlockSomeOfPartyHealed, MSGBOX_DEFAULT)
                waitmessage
            }
        }
        // any other case: heal entire party
        elif(flag(FLAG_TEMP_1) == TRUE){
            special(HealPlayerParty)

            // message
            msgbox(AntiSoftlockPartyHealed, MSGBOX_DEFAULT)
            waitmessage
        }
        else{
            // only flag_temp_2 was true. Do nothing else
        }
    }
    // no items to restore
    // message
    else{
        msgbox(AntiSoftlockNoItemsReturned, MSGBOX_DEFAULT)
        waitmessage

        // loop back to initial option menu
        setflag(FLAG_ANTI_SOFTLOCK_LOOP)
    }

}

// undo item
    // - rare candy (in ape sequence: heal aipom)
    // - exp candy
    // - TM Thief 
        // - (remove Snowball!) 
        // - (during trainer4 sequence: heal party)
        // - (take toxic orb, heal party)
    // - TM Skill Swap
    // - HM Cut (if Ferrothorn: reset tree)
script EscapeRoom_EventScript_UndoUsedItems{
    // check Thief
    // Thief can be taught to pokemon that also learn Cut, so
    // it uses differet VARs to store species and move
    istaughtmovepresent(SPECIES_DUNSPARCE, MOVE_THIEF)
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_CAN_UNDO_THIEF)
        setvar(VAR_0x8005, SPECIES_DUNSPARCE)
        setvar(VAR_0x8006, MOVE_THIEF)
    }
    istaughtmovepresent(SPECIES_AIPOM, MOVE_THIEF)
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_CAN_UNDO_THIEF)
        setvar(VAR_0x8005, SPECIES_AIPOM)
        setvar(VAR_0x8006, MOVE_THIEF)
    }
    istaughtmovepresent(SPECIES_LIEPARD, MOVE_THIEF)
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_CAN_UNDO_THIEF)
        setvar(VAR_0x8005, SPECIES_LIEPARD)
        setvar(VAR_0x8006, MOVE_THIEF)
    }
    istaughtmovepresent(SPECIES_CACNEA, MOVE_THIEF)
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_CAN_UNDO_THIEF)
        setvar(VAR_0x8005, SPECIES_CACNEA)
        setvar(VAR_0x8006, MOVE_THIEF)
    }

    // check Cut
    istaughtmovepresent(SPECIES_FERROTHORN, MOVE_CUT)
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_CAN_UNDO_CUT)
        setvar(VAR_0x8007, SPECIES_FERROTHORN)
        setvar(VAR_0x8008, MOVE_CUT)
    }
    istaughtmovepresent(SPECIES_LIEPARD, MOVE_CUT)
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_CAN_UNDO_CUT)
        setvar(VAR_0x8007, SPECIES_LIEPARD)
        setvar(VAR_0x8008, MOVE_CUT)
    }
    istaughtmovepresent(SPECIES_CACNEA, MOVE_CUT)
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_CAN_UNDO_CUT)
        setvar(VAR_0x8007, SPECIES_CACNEA)
        setvar(VAR_0x8008, MOVE_CUT)
    }

    // check Skill Swap
    istaughtmovepresent(SPECIES_FLORGES, MOVE_SKILL_SWAP)
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_CAN_UNDO_SKILL_SWAP)
        setvar(VAR_0x8007, SPECIES_FLORGES)
        setvar(VAR_0x8008, MOVE_SKILL_SWAP)
    }

    // check Rare Candy
    if(var(VAR_RARE_CANDY_1_USED_ON) != SPECIES_NONE ||
       var(VAR_RARE_CANDY_2_USED_ON) != SPECIES_NONE ||
       var(VAR_RARE_CANDY_3_USED_ON) != SPECIES_NONE){
        setflag(FLAG_CAN_UNDO_RARE_CANDY)
    }

    // check Exp Candy
    if(var(VAR_EXP_CANDY_USED_ON) != SPECIES_NONE){
        setflag(FLAG_CAN_UNDO_EXP_CANDY)
    }

    // create and handle choice options 
    call(EscapeRoom_EventScript_UndoUsedItems_CreateMultichoice)

    // clear flags
    clearflag(FLAG_CAN_UNDO_THIEF)
    clearflag(FLAG_CAN_UNDO_CUT)
    clearflag(FLAG_CAN_UNDO_SKILL_SWAP)
    clearflag(FLAG_CAN_UNDO_EXP_CANDY)
    clearflag(FLAG_CAN_UNDO_RARE_CANDY)
    clearflag(FLAG_UNDOING_MOVE_THIEF)
}

script EscapeRoom_EventScript_UndoUsedItems_CreateMultichoice{
    //// MULTI CHOICE ////
    // Thief, Cut, Rare Candy
    if(flag(FLAG_CAN_UNDO_THIEF) && flag(FLAG_CAN_UNDO_CUT) && flag(FLAG_CAN_UNDO_RARE_CANDY)){
        dynmultichoice(30, 6, FALSE, 6, 0, 0, OptionUndoThief, OptionUndoCut, OptionUndoRareCandy) 
        goto(DecodeMultiChoice)
    }
    // Thief, Cut
    elif(flag(FLAG_CAN_UNDO_THIEF) && flag(FLAG_CAN_UNDO_CUT)){
        dynmultichoice(30, 8, FALSE, 6, 0, 0, OptionUndoThief, OptionUndoCut)        
        goto(DecodeMultiChoice)
    }
    // Thief, Rare Candy
    elif(flag(FLAG_CAN_UNDO_THIEF) && flag(FLAG_CAN_UNDO_RARE_CANDY)){
        dynmultichoice(30, 8, FALSE, 6, 0, 0, OptionUndoThief, OptionUndoRareCandy)   
        goto(DecodeMultiChoice)
    }
    // Cut, Rare Candy
    elif(flag(FLAG_CAN_UNDO_CUT) && flag(FLAG_CAN_UNDO_RARE_CANDY)){
        dynmultichoice(30, 8, FALSE, 6, 0, 0, OptionUndoCut, OptionUndoRareCandy)  
        goto(DecodeMultiChoice)
    }
    // Thief, Exp Candy
    elif(flag(FLAG_CAN_UNDO_THIEF) && flag(FLAG_CAN_UNDO_EXP_CANDY)){
        dynmultichoice(30, 8, FALSE, 6, 0, 0, OptionUndoThief, OptionUndoExpCandy) 
        goto(DecodeMultiChoice)
    }
    // Skill Swap, Exp Candy
    elif(flag(FLAG_CAN_UNDO_SKILL_SWAP) && flag(FLAG_CAN_UNDO_EXP_CANDY)){
        dynmultichoice(30, 8, FALSE, 6, 0, 0, OptionUndoSkillSwap, OptionUndoExpCandy) 
        goto(DecodeMultiChoice)
    }

    //// SINGLE CHOICE ////
    // Thief
    elif(flag(FLAG_CAN_UNDO_THIEF)){
        setflag(FLAG_UNDOING_MOVE_THIEF)
        call(EscapeRoom_EventScript_UndoMoveTeach)
        return
    }
    // Cut
    elif(flag(FLAG_CAN_UNDO_CUT)){
        call(EscapeRoom_EventScript_UndoMoveTeach)
        return
    }
    // Skill Swap
    elif(flag(FLAG_CAN_UNDO_SKILL_SWAP)){
        call(EscapeRoom_EventScript_UndoMoveTeach)
        return
    }
    // Rare Candy
    elif(flag(FLAG_CAN_UNDO_RARE_CANDY)){
        call(EscapeRoom_EventScript_UndoRareCandy)
        return
    }
    // Exp Candy
    elif(flag(FLAG_CAN_UNDO_EXP_CANDY)){
        call(EscapeRoom_EventScript_UndoExpCandy)
        return
    }

    // no items to be undone
    else{
        msgbox(AntiSoftlockNoItemToUndo, MSGBOX_DEFAULT)
        waitmessage

        // prompt options again
        goto(SetPromptOptionsAgain)
    }

    // decode multi choice selected option
    // fixed order: Thief, Cut, Skill Swap, Rare Candy, Exp Candy
    DecodeMultiChoice:
        if (flag(FLAG_CAN_UNDO_THIEF)) {
            if (var(VAR_RESULT) == 0) {
                setflag(FLAG_UNDOING_MOVE_THIEF)
                call(EscapeRoom_EventScript_UndoMoveTeach)
                return
            }
            subvar(VAR_RESULT, 1)
        }
        if (flag(FLAG_CAN_UNDO_CUT)) {
            if (var(VAR_RESULT) == 0) {
                call(EscapeRoom_EventScript_UndoMoveTeach)
                return
            }
            subvar(VAR_RESULT, 1)
        }
        if (flag(FLAG_CAN_UNDO_SKILL_SWAP)) {
            if (var(VAR_RESULT) == 0) {
                call(EscapeRoom_EventScript_UndoMoveTeach)
                return
            }
            subvar(VAR_RESULT, 1)
        }
        if (flag(FLAG_CAN_UNDO_RARE_CANDY)) {
            if (var(VAR_RESULT) == 0) {
                call(EscapeRoom_EventScript_UndoRareCandy)
                return
            }
            subvar(VAR_RESULT, 1)
        }
        if (flag(FLAG_CAN_UNDO_EXP_CANDY)) {
            if (var(VAR_RESULT) == 0) {
                call(EscapeRoom_EventScript_UndoExpCandy)
                return
            }
            subvar(VAR_RESULT, 1)
        }

        // none of the options chosen: B Press
        SetPromptOptionsAgain:
            // loop back to initial option menu
            setflag(FLAG_ANTI_SOFTLOCK_LOOP)
}

script EscapeRoom_EventScript_UndoMoveTeach{
    // use other vars if restoring Thief
    if(flag(FLAG_UNDOING_MOVE_THIEF)){
        copyvar(VAR_0x8007, VAR_0x8005)
        copyvar(VAR_0x8008, VAR_0x8006)
    }

    // buffer VAR_0x8007 and VAR_0x8008
    bufferspeciesname(STR_VAR_1, VAR_0x8007)
    buffermovename(STR_VAR_2, VAR_0x8008)

    // ask undo message 
    msgbox(AskUndoMoveTeachDynamic, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){

        // check edge case: Thief overwritten by Cut
        if(flag(FLAG_UNDOING_MOVE_THIEF)){
            call(EscapeRoom_EventScript_UndoMoveTeach_CutThiefEdgeCase)
        }

        // set VAR_0x8004 to the right move to replace
        istaughtmovepresent(VAR_0x8007, VAR_0x8008)

        // reset moves
        replacemove2(VAR_0x8007, VAR_0x8008, VAR_0x8004)
        removetaughtmove(VAR_0x8007, VAR_0x8008)

        // set species to another variable
        // this fixed the message buffer bug
        copyvar(VAR_0x8005, VAR_0x8007)

        // return item
        if(var(VAR_0x8008) == MOVE_THIEF){
            giveitem(ITEM_TM46)
        }
        elif(var(VAR_0x8008) == MOVE_SKILL_SWAP){
            giveitem(ITEM_TM48)
        }

        // message
        checkpartymon(VAR_0x8005) 
        copyvar(VAR_0x8004, VAR_RESULT) // set monslot in VAR_0x8004
        special(BufferMonNickname)      // buffer nickname (VAR_0x8004) to STR_VAR_1

        msgbox(MoveTeachUndoneMessage, MSGBOX_DEFAULT)
        waitmessage
    }
}

script EscapeRoom_EventScript_UndoMoveTeach_CutThiefEdgeCase{
    // check if species still has the move Thief
    checkpartymonmove(VAR_0x8007, MOVE_THIEF)
    if(var(VAR_RESULT) == PARTY_SIZE){      // Thief not found
        
        // check if Cut on moveset
        checkpartymonmove(VAR_0x8007, MOVE_CUT)
        if(var(VAR_RESULT) != PARTY_SIZE){  // Cut found

            // check if Cut in TaughtMoveEntry data
            istaughtmovepresent(VAR_0x8007, MOVE_CUT)
            if(var(VAR_RESULT) == TRUE){

                // undo Cut teach
                replacemove2(VAR_0x8007, MOVE_CUT, MOVE_THIEF)
                removetaughtmove(VAR_0x8007, MOVE_CUT)
            }

            // set VAR_0x8004 back for Thief undo move
            istaughtmovepresent(VAR_0x8007, MOVE_THIEF)
        }
    }
}

script EscapeRoom_EventScript_UndoRareCandy{
    // clear flags
    clearflag(FLAG_TEMP_1)
    clearflag(FLAG_TEMP_2)

    // set species in var VAR_0x8005
    if(var(VAR_RARE_CANDY_1_USED_ON) != SPECIES_NONE){
        copyvar(VAR_0x8005, VAR_RARE_CANDY_1_USED_ON)
    }
    elif(var(VAR_RARE_CANDY_2_USED_ON) != SPECIES_NONE){
        copyvar(VAR_0x8005, VAR_RARE_CANDY_2_USED_ON)
    }
    elif(var(VAR_RARE_CANDY_3_USED_ON) != SPECIES_NONE){
        copyvar(VAR_0x8005, VAR_RARE_CANDY_3_USED_ON)
    }
    // this should never trigger
    else{
        return
    }

    // buffer VAR_0x8005
    bufferspeciesname(STR_VAR_1, VAR_0x8005)

    // ask undo message 
    msgbox(AskUndoRareCandyDynamic, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){

        // check unevolve pokemon if Cacturne
        if(var(VAR_0x8005) == SPECIES_CACNEA){
            checkpartymon(SPECIES_CACTURNE)
            if(var(VAR_RESULT) != PARTY_SIZE){
                // set flag and var for unevolved message
                setflag(FLAG_TEMP_1)
            }
        }

        // check unevolve pokemon if Annihilape
        if(var(VAR_0x8005) == SPECIES_PRIMEAPE){
            checkpartymon(SPECIES_ANNIHILAPE)
            if(var(VAR_RESULT) != PARTY_SIZE){

                // only unevolve if still at lvl 45
                checkpartymonlevel(45) 
                if(var(VAR_0x8004) == SPECIES_ANNIHILAPE){
                    // set flag and var for unevolved message
                    setflag(FLAG_TEMP_2)
                }
            }
        }

        // give back rare candy
        giveitem(ITEM_RARE_CANDY)

        // normal rare candy undone message
        if(!flag(FLAG_TEMP_1) && !flag(FLAG_TEMP_2)){
            checkpartymon(VAR_0x8005) 
            copyvar(VAR_0x8004, VAR_RESULT) // set monslot in VAR_0x8004
            special(BufferMonNickname)      // buffer nickname (VAR_0x8004) to STR_VAR_1
            msgbox(RareCandyUndoneMessage, MSGBOX_DEFAULT)
            waitmessage
        }

        // Pokemon unevolved rare candy undone message
        else{
            // Cacturne
            if(flag(FLAG_TEMP_1)){
                // buffer names for message
                checkpartymon(SPECIES_CACTURNE) 
                copyvar(VAR_0x8004, VAR_RESULT) 
                special(BufferMonNickname) 
                bufferspeciesname(STR_VAR_2, SPECIES_CACNEA)

                // unevolve Cacturne
                unEvolveMonTo(SPECIES_CACTURNE, SPECIES_CACNEA)
            }
            // Annihilape
            if(flag(FLAG_TEMP_2)){
                // buffer names for message
                checkpartymon(SPECIES_ANNIHILAPE) 
                copyvar(VAR_0x8004, VAR_RESULT) 
                special(BufferMonNickname) 
                bufferspeciesname(STR_VAR_2, SPECIES_PRIMEAPE)

                // unevolve Annihilape
                unEvolveMonTo(SPECIES_ANNIHILAPE, SPECIES_PRIMEAPE)
            }
            msgbox(RareCandyUndoneUnevolveMessage, MSGBOX_AUTOCLOSE)
            waitmessage
        }

        // level down Pokemon
        levelDownMon(VAR_0x8005)

        // reset vars
        if(var(VAR_RARE_CANDY_1_USED_ON) == VAR_0x8005){
            setvar(VAR_RARE_CANDY_1_USED_ON, SPECIES_NONE)
        }
        elif(var(VAR_RARE_CANDY_2_USED_ON) == VAR_0x8005){
            setvar(VAR_RARE_CANDY_2_USED_ON, SPECIES_NONE)
        }
        elif(var(VAR_RARE_CANDY_3_USED_ON) == VAR_0x8005){
            setvar(VAR_RARE_CANDY_3_USED_ON, SPECIES_NONE)
        }
    }
}

script EscapeRoom_EventScript_UndoExpCandy{
    // set species in VAR_0x8005
    copyvar(VAR_0x8005, VAR_EXP_CANDY_USED_ON)
    bufferspeciesname(STR_VAR_1, VAR_0x8005)

    // ask undo message 
    msgbox(AskUndoExpCandyDynamic, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        // remove exp
        removeExpFromMon(VAR_0x8005, 800)

        // return item
        giveitem(ITEM_EXP_CANDY_S)

        // message
        checkpartymon(VAR_0x8005) 
        copyvar(VAR_0x8004, VAR_RESULT) // set monslot in VAR_0x8004
        special(BufferMonNickname)      // buffer nickname (VAR_0x8004) to STR_VAR_1
        msgbox(ExpCandyUndoneMessage, MSGBOX_DEFAULT)
        waitmessage

        // reset exp candy var
        setvar(VAR_EXP_CANDY_USED_ON, SPECIES_NONE)
    }
}

// undo event
script EscapeRoom_EventScript_UndoOtherActions{
    // ether purchase
    checkpartyitem(0)
    copyvar(VAR_TEMP_0, VAR_0x8005)
    checkpartyitem(1)
    copyvar(VAR_TEMP_1, VAR_0x8005)
    checkitem(ITEM_ETHER)
    if((var(VAR_RESULT) == TRUE || 
        var(VAR_TEMP_0) == ITEM_ETHER || 
        var(VAR_TEMP_1) == ITEM_ETHER) && 
        flag(FLAG_ETHER_BOUGHT) && !flag(FLAG_ZERAORA_CAUGHT)){

        // ask undo Ether purchase
        msgbox(AntiSoftlockAskUndoEtherPurchase, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            call(EscapeRoom_EventScript_UndoEtherPurchase)
        }
    }

    // trainer5 rematch
    elif(flag(FLAG_TRAINER5_DEFEATED) && !flag(FLAG_ABILITY_CAPSULE_BOUGHT)){
        msgbox(AntiSoftlockAskUndoTrainer5, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            call(EscapeRoom_EventScript_SetTrainer5Rematch)
        }
    }

    // trade: ferro -> dunsparce
    elif(flag(FLAG_FERRO_TRADE_ACCEPTED) && !flag(FLAG_TRAINER3_DEFEATED)){
        msgbox(AntiSoftlockAskUndoFerroTrade, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            call(EscapeRoom_EventScript_UndoFerroTrade)
        }
    }

    // trade: florges -> egg
    elif(flag(FLAG_FLORGES_TRADE_ACCEPTED) && !flag(FLAG_LIEPARD_OBTAINED)){
        msgbox(AntiSoftlockAskUndoFlorgesTrade, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            call(EscapeRoom_EventScript_UndoFlorgesTrade)
        }
    }

    // no actions to be undone
    else{
        msgbox(AntiSoftlockNoActionsToUndo, MSGBOX_DEFAULT)
        waitmessage

        // loop back to initial option menu
        setflag(FLAG_ANTI_SOFTLOCK_LOOP)
    }
}

script EscapeRoom_EventScript_UndoEtherPurchase{
    // remove from bag
    checkitem(ITEM_ETHER)
    if(var(VAR_RESULT) == TRUE){
        removeitem(ITEM_ETHER)
    }

    // remove from party
    checkpartyitem(0)
    if(var(VAR_0x8005) == ITEM_ETHER){
        removepartyitem(0)
    }
    checkpartyitem(1)
    if(var(VAR_0x8005) == ITEM_ETHER){
        removepartyitem(1)
    }

    // return money
    addmoney(500)
    message(MoneyReceived500)
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare
    delay(10)

    // message
    msgbox(AntiSoftlockEtherPurchaseUndone, MSGBOX_DEFAULT)
    waitmessage

    clearflag(FLAG_ETHER_BOUGHT)
}

script EscapeRoom_EventScript_SetTrainer5Rematch{
    msgbox(AntiSoftlockTrainer5Undone, MSGBOX_DEFAULT)
    waitmessage

    // take all money (player has 0 money at start of battle)
    removemoney(99999)

    // return items
    if(flag(FLAG_DUSK_STONE_CONSUMED)){
        clearflag(FLAG_DUSK_STONE_CONSUMED)
        giveitem(ITEM_DUSK_STONE)
    }
    if(flag(FLAG_SAFETY_GOGGLES_CONSUMED)){
        clearflag(FLAG_SAFETY_GOGGLES_CONSUMED)
        giveitem(ITEM_SAFETY_GOGGLES)
    }
    if(flag(FLAG_BERRY_JUICE_CONSUMED)){
        clearflag(FLAG_BERRY_JUICE_CONSUMED)
        giveitem(ITEM_BERRY_JUICE)
    }
    // Jaboca can also be stored via the central lost item method
    isitemlost(ITEM_JABOCA_BERRY)
    if(flag(FLAG_JABOCA_CONSUMED) || var(VAR_RESULT) == TRUE){
        clearflag(FLAG_JABOCA_CONSUMED)
        giveitem(ITEM_JABOCA_BERRY)
        removelostitem(ITEM_JABOCA_BERRY)
    }

    // reset trainer flag
    cleartrainerflag(TRAINER_CUSTOM_TRAINER5)
    clearflag(FLAG_TRAINER5_DEFEATED)
}

script EscapeRoom_EventScript_UndoFerroTrade{
    removemon(SPECIES_DUNSPARCE)
    restoremonfrompc(SPECIES_FERROTHORN)

    // message
    message(PlayerObtainedFerrothornMessage)
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare

    // allow trade again
    clearflag(FLAG_FERRO_TRADE_ACCEPTED)
}

script EscapeRoom_EventScript_UndoFlorgesTrade{
    removemon(SPECIES_AIPOM)
    removemon(SPECIES_EGG)
    restoremonfrompc(SPECIES_FLORGES)

    // message
    message(PlayerObtainedFlorgesMessage)
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare

    // allow trade again
    clearflag(FLAG_FLORGES_TRADE_ACCEPTED)
}


// LIEPARD

script EscapeRoom_EventScript_LiepardNPC{
    lock
    faceplayer

    // play sound
    playmoncry(SPECIES_LIEPARD, CRY_MODE_NORMAL)
    msgbox(LiepardNPCmainMessage, MSGBOX_AUTOCLOSE)
    waitmoncry
    waitmessage

    // if Liepard Collar obtained
    checkitem(ITEM_POWER_LENS)
    if(var(VAR_RESULT) == TRUE){

        lockall
        delay(5)
        msgbox(LiepardCollorFoundMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        lockall
        delay(20)

        // display exclamation mark
        playse(SE_PIN)
        applymovement(LOCALID_LIEPARD, Common_Movement_ExclamationMark)
        waitmovement(LOCALID_LIEPARD)
        lockall
        delay(20)

        // move Liepard around
        applymovement(LOCALID_LIEPARD, LiepardMovement1)
        waitmovement(LOCALID_LIEPARD)
        applymovement(LOCALID_LIEPARD, LiepardMovement2)
        waitmovement(LOCALID_LIEPARD)
        delay(20)

        playmoncry(SPECIES_LIEPARD, CRY_MODE_NORMAL)
        applymovement(LOCALID_LIEPARD, LiepardMovement3)
        waitmovement(LOCALID_LIEPARD)
        delay(2)
        applymovement(LOCALID_LIEPARD, LiepardMovement4)
        waitmovement(LOCALID_LIEPARD)
        delay(2)
        applymovement(LOCALID_LIEPARD, LiepardMovement5)
        waitmovement(LOCALID_LIEPARD)
        delay(2)
        applymovement(LOCALID_LIEPARD, LiepardMovement6)
        waitmovement(LOCALID_LIEPARD)
        delay(50)
        lockall

        // remove Liepard
	    fadescreen(FADE_TO_BLACK)
        setflag(FLAG_HIDE_LIEPARD_NPC)
        removeobject(LOCALID_LIEPARD)
        fadescreen(FADE_FROM_BLACK)

        // obtain liepard
        call(EscapeRoom_EventScript_ObtainLiepard)
        lockall
        removeitem(ITEM_POWER_LENS)
        setflag(FLAG_LIEPARD_OBTAINED)


        // ERROR CHECK
        // - 500 money
        // - trainer 1 defeated
        // - trainer 2 defeated
        // - trainer 3 defeated
        // - Aipom obtained
        // - escape rope used
        checkexactmoney(500)
        if(var(VAR_RESULT) == FALSE 
            || !flag(FLAG_TRAINER1_DEFEATED) 
            || !flag(FLAG_TRAINER2_DEFEATED) 
            || !flag(FLAG_TRAINER3_DEFEATED) 
            || !flag(FLAG_FLORGES_TRADE_ACCEPTED)
            || !flag(FLAG_RETURN_ESCAPE_ROPE))
        {
            msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
            waitmessage
        }


        // reset spawn and heal location
        delay(40)
        call(EscapeRoom_EventScript_RelocateNurseNPC)

        // re allow Custap Berry
        clearflag(FLAG_CUSTAP_SOLD_OUT)

        // prevent escape rope return via anti-softlock guy
        clearflag(FLAG_RETURN_ESCAPE_ROPE)
    }
    releaseall
    end
}

movement LiepardMovement1 {
    walk_fast_left * 2
}
movement LiepardMovement2 {
    walk_fast_right * 2
}
movement LiepardMovement3 {
    face_up
}
movement LiepardMovement4 {
    face_left
}
movement LiepardMovement5 {
    face_down
}
movement LiepardMovement6 {
    face_right
}

script EscapeRoom_EventScript_ObtainLiepard{
    lockall
    givemon(
        SPECIES_LIEPARD,
        40,
        abilityNum=2, // Prankster
        nature=17, // Quiet 
        gender=MON_FEMALE,
        move1=MOVE_ASSIST,
        move2=MOVE_TRICK,
        move3=MOVE_ROCK_SMASH,
        move4=MOVE_COPYCAT,
        // EVs:
        atkEv=252, 
        spAtkEv=252,
        speedEv=0,
        // IVs:
        hpIv=31,
        atkIv=31,
        defIv=31,
        speedIv=0,
        spAtkIv=31,
        spDefIv=31
    )    
    playfanfare(MUS_OBTAIN_ITEM)
    message(LiepardObtainMessage)
    waitfanfare
    waitmessage

	msgbox(NicknameThisPokemonMessage, MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        // getpartysize
        // subvar(VAR_RESULT, 1)
        // copyvar(VAR_0x8004, VAR_RESULT)

        call(Common_EventScript_NameReceivedPartyMon)
        // fadescreen(FADE_TO_BLACK)
        // special(ChangePokemonNickname)
        // waitstate
    }
    closemessage

}


// MOVING NURSE

script EscapeRoom_EventScript_RelocateNurseNPC{
    // player stops
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    delay(20)

    // move Nurse to player
    addobject(LOCALID_NURSE_DUMMY)
    applymovement(LOCALID_NURSE_DUMMY, EscapeRoom_Movement1_Nurse1NPC)
    waitmovement(LOCALID_NURSE_DUMMY)

    // dialogue and move player
    applymovement(OBJ_EVENT_ID_PLAYER, _face_right)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    msgbox(RunningNurseMessage, MSGBOX_NPC)
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER, EscapeRoom_Movement_PlayerMoveAway)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    // move nurse out of screen
    applymovement(LOCALID_NURSE_DUMMY, EscapeRoom_Movement2_Nurse1NPC)
    waitmovement(LOCALID_NURSE_DUMMY)
    delay(20)
    removeobject(LOCALID_NURSE_DUMMY)

    // remove nurse 1
    removeobject(LOCALID_NURSE1) 
    setflag(FLAG_HIDE_NURSE1_NPC)

    // change respawn
    setrespawn(HEAL_LOCATION_ESCAPE_ROOM_NURSE2)
    msgbox(RespawnChangeMessage, MSGBOX_AUTOCLOSE)
    waitmessage

    // allow trigger tiles to toggle spawn indicator
    setvar(VAR_RESPAWN_SET_AT_NURSE1, 0)
    setvar(VAR_RESPAWN_SET_AT_NURSE2, 1)
    setvar(VAR_RESPAWN_SET_AT_NURSE3, 0)
}

movement EscapeRoom_Movement1_Nurse1NPC{
    walk_fast_down
    walk_faster_left * 6
    walk_faster_up
    walk_faster_left
}
movement EscapeRoom_Movement_PlayerMoveAway{
    walk_up
    face_down
}
movement EscapeRoom_Movement2_Nurse1NPC{
    walk_faster_left * 9
}


