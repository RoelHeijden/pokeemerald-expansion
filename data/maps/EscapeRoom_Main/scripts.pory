//// POKEMON TRADES ////

script EscapeRoom_EventScript_TradeZeraForHMCut{
    lock
    msgbox(AskZeraCutTradeMessage, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){


        // check if Zera in party (sanity check)
        checkpartymon(SPECIES_ZERAORA)
        copyvar(VAR_0x8004, VAR_RESULT) // store monslot for bye-bye message
        if(var(VAR_RESULT) == PARTY_SIZE)
        {
            msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
            waitmessage
            releaseall
            end
        }

        // get Cut
        giveitem(ITEM_HM01)

        // bye bye message
        special(BufferMonNickname)
        msgbox(ByeByeMonDynamic, MSGBOX_AUTOCLOSE)
        waitmessage

        // remove pokemon
        setflag(FLAG_ZERA_TRADED)
        removemon(SPECIES_ZERAORA)
    }
    else{
        msgbox(ZeraCutTradeDeclined, MSGBOX_AUTOCLOSE)
    }
    releaseall
}

script EscapeRoom_EventScript_TradeFerroVsDunsparce{
    lock
    faceplayer

    // post trade 
    if(flag(FLAG_FERRO_TRADE_ACCEPTED) == TRUE){

        // allow retrade
        if(!flag(FLAG_TRAINER3_DEFEATED)){
            msgbox(FerroTradeAskRetrade, MSGBOX_YESNO)
            waitmessage
            if(var(VAR_RESULT) == YES){
                call(EscapeRoom_EventScript_UndoFerroTrade)

                msgbox(FerroTradeUndoAccepted, MSGBOX_AUTOCLOSE)
                waitmessage
            }
            else{
                msgbox(FerroTradeUndoDeclined, MSGBOX_AUTOCLOSE)
                waitmessage
            }
        }
        // final script
        else{
            msgbox(FerroTradePostTrade, MSGBOX_NPC)
            waitmessage
        }
    }
    else{
        // ask trade
        msgbox(AskFerroDunsparceTrade, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){

            // check if Ferrothorn in party (sanity check)
            checkpartymon(SPECIES_FERROTHORN)
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot for bye-bye message
            if(var(VAR_RESULT) == PARTY_SIZE)
            {
                msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
                waitmessage
                releaseall
                end
            }

            // make Ferrothorn backup in pc
            backupmontopc(SPECIES_FERROTHORN)

            // received message
            message(DunsparceReceivedMessage)
            playfanfare(MUS_OBTAIN_ITEM)
            waitfanfare

            lockall

            // bye bye message
            special(BufferMonNickname)
            msgbox(ByeByeMonDynamic, MSGBOX_AUTOCLOSE)
            waitmessage

            // actually trade pokemon
            removemon(SPECIES_FERROTHORN)
            givemon(
                SPECIES_DUNSPARCE,
                48,
                abilityNum=2, // rattled
                nature=8, // impish
                gender=1, // female
                move1=MOVE_TRUMP_CARD,
                move2=MOVE_HEX,
                move3=MOVE_ICE_BEAM,
                move4=MOVE_NONE,
                // EVs:
                hpEv=0, 
                defEv=252,
                speedEv=252,
                // IVs:
                hpIv=0,
                atkIv=0,
                defIv=31,
                speedIv=31,
                spAtkIv=0,
                spDefIv=31
            )
            setflag(FLAG_FERRO_TRADE_ACCEPTED)

        }
        // trade declined
        else{
            msgbox(FerroTradeDeclined, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    releaseall
    end
}

script EscapeRoom_EventScript_TradeFlorgesForEgg{
    lock
    faceplayer

    // post trade 
    if(flag(FLAG_FLORGES_TRADE_ACCEPTED) == TRUE){
        
        // ask undo trade
        if(!flag(FLAG_LIEPARD_OBTAINED)){
            msgbox(FlorgesTradeAskRetrade, MSGBOX_YESNO)
            waitmessage
            if(var(VAR_RESULT) == YES){
                call(EscapeRoom_EventScript_UndoFlorgesTrade)

                msgbox(FlorgesTradeUndoAccepted, MSGBOX_AUTOCLOSE)
                waitmessage
            }
            else{
                msgbox(FlorgesTradeUndoDeclined, MSGBOX_AUTOCLOSE)
                waitmessage
            }
        }
        // final script
        else{
            msgbox(FlorgesTradePostTrade, MSGBOX_NPC)
            waitmessage
        } 
    }
    else{
        // ask trade
        msgbox(AskFlorgesEggTrade, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){

            // check if pokemon in party
            checkpartymon(SPECIES_FLORGES)
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot for bye-bye message
            if(var(VAR_RESULT) == PARTY_SIZE)
            {
                msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
                waitmessage
                releaseall
                end
            }

            // make Florges backup in pc
            backupmontopc(SPECIES_FLORGES)

            // get egg message
            message(EggReceivedMessage)
            playfanfare(MUS_OBTAIN_ITEM)
            waitfanfare
            lockall

            // bye bye message
            special(BufferMonNickname)
            msgbox(ByeByeMonDynamic, MSGBOX_AUTOCLOSE)
            waitmessage

            // actually trade pokemon
            removemon(SPECIES_FLORGES)
            giveaipomegg
            setflag(FLAG_FLORGES_TRADE_ACCEPTED)
        }
        // trade declined
        else{
            msgbox(FlorgesTradeDeclined, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    releaseall
}

script EscapeRoom_EventScript_SellDunsparce{
    lock
    faceplayer

    // post trade 
    if(flag(FLAG_DUNSPARCE_TRADE_ACCEPTED) == TRUE){
        msgbox(DunsparceTradePostTrade, MSGBOX_DEFAULT)
        waitmessage
    }
    else{
        // ask trade
        msgbox(AskDunsparceMoneyTrade, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){

            // check if pokemon in party
            checkpartymon(SPECIES_DUNSPARCE)
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot for bye-bye message
            if(var(VAR_RESULT) == PARTY_SIZE)
            {
                msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
                waitmessage
                releaseall
                end
            }

            // message
            msgbox(AskDunsparceReturnAcceptedMessage, MSGBOX_DEFAULT)
            waitmessage
            giveitem(ITEM_TM12) // TM TAUNT

            // bye bye message
            special(BufferMonNickname)
            msgbox(ByeByeMonDynamic, MSGBOX_AUTOCLOSE)
            waitmessage

            // remove pokemon
            removemon(SPECIES_DUNSPARCE)
            setflag(FLAG_DUNSPARCE_TRADE_ACCEPTED)
        }
        // trade declined
        else{
            msgbox(DunsparceTradeDeclined, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    releaseall
}


//// CHOICE ITEM SCRIPT ////

script EscapeRoom_EventScript_GetChoiceItem{

    if(!flag(FLAG_TRAINER10_DEFEATED)){

        // ask which choice item
        msgbox(ChoiceItemsWhichOne, MSGBOX_DEFAULT)
        waitmessage

        // option menu
        dynmultichoice(30, 6, FALSE, 6, 0, 0, OptionChoiceBand, OptionChoiceSpecs, OptionChoiceScarf) 

        // decode options into VAR_0x8006
        if(var(VAR_RESULT) == 0){
            setvar(VAR_0x8006, ITEM_CHOICE_BAND)
        }
        elif(var(VAR_RESULT) == 1){
            setvar(VAR_0x8006, ITEM_CHOICE_SPECS)
        }
        elif(var(VAR_RESULT) == 2){
            setvar(VAR_0x8006, ITEM_CHOICE_SCARF)
        }
        else{
            msgbox(ChoiceItemsComeAgain, MSGBOX_DEFAULT)
            waitmessage        
            return
        }

        // end script if the player already owns the item
        call(EscapeRoom_EventScript_EndIfAlreadyHasChoiceItem)

        // remove any other choice item
        call(EscapeRoom_EventScript_RemoveChoiceItem)

        // give the new item
        giveitem(VAR_0x8006)

        // message
        if(flag(FLAG_CHOICE_ITEM_OBTAINED)){
            msgbox(ChoiceItemsSwapped, MSGBOX_DEFAULT)
            waitmessage  
        }
        else{
            setflag(FLAG_CHOICE_ITEM_OBTAINED)
        }
    }
    else{
        // ask which choice item
        msgbox(ChoiceItemsNoLongerAvailable, MSGBOX_DEFAULT)
        waitmessage
    }
}

script EscapeRoom_EventScript_EndIfAlreadyHasChoiceItem{
    clearflag(FLAG_TEMP_1)

    // bag check
    checkitem(VAR_0x8006)
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_TEMP_1)
    }
    // party checks
    checkpartyitem(0)
    if(var(VAR_RESULT) == TRUE){
        compare_var_to_var(VAR_0x8005, VAR_0x8006)
        goto_if_ne(NotEqual1)
        setflag(FLAG_TEMP_1)

        NotEqual1:
    }
    checkpartyitem(1)
    if(var(VAR_RESULT) == TRUE){
        compare_var_to_var(VAR_0x8005, VAR_0x8006)
        goto_if_ne(NotEqual2)
        setflag(FLAG_TEMP_1)

        NotEqual2:
    }

    // player already has the item: END
    if(flag(FLAG_TEMP_1)){
        msgbox(ChoiceItemsAlreadyHaveThis, MSGBOX_DEFAULT)
        waitmessage
        releaseall
        end
    }
}

script EscapeRoom_EventScript_RemoveChoiceItem{
    removeitem(ITEM_CHOICE_BAND)
    removeitem(ITEM_CHOICE_SPECS)
    removeitem(ITEM_CHOICE_SCARF)

    checkpartyitem(0)
    if(var(VAR_RESULT) == TRUE && 
      (var(VAR_0x8005) == ITEM_CHOICE_BAND || 
       var(VAR_0x8005) == ITEM_CHOICE_SPECS ||
       var(VAR_0x8005) == ITEM_CHOICE_SCARF)){
        removepartyitem(0)
    }

    checkpartyitem(1)
    if(var(VAR_RESULT) == TRUE && 
      (var(VAR_0x8005) == ITEM_CHOICE_BAND || 
       var(VAR_0x8005) == ITEM_CHOICE_SPECS ||
       var(VAR_0x8005) == ITEM_CHOICE_SCARF)){
        removepartyitem(1)
    }
}


