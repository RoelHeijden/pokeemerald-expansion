//// MAP SWITCHES ////

script EscapeRoom_EventScript_MapSwitch1{
    lockall

    // end if already solved
    if(flag(FLAG_MAP_SWITCHES_SOLVED) == TRUE){
        msgbox(MApSwitchesAlreadySolved, MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
        end
    }

    // main message
    msgbox(MapSwitchTablet1_Onix, MSGBOX_DEFAULT)

    // ask to change tablet direction
    if(var(VAR_MAP_SWITCH_1) == 0){
        msgbox(MapSwitchPointedNorth, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_1) == 1){
        msgbox(MapSwitchPointedEast, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_1) == 2){
        msgbox(MapSwitchPointedSouth, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_1) == 3){
        msgbox(MapSwitchPointedWest, MSGBOX_YESNO)
    }

    // change direction
    if(var(VAR_RESULT) == YES){
        playse(SE_CLICK)
        addvar(VAR_MAP_SWITCH_1, 1)
        msgbox(RotatedSwitchSoundMessage, MSGBOX_AUTOCLOSE)
        waitmessage

        // full circle: back to north
        if(var(VAR_MAP_SWITCH_1) >= 4){
            setvar(VAR_MAP_SWITCH_1, 0)
        }

        // check for correct solution
        call(EscapeRoom_EventScript_CheckSwitchesCorrect)
    }

    releaseall
}

