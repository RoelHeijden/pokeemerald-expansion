        species=SPECIES_ANNIHILAPE,
        level=100,
        nature=22,
        abilityNum=2,
        gender=1,
        hpEv=184,
        defEv=72,
        spAtkEv=252,
        move1=MOVE_MIMIC
    )
    dowildbattle
    releaseall
}

script EscapeRoom_EventScript_GraveStone1{
    lockall
    msgbox(GravestoneNoneMessage, MSGBOX_AUTOCLOSE)
    waitmessage

    // end if final check was reached
    if(flag(FLAG_GRAVESTONE_CHECK4) == TRUE){
        end
    }

    msgbox(GravestoneClickMessage, MSGBOX_AUTOCLOSE)
    waitmessage
    // clear flags
    clearflag(FLAG_GRAVESTONE_CHECK2)
    clearflag(FLAG_GRAVESTONE_CHECK3)
    // set first flag
    setflag(FLAG_GRAVESTONE_CHECK1)

    releaseall
}

