script EscapeRoom_Nurse_Heal_Pokemon{
    lockall
    faceplayer
    msgbox(Nurse_Ask_heal, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        special(HealPlayerParty)
        playse(SE_USE_ITEM)
        waitse
        msgbox(Nurse_Heal_End, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
}

