script EscapeRoom_MapScript_GameStartScripts{
    call(EscapeRoom_MapScript_GetPokedex)
    call(EscapeRoom_MapScripts_GetFirstPokemon)
    call(EscapeRoom_MapScripts_GetBadges)
    call(EscapeRoom_MapScripts_SetRespawn)
    call(EscapeRoom_MapScripts_GetItems)
    call(EscapeRoom_MapScripts_TurnOfBagUse)
    setflag(FLAG_HIDE_ANNIHILAPE)
    setflag(FLAG_HIDE_ROCKSMASH_TUNNEL_NPC)
    setobjectmovementtype(LOCALID_APE_HINT_NPC, MOVEMENT_TYPE_FACE_UP)
    removeobject(LOCALID_NURSE_DUMMY)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 1)
    setvar(VAR_MOVE_DELETE_MONSLOT_BACKUP, 6)  // PARTY_SIZE
    setvar(VAR_MOVE_DELETER_CHOSEN_SLOT, 4)    // MAX_MON_MOVES
}

script EscapeRoom_MapScript_GetPokedex{
    setflag(FLAG_SYS_POKEDEX_GET)
	special(SetUnlockedPokedexFlags)
    setflag(FLAG_RECEIVED_POKEDEX_FROM_BIRCH)
    special(EnableNationalPokedex)
    setflag(FLAG_SYS_NATIONAL_DEX)
}

