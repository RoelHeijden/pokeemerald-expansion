// RESPAWN CHANGES //

script EscapeRoom_EventScript_WarpToPreviousLocation{
    // warp player to previous section 
    if(var(VAR_LOCATED_AT_SECTION_X) == 1){
        call(EscapeRoom_EventScript_WarpToSection1)
    }
    elif(var(VAR_LOCATED_AT_SECTION_X) == 2){
        call(EscapeRoom_EventScript_WarpToSection2)
    }
    elif(var(VAR_LOCATED_AT_SECTION_X) == 3){
        call(EscapeRoom_EventScript_WarpToSection3)
    }
}

script EscapeRoom_EventScript_SetLocationToSpawn{
    // set location tracker section to spawn location
    if(var(VAR_RESPAWN_AT_SECTION_X) == 1){
        call(EscapeRoom_EventScript_SetLocationSection1)
    }
    elif(var(VAR_RESPAWN_AT_SECTION_X) == 2){
        call(EscapeRoom_EventScript_SetLocationSection2)
    }
    elif(var(VAR_RESPAWN_AT_SECTION_X) == 3){
        call(EscapeRoom_EventScript_SetLocationSection3)
    }
}


// locations
script EscapeRoom_EventScript_SetLocationSection1{
    setvar(VAR_LOCATED_AT_SECTION_X, 1)
}

script EscapeRoom_EventScript_SetLocationSection2{
    setvar(VAR_LOCATED_AT_SECTION_X, 2)
}

script EscapeRoom_EventScript_SetLocationSection3{
    setvar(VAR_LOCATED_AT_SECTION_X, 3)

    // first time entering section 3
    if(!flag(FLAG_SECTION_3_SPAWN_UNLOCKED)){
        setflag(FLAG_SECTION_3_SPAWN_UNLOCKED)
    }
}

// respawns
script EscapeRoom_EventScript_SetRespawnSection1{
    setvar(VAR_RESPAWN_AT_SECTION_X, 1)
    setrespawn(HEAL_LOCATION_ESCAPE_ROOM_NURSE1)
}

script EscapeRoom_EventScript_SetRespawnSection2{
    setvar(VAR_RESPAWN_AT_SECTION_X, 2)
    setrespawn(HEAL_LOCATION_ESCAPE_ROOM_NURSE2)
}

script EscapeRoom_EventScript_SetRespawnSection3{
    setvar(VAR_RESPAWN_AT_SECTION_X, 3)
    setrespawn(HEAL_LOCATION_ESCAPE_ROOM_NURSE3)
}

// warps
script EscapeRoom_EventScript_WarpToSection1{
        call(EscapeRoom_EventScript_SetLocationSection1)
        warpteleport(MAP_ESCAPE_ROOM_MAIN, 48, 17)
        waitstate
}

script EscapeRoom_EventScript_WarpToSection2{
        call(EscapeRoom_EventScript_SetLocationSection2)
        warpteleport(MAP_ESCAPE_ROOM_MAIN, 20, 11)
        waitstate
}

script EscapeRoom_EventScript_WarpToSection3{
        call(EscapeRoom_EventScript_SetLocationSection3)
        warpteleport(MAP_ESCAPE_ROOM_HIDDEN_DUNGEON, 10, 8)
        waitstate
}


//// SIGNS //// 

// main sign
script EscapeRoom_EventScript_MainInfoSign {
    lockall
    msgbox(MainSignWhatToRead, MSGBOX_MAIN_SIGN)

    // check game completion
    if(var(VAR_RESULT) == 0){    
        if(!flag(FLAG_ANNIHILAPE_SPAWNED)){
            msgbox(GameCompletionMessageInitial, MSGBOX_DEFAULT)
        }
        elif(flag(FLAG_TRAINER11_DEFEATED)){
            msgbox(GameCompletionMessageFinal, MSGBOX_DEFAULT)
        }
        // default case
        else{
            call(EscapeRoom_EventScript_GetGameCompletion)
            msgbox(GameCompletionMessage, MSGBOX_DEFAULT)
        }
    }
    // check important info
    elif(var(VAR_RESULT) == 1)
    {
        msgbox(SignMessage1_part1, MSGBOX_YESNO) // "keep reading?"
        if(var(VAR_RESULT) == YES)
        {
            msgbox(SignMessage1_part2, MSGBOX_DEFAULT)
            waitmessage
        }
    }

    releaseall
}

script EscapeRoom_EventScript_GetGameCompletion{
    buffernumberstring(STR_VAR_1, 0)

    //// SECTION 1 ////

    // ape spawned
    if(flag(FLAG_ANNIHILAPE_SPAWNED)){
        buffernumberstring(STR_VAR_1, 2)
    }

    // zera caught
    if(flag(FLAG_ZERAORA_CAUGHT)){
        buffernumberstring(STR_VAR_1, 8)
    }

    // trainer 0
    if(flag(FLAG_TRAINER0_DEFEATED)){
        buffernumberstring(STR_VAR_1, 12)
    }

    // trainer 1
    if(flag(FLAG_TRAINER1_DEFEATED)){
        buffernumberstring(STR_VAR_1, 18)
    }

    // maranga berry
    if(flag(FLAG_MARANGA_BERRY_OBTAINED)){
        buffernumberstring(STR_VAR_1, 20)
    }

    // trainer 2
    if(flag(FLAG_TRAINER2_DEFEATED)){
        buffernumberstring(STR_VAR_1, 23)
    }

    // trainer 3
    if(flag(FLAG_TRAINER3_DEFEATED)){
        buffernumberstring(STR_VAR_1, 28)
    }

    // liepard obtained (egg puzzle)
    if(flag(FLAG_LIEPARD_OBTAINED)){
        buffernumberstring(STR_VAR_1, 33)
    }


    //// SECTION 2 ////

    // sun stone sold (pickup)
    if(flag(FLAG_SUN_STONE_SOLD)){
        buffernumberstring(STR_VAR_1, 35)
    }

    // trainer 4
    if(flag(FLAG_TRAINER4_DEFEATED)){
        buffernumberstring(STR_VAR_1, 41)
    }

    // rock smashed
    if(flag(FLAG_ROCK_SMASH_GUY_MOVED)){
        buffernumberstring(STR_VAR_1, 44)
    }

    // moon stone obtained
    if(flag(FLAG_SPACE_ITEM_STOLEN)){
        buffernumberstring(STR_VAR_1, 46)
    }

    // berry juice obtained
    if(flag(FLAG_BERRY_JUICE_OBTAINED)){
        buffernumberstring(STR_VAR_1, 49)
    }

    // ability capsule obtained (trainer 5 solved)
    if(flag(FLAG_ABILITY_CAPSULE_BOUGHT)){
        buffernumberstring(STR_VAR_1, 55)
    }

    // trapinch run
    if(flag(FLAG_RAN_FROM_TRAPINCH)){
        buffernumberstring(STR_VAR_1, 57)
    }

    // trainer 6
    if(flag(FLAG_TRAINER6_DEFEATED)){
        buffernumberstring(STR_VAR_1, 63)
    }

    // map switches
    if(flag(FLAG_MAP_SWITCHES_SOLVED)){
        buffernumberstring(STR_VAR_1, 68)
    }


    //// SECTION 3 ////

    // trainer 7a
    if(flag(FLAG_TRAINER7A_DEFEATED)){
        buffernumberstring(STR_VAR_1, 73)
    }

    // trainer 8
    if(flag(FLAG_TRAINER8_DEFEATED)){
        buffernumberstring(STR_VAR_1, 78)
    }

    // trainer 9
    if(flag(FLAG_TRAINER9_DEFEATED)){
        buffernumberstring(STR_VAR_1, 84)
    }  

    // secret power obtained
    if(flag(FLAG_SECRET_POWER_COMPLETED)){
        buffernumberstring(STR_VAR_1, 89)
    }  

    // secret base rare candy
    if(flag(FLAG_RARE_CANDY3_OBTAINED)){
        buffernumberstring(STR_VAR_1, 91)
    }  

    // trainer 10  
    if(flag(FLAG_TRAINER10_DEFEATED)){
        buffernumberstring(STR_VAR_1, 95)
    }

    // trainer 11  
    if(flag(FLAG_TRAINER11_DEFEATED)){
        buffernumberstring(STR_VAR_1, 100)
    }
}


// move deleter sign
script EscapeRoom_EventScript_MoveDeleterSign {
    lockall
    msgbox(MoveDeleterSignMessage, MSGBOX_DEFAULT)
    waitmessage
    releaseall
}


// end sign
script EscapeRoom_EventScript_EndSign{
    lockall
    if(!flag(FLAG_END_ESCAPE_ROOM)){
        setflag(FLAG_END_ESCAPE_ROOM)
        setvar(VAR_END_ESCAPE_ROOM_STATE, 2)
        playfanfare(MUS_OBTAIN_BADGE)
        msgbox(EscapeRoomEndCongratz)
        waitfanfare
    }
    // else{
    //     msgbox(EscapeRoomEndCongratz)
    //     waitmessage
    // }

    // calculates hints and solutions used based on:
    // - VAR_SMALL_HINTS_USED_COUNTER
    // - VAR_LARGE_HINTS_USED_COUNTER
    // - VAR_SOLUTIONS_USED_COUNTER
    // also freezes the final playtime
    bufferplaytimeandhints

    msgbox(EndEscapeRoomSignMessage)
    waitmessage
    releaseall
}


