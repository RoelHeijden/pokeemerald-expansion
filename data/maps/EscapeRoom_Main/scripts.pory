script EscapeRoom_EventScript_AnnihilapeBattle{
    lockall

    // backup party state
    backupplayerparty

    // allow items (wild battle)
    if(flag(FLAG_TOGGLE_BAG_USE) == TRUE){
        clearflag(FLAG_TOGGLE_BAG_USE)
    }

    // set annihilape battle
    createmon(
        side=1,
        slot=0,
        species=SPECIES_ANNIHILAPE,
        // item=ITEM_SILK_SCARF,
        level=100,
        nature=17, // Quiet
        abilityNum=2,
        gender=MON_FEMALE,
        move1=MOVE_MIMIC
        // evs
        hpEv=12,
        defEv=0,
        spAtkEv=252, 
        spDefEv=244,
        // ivs
        hpIv=31,
        atkIv=31,
        defIv=31,
        speedIv=31,
        spAtkIv=31,
        spDefIv=31
    )
    dowildbattle
    releaseall
}

script EscapeRoom_EventScript_GraveStone1{
