text AskFlorgesEggTrade{
    "That's a nice Florges.\p"
    "Do you want to trade it for a mystery\n"
    "egg?"
}

text EggReceivedMessage{
    "{PLAYER} received an EGG!" 
}

text FlorgesTradeAccepted{
    "Bye-bye Florges."
}

text FlorgesTradeDeclined{
    "Okay, come back anytime."
}

text FlorgesTradePostTrade{
    "Do I sense regret?"
}


// TRADE NPC 4 - Dunsparce Money
text AskDunsparceMoneyTrade{
    "Dunsparce and I were playing near the\n"
    "water when she went missing.\p"
    "Have you seen my Dunsparce?"
}

text AskDunsparceReturnAcceptedMessage{
    "Omg you found her!!\p"
    "Thank you so much!\n"
    "Here, have this."
}

text DunsparceTradeDeclined{
    "Hmm..."
}

text DunsparceTradePostTrade{
    "It's so good to be back together!"
}


