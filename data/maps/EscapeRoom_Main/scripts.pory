script EscapeRoom_EventScript_FindPrimeape{
    lockall

    // // ask pickup item
    // msgbox(PrimeapePokeballMessage, MSGBOX_YESNO)
    // if(var(VAR_RESULT) != YES){
    //     releaseall
    //     end
    // }

    // obtain primeape
    givemon(
        SPECIES_PRIMEAPE,
        44,
        ball=ITEM_TIMER_BALL,
        item=ITEM_RARE_CANDY,
        abilityNum=2, // Defiant
        nature=15, // Modest 
        gender=MON_FEMALE,
        move1=MOVE_TAUNT,
        move2=MOVE_RAGE_FIST,
        move3=MOVE_COUNTER,
        move4=MOVE_NONE,
        // EVs:
        atkEv=0, 
        spAtkEv=0,
        speedEv=0,
        // IVs:
        hpIv=31,
        atkIv=31,
        defIv=31,
        speedIv=31, // outspeed dusknoir
        spAtkIv=31,
        spDefIv=31
    )   

    // remove item
    removeobject(LOCALID_PRIMEAPE_BALL)
    setflag(FLAG_PRIMEAPE_OBTAINED)

    // set rare candy flag
    setflag(FLAG_RARE_CANDY2_OBTAINED)

    // primeape obtained message
    playfanfare(MUS_OBTAIN_ITEM)
    message(PrimeapeObtainMessage)
    waitfanfare
    waitmessage

    // nickname
	msgbox(NicknameThisPokemonMessage2, MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
    closemessage
    releaseall
}


//// MAP SWITCHES ////

script EscapeRoom_EventScript_MapSwitch1{
    lockall

    // end if already solved
    if(flag(FLAG_MAP_SWITCHES_SOLVED) == TRUE){
        msgbox(MApSwitchesAlreadySolved, MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
        end
    }

    // ask to change tablet direction
    if(var(VAR_MAP_SWITCH_1) == 0){
        msgbox(MapSwitchPointedNorthTablet1, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_1) == 1){
        msgbox(MapSwitchPointedEastTablet1, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_1) == 2){
        msgbox(MapSwitchPointedSouthTablet1, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_1) == 3){
        msgbox(MapSwitchPointedWestTablet1, MSGBOX_YESNO)
    }

    // change direction
    if(var(VAR_RESULT) == YES){
        playse(SE_CLICK)
        addvar(VAR_MAP_SWITCH_1, 1)
        msgbox(RotatedSwitchSoundMessage, MSGBOX_AUTOCLOSE)
        waitmessage

        // full circle: back to north
        if(var(VAR_MAP_SWITCH_1) >= 4){
            setvar(VAR_MAP_SWITCH_1, 0)
        }

        // check for correct solution
        call(EscapeRoom_EventScript_CheckSwitchesCorrect)
    }

    releaseall
}

