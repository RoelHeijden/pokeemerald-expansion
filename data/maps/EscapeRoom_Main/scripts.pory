script EscapeRoom_EtherSellNPC{
    lock
    faceplayer
    if(flag(FLAG_ETHER_BOUGHT) == FALSE){

        // ask buy Ether
        msgbox(EtherNPCbuyEther, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){

            // check enough money
            checkmoney(500)
            if(var(VAR_RESULT) == FALSE){
                // not enough money message
                msgbox(EtherNPCnotEnoughMoney, MSGBOX_AUTOCLOSE)
                waitmessage
                releaseall
                end
            }

            removemoney(500)

            // give Ether
            giveitem(ITEM_ETHER)

            // final message
            msgbox(EtherNPCsellAcceptedMessage, MSGBOX_AUTOCLOSE)
            waitmessage

            setflag(FLAG_ETHER_BOUGHT)
        }
        else{
            // sell declined message
            msgbox(EtherNPCsellDeclined, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    else{
        msgbox(EtherNPCpostSellMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
}


