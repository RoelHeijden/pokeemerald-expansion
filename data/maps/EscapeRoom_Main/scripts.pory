script EscapeRoom_EventScript_Trainer1{
    faceplayer
    trainerbattle_double(
        TRAINER_CUSTOM_TRAINER1, 
        Trainer1_Intro, 
        Trainer1_Outro, 
        DoubleBattle_NotEnoughMons,
        event_script=EscapeRoom_EventScript_Trainer1PostBattle,
    )

    // ask zera trade if previously declined
    if(flag(FLAG_ZERA_TRADED) == FALSE){
        call(EscapeRoom_EventScript_TradeZeraForHMCut)
    }
    else{
        msgbox(Trainer1_PostBattle, MSGBOX_AUTOCLOSE)
        waitmessage
    }
}

