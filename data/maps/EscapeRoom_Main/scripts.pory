//// POST BATTLE SCRIPTS ////

script EscapeRoom_EventScript_PostMatchHeal{
    special(HealPlayerParty)
}

script EscapeRoom_EventScript_Trainer0PostBattle{
    // prevent recovered item message
    clearflag(FLAG_DO_RECOVERED_ITEM_MESSAGE)

    // dont restore Electric Seed if consumed in battle
    if(flag(FLAG_ELECTRIC_SEED_CONSUMED) == TRUE){
        checkpartyitem(0)
        if(var(VAR_0x8005) == ITEM_ELECTRIC_SEED){
            removepartyitem(0)
        }
        checkpartyitem(1)
        if(var(VAR_0x8005) == ITEM_ELECTRIC_SEED){
            removepartyitem(1)
        }
        checkpartyitem(2)
        if(var(VAR_0x8005) == ITEM_ELECTRIC_SEED){
            removepartyitem(2)
        }
    }

    setflag(FLAG_TRAINER0_DEFEATED)
    call(EscapeRoom_EventScript_PostMatchHeal)
}

script EscapeRoom_EventScript_Trainer1PostBattle{
    // prevent recovered item message
    clearflag(FLAG_DO_RECOVERED_ITEM_MESSAGE)

    // prevent electric seed restore after winning
    checkpartymon(SPECIES_ZERAORA)
    copyvar(VAR_TEMP_0, VAR_RESULT) // copy mon slot
    if(var(VAR_TEMP_0) != PARTY_SIZE){
        checkpartyitem(VAR_TEMP_0) // sets item in VAR_0x8005
        if(var(VAR_0x8005) == ITEM_ELECTRIC_SEED){
            removepartyitem(VAR_TEMP_0)
            setflag(FLAG_ELECTRIC_SEED_USED)
        }
    }

    setflag(FLAG_TRAINER1_DEFEATED)

    // remove Florges Skill Swap undo
    removetaughtmove(SPECIES_FLORGES, MOVE_SKILL_SWAP)

    // ERROR CHECK
    // - 1500 money
    // - safety goggles kept
    // - electric seed used
    checkpartyitem(0)
    copyvar(VAR_0x8006, VAR_0x8005)
    checkpartyitem(1)
    copyvar(VAR_0x8007, VAR_0x8005)
    checkpartyitem(2)
    copyvar(VAR_0x8008, VAR_0x8005)
    checkexactmoney(1500)
    if(var(VAR_RESULT) == FALSE 
        || !(var(VAR_0x8006) == ITEM_SAFETY_GOGGLES || var(VAR_0x8007) == ITEM_SAFETY_GOGGLES || var(VAR_0x8008) == ITEM_SAFETY_GOGGLES)
        || !flag(FLAG_ELECTRIC_SEED_USED))
    {
        lockall
        msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }


    // heal and ask Zera trade
    call(EscapeRoom_EventScript_PostMatchHeal)
    call(EscapeRoom_EventScript_TradeZeraForHMCut)

    releaseall
    end

}

script EscapeRoom_EventScript_Trainer2PostBattle{
    // prevent recovered item message
    clearflag(FLAG_DO_RECOVERED_ITEM_MESSAGE)

    // prevent maranga restore after winning
    checkpartymon(SPECIES_FLORGES)
    copyvar(VAR_TEMP_0, VAR_RESULT) // copy mon slot
    if(var(VAR_TEMP_0) != PARTY_SIZE){
        checkpartyitem(VAR_TEMP_0) // sets item in VAR_0x8005
        if(var(VAR_0x8005) == ITEM_MARANGA_BERRY){
            removepartyitem(VAR_TEMP_0)
            setflag(FLAG_MARANGA_BERRY_USED)
        }
    }
    setflag(FLAG_TRAINER2_DEFEATED)
    call(EscapeRoom_EventScript_PostMatchHeal)

    // remove Ferrothorn Cut undo
    removetaughtmove(SPECIES_FERROTHORN, MOVE_CUT)

    // ERROR CHECK
    // - 2000 money
    // - trainer 1 defeated
    // - maranga used
    // - Zera obtained
    checkexactmoney(2000)
    if(var(VAR_RESULT) == FALSE 
        || !flag(FLAG_TRAINER1_DEFEATED) 
        || !flag(FLAG_MARANGA_BERRY_USED)
        || !flag(FLAG_ZERAORA_CAUGHT))
    {
        lockall
        msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
    end
}

script EscapeRoom_EventScript_Trainer3PostBattle{
    // prevent recovered item message
    clearflag(FLAG_DO_RECOVERED_ITEM_MESSAGE)

    // prevent ring target being restored via anti softlock guy
    removelostitem(ITEM_RING_TARGET)

    // keep Ring Target as held item
    checkpartymon(SPECIES_FLORGES)
    if(var(VAR_RESULT) == 0){
        givepartyitem(ITEM_RING_TARGET, 0)
    }
    elif(var(VAR_RESULT) == 1){
        givepartyitem(ITEM_RING_TARGET, 1)
    }

    // move away from door
    lockall
    msgbox(Trainer3FinalWords, MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_TRAINER3, EscapeRoom_Movement_Trainer3End)
    waitmovement(LOCALID_TRAINER3)
    copyobjectxytoperm(LOCALID_TRAINER3)

    // set flag to keep it moved away
    setflag(FLAG_TRAINER3_DEFEATED)

    // set custap sold out (until Liepard obtained)
    setflag(FLAG_CUSTAP_SOLD_OUT)

    // heal 
    call(EscapeRoom_EventScript_PostMatchHeal)

    // ERROR CHECK
    // - 500 money
    // - trainer 1 defeated
    // - trainer 2 defeated
    // - Ferro obtained
    checkexactmoney(500)
    if(var(VAR_RESULT) == FALSE 
        || !flag(FLAG_TRAINER1_DEFEATED) 
        || !flag(FLAG_TRAINER2_DEFEATED) 
        || !flag(FLAG_FERRO_TRADE_ACCEPTED))
    {
        lockall
        msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
    end
}

movement EscapeRoom_Movement_Trainer3End{
    face_right
    walk_right * 2
    face_left
}

script EscapeRoom_EventScript_Trainer4PostBattle{
    setflag(FLAG_TRAINER4_DEFEATED)
    call(EscapeRoom_EventScript_PostMatchHeal)

    // ERROR CHECK
    // - 500 or 2000 money
    // - Thief taught to Dunsparce
    checkexactmoney(500)
    copyvar(VAR_TEMP_4, VAR_RESULT)
    checkexactmoney(2000)
    copyvar(VAR_TEMP_5, VAR_RESULT)
    istaughtmovepresent(SPECIES_DUNSPARCE, MOVE_THIEF)
    if(var(VAR_RESULT) == FALSE ||
       (var(VAR_TEMP_4) == FALSE && var(VAR_TEMP_5) == FALSE))
    {
        lockall
        msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
    
    // remove Dunsparce Thief undo
    removetaughtmove(SPECIES_DUNSPARCE, MOVE_THIEF)
}

script EscapeRoom_EventScript_Trainer5PostBattle{
    // prevent recovered item message
    clearflag(FLAG_DO_RECOVERED_ITEM_MESSAGE)

    // dont restore Berry Juice if consumed (or tricked to opp) in battle
    if(flag(FLAG_BERRY_JUICE_CONSUMED) == TRUE){
        checkpartyitem(0)
        if(var(VAR_0x8005) == ITEM_BERRY_JUICE){
            removepartyitem(0)
        }
        checkpartyitem(1)
        if(var(VAR_0x8005) == ITEM_BERRY_JUICE){
            removepartyitem(1)
        }
    }

    // dont restore moon stone if consumed (flung) in battle
    if(flag(FLAG_MOON_STONE_CONSUMED) == TRUE){
        checkpartyitem(0)
        if(var(VAR_0x8005) == ITEM_MOON_STONE){
            removepartyitem(0)
        }
        checkpartyitem(1)
        if(var(VAR_0x8005) == ITEM_MOON_STONE){
            removepartyitem(1)
        }
    }

    // dont restore jaboca berry if consumed (flung) in battle
    if(flag(FLAG_JABOCA_CONSUMED) == TRUE){
        checkpartyitem(0)
        if(var(VAR_0x8005) == ITEM_JABOCA_BERRY){
            removepartyitem(0)
        }
        checkpartyitem(1)
        if(var(VAR_0x8005) == ITEM_JABOCA_BERRY){
            removepartyitem(1)
        }
    }

    // dont restore safety googles if consumed (flung) in battle
    if(flag(FLAG_SAFETY_GOGGLES_CONSUMED) == TRUE){
        checkpartyitem(0)
        if(var(VAR_0x8005) == ITEM_SAFETY_GOGGLES){
            removepartyitem(0)
        }
        checkpartyitem(1)
        if(var(VAR_0x8005) == ITEM_SAFETY_GOGGLES){
            removepartyitem(1)
        }
    }

    // dont restore tm trick if consumed (flung) in battle
    if(flag(FLAG_TM_TRICK_CONSUMED) == TRUE){
        checkpartyitem(0)
        if(var(VAR_0x8005) == ITEM_TM38){
            removepartyitem(0)
        }
        checkpartyitem(1)
        if(var(VAR_0x8005) == ITEM_TM38){
            removepartyitem(1)
        }
    }

    setflag(FLAG_TRAINER5_DEFEATED)
    call(EscapeRoom_EventScript_PostMatchHeal)
}

script EscapeRoom_EventScript_Trainer6PostBattle{
    // prevent recovered item message
    clearflag(FLAG_DO_RECOVERED_ITEM_MESSAGE)

    // remove item from lostItems?
    removelostitem(ITEM_CUSTAP_BERRY)

    // prevent custap restore after winning
    checkpartymon(SPECIES_AIPOM)
    copyvar(VAR_TEMP_0, VAR_RESULT) // copy mon slot
    if(var(VAR_TEMP_0) != PARTY_SIZE){
        checkpartyitem(VAR_TEMP_0) // sets item in VAR_0x8005
        if(var(VAR_0x8005) == ITEM_CUSTAP_BERRY){
            removepartyitem(VAR_TEMP_0)
        }
    }

    // prevent safety goggles restore after winning
    checkpartymon(SPECIES_LIEPARD)
    copyvar(VAR_TEMP_0, VAR_RESULT) // copy mon slot
    if(var(VAR_TEMP_0) != PARTY_SIZE){
        checkpartyitem(VAR_TEMP_0) // sets item in VAR_0x8005
        if(var(VAR_0x8005) == ITEM_SAFETY_GOGGLES){
            removepartyitem(VAR_TEMP_0)
            clearflag(FLAG_SAFETY_GOGGLES_CONSUMED)
        }
    }

    setflag(FLAG_TRAINER6_DEFEATED)
    // clearflag(FLAG_MENTAL_HERB_SOLD_OUT)
    call(EscapeRoom_EventScript_PostMatchHeal)

    // remove rare candy1 undo (for Liepard)
    setvar(VAR_RARE_CANDY_1_USED_ON, SPECIES_NONE)

    // ERROR CHECK
    // - 500 money
    // - trainer 4 & 5 defeated
    // - no held item (custap and goggles used)
    // - no bag items
    checkpartyitem(0)
    copyvar(VAR_0x8006, VAR_0x8005)
    checkpartyitem(1)
    copyvar(VAR_0x8007, VAR_0x8005)

    checkitem(ITEM_SAFETY_GOGGLES)
    copyvar(VAR_TEMP_0, VAR_RESULT)
    checkitem(ITEM_CUSTAP_BERRY)
    copyvar(VAR_TEMP_1, VAR_RESULT)

    checkitem(ITEM_SUN_STONE)
    copyvar(VAR_TEMP_2, VAR_RESULT)
    checkitem(ITEM_MOON_STONE)
    copyvar(VAR_TEMP_3, VAR_RESULT)

    checkitem(ITEM_TM46)
    copyvar(VAR_TEMP_4, VAR_RESULT)
    checkitem(ITEM_ETHER)
    copyvar(VAR_TEMP_5, VAR_RESULT)
    checkitem(ITEM_JABOCA_BERRY)
    copyvar(VAR_TEMP_6, VAR_RESULT)
    checkitem(ITEM_BERRY_JUICE)
    copyvar(VAR_TEMP_7, VAR_RESULT)

    checkitem(ITEM_RING_TARGET)
    copyvar(VAR_TEMP_8, VAR_RESULT)
    checkitem(ITEM_MENTAL_HERB)
    copyvar(VAR_TEMP_9, VAR_RESULT)

    checkexactmoney(500)
    if(var(VAR_RESULT) == FALSE
        || !flag(FLAG_TRAINER4_DEFEATED)
        || !flag(FLAG_TRAINER5_DEFEATED)
        || var(VAR_0x8006) != ITEM_NONE 
        || var(VAR_0x8007) != ITEM_NONE
        || var(VAR_TEMP_0) == TRUE
        || var(VAR_TEMP_1) == TRUE
        || var(VAR_TEMP_2) == TRUE
        || var(VAR_TEMP_3) == TRUE
        || var(VAR_TEMP_4) == TRUE
        || var(VAR_TEMP_5) == TRUE
        || var(VAR_TEMP_6) == TRUE
        || var(VAR_TEMP_7) == TRUE
        || var(VAR_TEMP_8) == TRUE
        || var(VAR_TEMP_9) == TRUE)
    {
        lockall
        msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
    }
}

