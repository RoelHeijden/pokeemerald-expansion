script EscapeRoom_EventScript_Trainer8PostBattle{
    setflag(FLAG_TRAINER8_DEFEATED)
    call(EscapeRoom_EventScript_PostMatchHeal)

    // ERROR CHECK
    // - 1500 money
    // - Bagon learned Cut
    // - Trainer7b not defeated
    // - Trainer10 not defeated
    checkexactmoney(1500)
    copyvar(VAR_TEMP_4, VAR_RESULT)
    istaughtmovepresent(SPECIES_BAGON, MOVE_CUT)
    if(var(VAR_RESULT) == FALSE ||
       var(VAR_TEMP_4) == FALSE ||
       flag(FLAG_TRAINER7B_DEFEATED) ||
       flag(FLAG_TRAINER10_DEFEATED)) 
    {
        lockall
        msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }

    // remove Bagon Cut undo
    removetaughtmove(SPECIES_BAGON, MOVE_CUT)

    //// Choice item selection ////
    msgbox(ChoiceItemsFirstMessage, MSGBOX_DEFAULT)
    waitmessage   
    call(EscapeRoom_EventScript_GetChoiceItem) // NOTE: this script can "end"

    releaseall
}

script EscapeRoom_EventScript_Trainer9PostBattle{
    setflag(FLAG_TRAINER9_DEFEATED)
    call(EscapeRoom_EventScript_PostMatchHeal)

    // remove rare candy2 undo (for Annihilape)
    setvar(VAR_RARE_CANDY_2_USED_ON, SPECIES_NONE)

    // ERROR CHECK
    // - 2000 money
    // - Annihilape
    // - Trainer7b not defeated
    // - Trainer8 defeated
    // - Trainer10 not defeated
    checkexactmoney(2000)
    copyvar(VAR_TEMP_4, VAR_RESULT)
    checkpartymon(SPECIES_ANNIHILAPE)
    if(var(VAR_RESULT) == PARTY_SIZE ||
       var(VAR_TEMP_4) == FALSE ||
       flag(FLAG_TRAINER7B_DEFEATED) ||
       !flag(FLAG_TRAINER8_DEFEATED) ||
       flag(FLAG_TRAINER10_DEFEATED)) 
    {
        lockall
        msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
}

script EscapeRoom_EventScript_Trainer10PostBattle{
    setflag(FLAG_TRAINER10_DEFEATED)
    call(EscapeRoom_EventScript_PostMatchHeal)

    // remove rare candy3 undo (for Bagon)
    setvar(VAR_RARE_CANDY_3_USED_ON, SPECIES_NONE)

    // ERROR CHECK
    // - 500 money
    // - Bagon lvl 35
    // - Annihilape
    // - Trainer7b not defeated
    // - Trainer8 defeated
    // - Trainer9 defeated
    checkexactmoney(500)
    copyvar(VAR_TEMP_4, VAR_RESULT)
    checkpartymon(SPECIES_ANNIHILAPE)
    copyvar(VAR_TEMP_5, VAR_RESULT)
    checkpartymonlevel(35)
    if(var(VAR_RESULT) == PARTY_SIZE || var(VAR_0x8004) != SPECIES_BAGON ||
       var(VAR_TEMP_4) == FALSE ||
       var(VAR_TEMP_5) == PARTY_SIZE ||
       flag(FLAG_TRAINER7B_DEFEATED) ||
       !flag(FLAG_TRAINER8_DEFEATED) ||
       !flag(FLAG_TRAINER9_DEFEATED)) 
    {
        lockall
        msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
}

script EscapeRoom_EventScript_Trainer11PostBattle{
    setflag(FLAG_TRAINER11_DEFEATED)
    call(EscapeRoom_EventScript_PostMatchHeal)

    // prevent recovered item message
    clearflag(FLAG_DO_RECOVERED_ITEM_MESSAGE)

    // allow escaping final area again
    setvar(VAR_FINAL_BATTLE_REACHED, 1)

    // move trainer away
    applymovement(LOCALID_TRAINER11, EscapeRoom_Movement_Trainer11End)
    waitmovement(LOCALID_TRAINER11)
    copyobjectxytoperm(LOCALID_TRAINER11)
}

movement EscapeRoom_Movement_Trainer11End{
    face_up
    walk_up * 5
    walk_faster_up * 6
    walk_faster_left
    face_down
}


//// POKEMON TRADES ////

script EscapeRoom_EventScript_TradeZeraForHMCut{
    lock
    msgbox(AskZeraCutTradeMessage, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){


        // check if Zera in party (sanity check)
        checkpartymon(SPECIES_ZERAORA)
        copyvar(VAR_0x8004, VAR_RESULT) // store monslot for bye-bye message
        if(var(VAR_RESULT) == PARTY_SIZE)
        {
            msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
            waitmessage
            releaseall
            end
        }

        // get Cut
        giveitem(ITEM_HM01)

        // bye bye message
        special(BufferMonNickname)
        msgbox(ByeByeMonDynamic, MSGBOX_AUTOCLOSE)
        waitmessage

        // remove pokemon
        setflag(FLAG_ZERA_TRADED)
        removemon(SPECIES_ZERAORA)
    }
    else{
        msgbox(ZeraCutTradeDeclined, MSGBOX_AUTOCLOSE)
    }
    releaseall
}

script EscapeRoom_EventScript_TradeFerroVsDunsparce{
    lock
    faceplayer

    // post trade 
    if(flag(FLAG_FERRO_TRADE_ACCEPTED) == TRUE){

        // allow retrade
        if(!flag(FLAG_TRAINER3_DEFEATED)){
            msgbox(FerroTradeAskRetrade, MSGBOX_YESNO)
            waitmessage
            if(var(VAR_RESULT) == YES){
                call(EscapeRoom_EventScript_UndoFerroTrade)

                msgbox(FerroTradeUndoAccepted, MSGBOX_AUTOCLOSE)
                waitmessage
            }
            else{
                msgbox(FerroTradeUndoDeclined, MSGBOX_AUTOCLOSE)
                waitmessage
            }
        }
        // final script
        else{
            msgbox(FerroTradePostTrade, MSGBOX_NPC)
            waitmessage
        }
    }
    else{
        // ask trade
        msgbox(AskFerroDunsparceTrade, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){

            // check if Ferrothorn in party (sanity check)
            checkpartymon(SPECIES_FERROTHORN)
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot for bye-bye message
            if(var(VAR_RESULT) == PARTY_SIZE)
            {
                msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
                waitmessage
                releaseall
                end
            }

            // make Ferrothorn backup in pc
            backupmontopc(SPECIES_FERROTHORN)

            // received message
            message(DunsparceReceivedMessage)
            playfanfare(MUS_OBTAIN_ITEM)
            waitfanfare

            lockall

            // bye bye message
            special(BufferMonNickname)
            msgbox(ByeByeMonDynamic, MSGBOX_AUTOCLOSE)
            waitmessage

            // actually trade pokemon
            removemon(SPECIES_FERROTHORN)
            givemon(
                SPECIES_DUNSPARCE,
                48,
                abilityNum=2, // rattled
                nature=8, // impish
                gender=1, // female
                move1=MOVE_TRUMP_CARD,
                move2=MOVE_HEX,
                move3=MOVE_ICE_BEAM,
                move4=MOVE_NONE,
                // EVs:
                hpEv=0, 
                defEv=252,
                speedEv=252,
                // IVs:
                hpIv=0,
                atkIv=0,
                defIv=31,
                speedIv=31,
                spAtkIv=0,
                spDefIv=31
            )
            setflag(FLAG_FERRO_TRADE_ACCEPTED)

        }
        // trade declined
        else{
            msgbox(FerroTradeDeclined, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    releaseall
    end
}

