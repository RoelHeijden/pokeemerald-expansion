}

text AskZeraCutTradeMessage{
    "Wow, that Zeraora of yours is amazing.\n"
    "I wish I had a Pokémon like that!\p"
    "Would you be okay trading your Zeraora\n"
    "for my HM Cut?" 
}

text ZeraCutTradeDeclined{
    "Come back if you change your mind."
}

text ZeraCutTradeAccepted{
    "Bye-bye Zeraora."
}


