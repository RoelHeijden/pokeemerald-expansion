script EscapeRoom_EventScript_MapSwitch4{
    lockall

    // end if already solved
    if(flag(FLAG_MAP_SWITCHES_SOLVED) == TRUE){
        msgbox(MApSwitchesAlreadySolved, MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
        end
    }

    // set flag that fourth switch has been found
    if(flag(FLAG_MAP_SWITCH_4_FOUND) == FALSE){
        setflag(FLAG_MAP_SWITCH_4_FOUND)
    }

    // ask to change tablet direction
    if(var(VAR_MAP_SWITCH_4) == 0){
        msgbox(MapSwitchPointedNorthTablet4, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_4) == 1){
        msgbox(MapSwitchPointedEastTablet4, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_4) == 2){
        msgbox(MapSwitchPointedSouthTablet4, MSGBOX_YESNO)
    }
    if(var(VAR_MAP_SWITCH_4) == 3){
        msgbox(MapSwitchPointedWestTablet4, MSGBOX_YESNO)
    }

    // change direction
    if(var(VAR_RESULT) == YES){
        playse(SE_CLICK)
        addvar(VAR_MAP_SWITCH_4, 1)
        msgbox(RotatedSwitchSoundMessage, MSGBOX_AUTOCLOSE)
        waitmessage

        // full circle: back to north
        if(var(VAR_MAP_SWITCH_4) >= 4){
            setvar(VAR_MAP_SWITCH_4, 0)
        }
        
        // check for correct solution
        call(EscapeRoom_EventScript_CheckSwitchesCorrect)
    }
    releaseall
}

script EscapeRoom_EventScript_CheckSwitchesCorrect{
    if(
        var(VAR_MAP_SWITCH_1) == 2 &&  // south -- Pokemon screen contest moves
        var(VAR_MAP_SWITCH_2) == 2 &&  // south -- Bag
        var(VAR_MAP_SWITCH_3) == 3 &&  // west  -- Pokedex pokemon size
        var(VAR_MAP_SWITCH_4) == 3     // west  -- Save menu
    ){
        call(EscapeRoom_EventScript_SwitchesOpenDoorSequence)
        setflag(FLAG_HIDE_ANNIHILAPE) // remove Annihilape
    }
}

script EscapeRoom_EventScript_SwitchesOpenDoorSequence{
    fadeoutbgm(0)
    playse(SE_TRUCK_MOVE)
	special(DoSealedChamberShakingEffect_Long)
    waitstate
    delay(40)
	special(DoSealedChamberShakingEffect_Short)
	waitstate
	playse(SE_DOOR)
    delay(40)
    msgbox(MapSwitchDoorOpened, MSGBOX_DEFAULT)
	closemessage
    fadeinbgm(0)      
    setflag(FLAG_MAP_SWITCHES_SOLVED)
}


