script EscapeRoom_Nurse_Heal_Pokemon{
    lockall
    faceplayer
    msgbox(Nurse_Ask_heal, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        special(HealPlayerParty)
        msgbox(Nurse_Heal_End, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
}

script EscapeRoom_EventScript_HintsNPC{
    faceplayer
    lockall
    msgbox(HintsIntroMessage, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){    
        msgbox(HintsNPCWhatKindOfHintMessage)
        // TBD
    }
    else{
        msgbox(HintsNPCNoHintMessage)
    }
    releaseall
}

script EscapeRoom_EventScript_AntiSoftlockGuy{
    faceplayer
    lockall

    // if no potential softlocks:
    msgbox(AntiSoftlockIntroMessage)
    msgbox(AntiSoftlockNoActionMessage)
    releaseall
}

script EscapeRoom_EventScript_LostGlassesNPC{
    lockall
    faceplayer
    msgbox(LostGlassesNPCmainMessage, MSGBOX_AUTOCLOSE)

    // if lost glasses obtained
    checkitem(ITEM_WISE_GLASSES)
    if(var(VAR_RESULT) == TRUE){

        // display exclamation mark
        playse(SE_PIN)
        applymovement(18, Common_Movement_ExclamationMark)
        waitmovement(18)
        lockall

        msgbox(LostGlassesNPCGlassesFoundMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        call(EscapeRoom_EventScript_ObtainLiepard)
        lockall
        removeitem(ITEM_WISE_GLASSES)
        msgbox(LostGlassesNPCendMessage, MSGBOX_AUTOCLOSE)
        waitmessage 

        // walk away
        applymovement(18, EscapeRoom_Movement_LostGlassesNPC)
        waitmovement(18)
        delay(30)
        removeobject(18)
    }
    releaseall
    end
}

script EscapeRoom_EventScript_ObtainLiepard{
    lockall
    givemon(
        SPECIES_LIEPARD,
        50,
        abilityNum=2, // Prankster
        nature=16, // Mild
        gender=0, 
        move1=MOVE_ASSIST,
        move2=MOVE_TRICK,
        move3=MOVE_ROCK_SMASH,
        move4=MOVE_ECHOED_VOICE,
        // EVs:
        atkEv=148, 
        spAtkEv=252,
        speedEv=108,
        // IVs:
        hpIv=31,
        atkIv=31,
        defIv=31,
        speedIv=31,
        spAtkIv=31,
        spDefIv=31
    )    
    message(LiepardObtainMessage)
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare
}

movement EscapeRoom_Movement_LostGlassesNPC{
    walk_left * 8
}

