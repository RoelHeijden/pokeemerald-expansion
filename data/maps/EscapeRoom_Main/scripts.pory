        spAtkIv=31,
        spDefIv=0
    )

    // givemon(
    //     SPECIES_ZERAORA,
    //     43,
    //     item=ITEM_TM48,
    //     abilityNum=0, 
    //     nature=15, // modest
    //     gender=0, 
