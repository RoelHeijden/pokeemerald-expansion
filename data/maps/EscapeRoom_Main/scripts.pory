script EscapeRoom_EventScript_GraveStone1{
    lockall
    msgbox(GravestoneNoneMessage, MSGBOX_AUTOCLOSE)
    waitmessage

    // end if final check was reached
    if(flag(FLAG_GRAVESTONE_CHECK4) == TRUE){
        end
    }

    if (flag(FLAG_GRAVESTONE_CHECK1) == FALSE &&
        flag(FLAG_GRAVESTONE_CHECK2) == FALSE &&
        flag(FLAG_GRAVESTONE_CHECK3) == FALSE){
        msgbox(GravestoneClick1Message, MSGBOX_AUTOCLOSE)
        waitmessage    
        // set first flag
        setflag(FLAG_GRAVESTONE_CHECK1)
    }
    else{
        // reset msg
        msgbox(GravestoneResetMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        clearflag(FLAG_GRAVESTONE_CHECK1)
    }

    // clear flags
    clearflag(FLAG_GRAVESTONE_CHECK2)
    clearflag(FLAG_GRAVESTONE_CHECK3)


    releaseall
}

