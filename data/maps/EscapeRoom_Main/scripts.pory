// MOVE DELETER NPC

script EscapeRoom_MoveDeleterNPC{
    lockall
    faceplayer

    // stop deleting moves once Cacnea is obtained
    if(flag(FLAG_AIPOM_LIEPARD_TRADE_ACCEPTED)){
        msgbox(MoveDeleterOutOfBusiness, MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
        end
    }

    msgbox(AskDeleteMove, MSGBOX_MOVE_DELETER)

    // standard move deleter script
    if(var(VAR_RESULT) == 0){
        setflag(FLAG_IN_MOVE_DELETER_SCRIPT)
        call(EscapeRoom_ChooseMoveToDelete)
        clearflag(FLAG_IN_MOVE_DELETER_SCRIPT)
    }
    // restore moves
    elif(var(VAR_RESULT) == 1){
        call(EscapeRoom_RestoreMoveset)
        releaseall
        end
    }

    // goodbye message
    msgbox(MoveDeleterComeAgain, MSGBOX_AUTOCLOSE)
    releaseall
}

script EscapeRoom_ChooseMoveToDelete{
    // reset mon and move slot vars
    setvar(VAR_MOVE_DELETE_MONSLOT_BACKUP, 6)  // PARTY_SIZE
    setvar(VAR_MOVE_DELETER_CHOSEN_SLOT, 4)    // MAX_MON_MOVES

    // choose mon
	special(ChoosePartyMon)
	waitstate
}

script EscapeRoom_RestoreMoveset{
    // flag to detect if no moves were restored at all
    setflag(FLAG_TEMP_5)

    // Liepard
    restoremonmoveset(SPECIES_LIEPARD)
    if(var(VAR_RESULT) == TRUE){
        call(EscapeRoom_MoveRestoredSound)
        clearflag(FLAG_TEMP_5)
        clearflag(FLAG_LIEPARD_MOVE_DELETED)

        // moves restored message
        checkpartymon(SPECIES_LIEPARD)
        copyvar(VAR_0x8004, VAR_RESULT) // store monslot for move restore message
        special(BufferMonNickname)
        msgbox(MovesRestoredMessage, MSGBOX_DEFAULT)
        waitmessage
    }

    // Aipom
    restoremonmoveset(SPECIES_AIPOM)
    if(var(VAR_RESULT) == TRUE){
        call(EscapeRoom_MoveRestoredSound)
        clearflag(FLAG_TEMP_5)
        clearflag(FLAG_AIPOM_MOVE_DELETED)

        // moves restored message
        checkpartymon(SPECIES_AIPOM)
        copyvar(VAR_0x8004, VAR_RESULT) // store monslot for move restore message
        special(BufferMonNickname)
        msgbox(MovesRestoredMessage, MSGBOX_DEFAULT)
        waitmessage
    }

    // Dunsparce
    restoremonmoveset(SPECIES_DUNSPARCE)
    if(var(VAR_RESULT) == TRUE){
        call(EscapeRoom_MoveRestoredSound)
        clearflag(FLAG_TEMP_5)
        clearflag(FLAG_DUNSPARCE_MOVE_DELETED)

        // moves restored message
        checkpartymon(SPECIES_DUNSPARCE)
        copyvar(VAR_0x8004, VAR_RESULT) // store monslot for move restore message
        special(BufferMonNickname)
        msgbox(MovesRestoredMessage, MSGBOX_DEFAULT)
        waitmessage
    }

    // no moves restored
    if (flag(FLAG_TEMP_5) == TRUE)
    {
        msgbox(NoMovesRestoredMessage, MSGBOX_AUTOCLOSE)
        clearflag(FLAG_TEMP_5)
    }

}

script EscapeRoom_MoveRestoredSound{
    delay(5)
    playse(SE_NOTE_E)
    delay(5)
    playse(SE_NOTE_G)
    delay(5)
    playse(SE_NOTE_C_HIGH)
    waitse
}


// ZERAORA NPC

script EscapeRoom_ZeraoraHintNPC{
    lock

    if(flag(FLAG_ZERAORA_CAUGHT) == FALSE){
        if(flag(FLAG_POKE_BALL_OBTAINED) == FALSE){
            msgbox(ZeraoraHintMessage1, MSGBOX_NPC)
            waitmessage
            lock
            giveitem(ITEM_ULTRA_BALL)
            setflag(FLAG_POKE_BALL_OBTAINED)
        }
        else{
            msgbox(ZeraoraHintMessage2, MSGBOX_NPC)
        }
    }
    else{
        if(flag(FLAG_WHITE_HERB_OBTAINED) == FALSE){
            msgbox(ZeraoraHintPostCatchMessage1, MSGBOX_NPC)
            waitmessage
            lock
            giveitem(ITEM_WHITE_HERB)
            setflag(FLAG_WHITE_HERB_OBTAINED)
            msgbox(ZeraoraHintPostCatchMessage2, MSGBOX_NPC)
            waitmessage
        }
        else{
            msgbox(ZeraoraHintPostCatchMessage3, MSGBOX_NPC)
            waitmessage
        }
    }

    releaseall
}


// ONE-WAY ROCK SMASH NPC

script EscapeRoom_RockSmashNPC{
    lock
    msgbox(RockSmashNPCstuck, MSGBOX_NPC)
    waitmessage
    applymovement(LOCALID_ROCK_SMASH_NPC, _face_up)
    waitmovement(LOCALID_ROCK_SMASH_NPC)
    releaseall
}

script EscapeRoom_MoveRockSmashNPC{
    // script triggers if rock is smashed

    // exclamation mark
    playse(SE_PIN)
    applymovement(LOCALID_ROCK_SMASH_NPC, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_ROCK_SMASH_NPC)
    delay(30)
    
    // move NPC up
    applymovement(LOCALID_ROCK_SMASH_NPC, RockSmashNPCMovesUp)
    waitmovement(LOCALID_ROCK_SMASH_NPC)

    // dialogue
    msgbox(RockSmashNPCFarewellMsg, MSGBOX_AUTOCLOSE)
    waitmessage

    // move player away
    applymovement(OBJ_EVENT_ID_PLAYER, EscapeRoom_Movement_PlayerMoveAwayFromRock)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    // move NPC away
    applymovement(LOCALID_ROCK_SMASH_NPC, RockSmashNPCMovesAway)
    waitmovement(LOCALID_ROCK_SMASH_NPC)
    
    // remove object
    playse(SE_EXIT)
    delay(5)
    removeobject(LOCALID_ROCK_SMASH_NPC)
    setflag(FLAG_HIDE_ROCKSMASH_NPC)
    waitse

    // flags
    clearflag(FLAG_HIDE_ROCKSMASH_TUNNEL_NPC)
    setflag(FLAG_ROCK_SMASH_GUY_MOVED)
    
    // prevent Mental Herb restore
    removelostitem(ITEM_MENTAL_HERB)


    // ERROR CHECK
    // - 0 money
    // - trainer 4 defeated
    // - mental herb used
    checkpartyitem(0)
    copyvar(VAR_0x8006, VAR_0x8005)
    checkpartyitem(1)
    copyvar(VAR_0x8007, VAR_0x8005)

    checkitem(ITEM_MENTAL_HERB)
    copyvar(VAR_TEMP_4, VAR_RESULT)

    checkexactmoney(0)
    if(var(VAR_RESULT) == FALSE
        || !flag(FLAG_TRAINER4_DEFEATED)
        || (var(VAR_0x8006) == ITEM_MENTAL_HERB || var(VAR_0x8007) == ITEM_MENTAL_HERB)
        || var(VAR_TEMP_4) == TRUE)
    {
        lockall
        msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
    }

}

movement EscapeRoom_Movement_PlayerMoveAwayFromRock {
    walk_right
    walk_down
    face_up
}
movement RockSmashNPCMovesUp {
    walk_up
    face_right
}
movement RockSmashNPCMovesAway {
    walk_right * 3
    face_up
}


// STONE BUY NPC //

script EscapeRoom_TryBuyStonesPC{
    lock

    if(flag(FLAG_JABOCA_OBTAINED)){
        // post script message
        msgbox(StonesBuyNPCPostSellMessage, MSGBOX_NPC)
        waitmessage
    }
    else{
        // Sun Stone
        checkitem(ITEM_SUN_STONE)
        if(var(VAR_RESULT) == TRUE){
            call(EscapeRoom_TryBuyStonesPC_TryBuySunStone)
            end
        }

        // Moon Stone
        checkitem(ITEM_MOON_STONE)
        if(var(VAR_RESULT) == TRUE){
            call(EscapeRoom_TryBuyStonesPC_TryBuyMoonStone)
            end
        }

        // Dusk Stone
        checkitem(ITEM_DUSK_STONE)
        if(var(VAR_RESULT) == TRUE){
            call(EscapeRoom_TryBuyStonesPC_TryBuyDuskStone)
            end
        }

        // player has none of the trade items
        msgbox(StonesBuyNPCInitialMessage_no_item, MSGBOX_NPC)
        waitmessage
    }

    releaseall
}

script EscapeRoom_TryBuyStonesPC_TryBuySunStone{
    faceplayer
    msgbox(StonesBuyNPCInitialMessage_has_SunStone, MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES){
        removeitem(ITEM_SUN_STONE)
        addmoney(1500)
        lockall
        message(MoneyReceived1500)
        playfanfare(MUS_OBTAIN_ITEM)
        waitfanfare
        delay(10)

        msgbox(StonesBuyNPCSellAcceptedMessage, MSGBOX_NPC)
        waitmessage
    }
    else{
        msgbox(StonesBuyNPCSellDeclinedMessage, MSGBOX_NPC)
        waitmessage
    }
}

script EscapeRoom_TryBuyStonesPC_TryBuyMoonStone{
    faceplayer
    msgbox(StonesBuyNPCInitialMessage_has_MoonStone, MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES){
        removeitem(ITEM_MOON_STONE)
        addmoney(1500)
        lockall
        message(MoneyReceived1500)
        playfanfare(MUS_OBTAIN_ITEM)
        waitfanfare
        delay(10)

        msgbox(StonesBuyNPCSellAcceptedMessage, MSGBOX_NPC)
        waitmessage
    }
    else{
        msgbox(StonesBuyNPCSellDeclinedMessage, MSGBOX_NPC)
        waitmessage
    }
}

script EscapeRoom_TryBuyStonesPC_TryBuyDuskStone{
    faceplayer
    msgbox(StonesBuyNPCInitialMessage_has_DuskStone, MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES){
        removeitem(ITEM_DUSK_STONE)
        giveitem(ITEM_JABOCA_BERRY)
        setflag(FLAG_JABOCA_OBTAINED)

        msgbox(StonesBuyNPCSellAcceptedMessage_JabocaBerry, MSGBOX_NPC)
        waitmessage
    }
    else{
        msgbox(StonesBuyNPCSellDeclinedMessage, MSGBOX_NPC)
        waitmessage
    }
}


// SECRET POWER NPC //

script EscapeRoom_SecretGarden_SecretPowerNPC{
    lockall
    faceplayer

    // end if Secret Power already learned
    if(flag(FLAG_SECRET_POWER_LEARNED) || flag(FLAG_SECRET_POWER_COMPLETED)){
        msgbox(SecretGardenNPC_EndOfScriptMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
        end
    }

    // start message
    msgbox(SecretGardenNPC_AskLovePlants, MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO){
        msgbox(SecretGardenNPC_PlantLove_No, MSGBOX_DEFAULT)
        waitmessage
    }
    else{
        // no Thief in party
        checkpartymove(MOVE_THIEF)
        if(var(VAR_RESULT) == PARTY_SIZE){
            msgbox(SecretGardenNPC_PlantLove_Yes, MSGBOX_DEFAULT)
            waitmessage
            lockall

            // teach Secret Power
            call(EscapeRoom_SecretGarden_TeachSecretPower)
            
            msgbox(SecretGardenNPC_PostTeachMessage, MSGBOX_AUTOCLOSE)
            waitmessage
        }
        // Pokémon knows Thief
        else{
            msgbox(SecretGardenNPC_PlantLove_Yes, MSGBOX_DEFAULT)
            waitmessage
            lockall

            // ask remove Thief
            msgbox(SecretGardenNPC_PlantLove_Yes_Thief, MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES){
                // teach Secret Power
                call(EscapeRoom_SecretGarden_TeachSecretPower)
                
                msgbox(SecretGardenNPC_PostTeachMessage, MSGBOX_AUTOCLOSE)
                waitmessage
            }
            else{
                msgbox(SecretGardenNPC_TeachDeclinedMessage, MSGBOX_AUTOCLOSE)
                waitmessage
            }
        }
    }
    releaseall
}

script EscapeRoom_SecretGarden_TeachSecretPower{
    // remove Thief
    checkpartymove(MOVE_THIEF)
    if(var(VAR_RESULT) != PARTY_SIZE){
        if(var(VAR_RESULT) == 0){
            replacemove(0, MOVE_THIEF, MOVE_NONE)
        }
        elif(var(VAR_RESULT) == 1){
            replacemove(1, MOVE_THIEF, MOVE_NONE)
        }
        setflag(FLAG_THIEF_REPLACED)
    }

    // buffer pokemon name and teach move
    checkpartymon(SPECIES_CACNEA)
    if(var(VAR_RESULT) != PARTY_SIZE){
        copyvar(VAR_0x8004, VAR_RESULT) // store monslot
        addmonmove(SPECIES_CACNEA, MOVE_SECRET_POWER)
    }
    checkpartymon(SPECIES_CACTURNE)
    if(var(VAR_RESULT) != PARTY_SIZE){
        copyvar(VAR_0x8004, VAR_RESULT) // store monslot
        addmonmove(SPECIES_CACTURNE, MOVE_SECRET_POWER)
    }

    playfanfare(MUS_LEVEL_UP)
    special(BufferMonNickname)
    msgbox(MonLearnedSecretPower, MSGBOX_DEFAULT)
    waitfanfare
    lockall

    // set flag
    setflag(FLAG_SECRET_POWER_LEARNED)
}

// SECRET GARDEN GUARD //

script EscapeRoom_SecretGarden_GateEntryNPC_KeepOut{
    lockall

    // exclamation mark
    playse(SE_PIN)
    applymovement(LOCALID_SECRETGARDEN_GUARD, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_SECRETGARDEN_GUARD)
    applymovement(LOCALID_SECRETGARDEN_GUARD, _face_left)
    waitmovement(LOCALID_SECRETGARDEN_GUARD)
    delay(25)

    // message
    msgbox(SecretGardenGuardKeepOut, MSGBOX_AUTOCLOSE)
    waitmessage

    // player move left
    applymovement(OBJ_EVENT_ID_PLAYER, SecretGarden_PlayerMoveLeft)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    releaseall
}

script EscapeRoom_SecretGarden_GateEntryNPC_KickOut{
    lockall

    // exclamation mark
    playse(SE_PIN)
    applymovement(LOCALID_SECRETGARDEN_GUARD, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_SECRETGARDEN_GUARD)
    applymovement(LOCALID_SECRETGARDEN_GUARD, _face_down)
    waitmovement(LOCALID_SECRETGARDEN_GUARD)
    delay(30)

    applymovement(LOCALID_SECRETGARDEN_GUARD, SecretGarden_NPC_move_down)
    waitmovement(LOCALID_SECRETGARDEN_GUARD)
    applymovement(OBJ_EVENT_ID_PLAYER, _face_right)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    // player gets spotted message
    msgbox(SecretGardenGuardSpotted, MSGBOX_AUTOCLOSE)
    waitmessage
    
    // move NPC and player up
    applymovement(LOCALID_SECRETGARDEN_GUARD, SecretGarden_NPC_move_up)
    applymovement(OBJ_EVENT_ID_PLAYER, SecretGarden_PlayerMoveUp)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    lockall // to be sure

    // follow up message
    if(!flag(FLAG_SECRET_POWER_LEARNED) || flag(FLAG_SECRET_POWER_COMPLETED)){
        msgbox(SecretGardenGuardStayOut, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    elif(!flag(FLAG_SECRET_POWER_COMPLETED)){
        msgbox(SecretGardenGuardRemoveSecretPower, MSGBOX_AUTOCLOSE)
        waitmessage
        lockall

        // remove secret power
        checkpartymove(MOVE_SECRET_POWER)
        if(var(VAR_RESULT) == 0){
            replacemove(0, MOVE_SECRET_POWER, MOVE_NONE)
        }
        elif(var(VAR_RESULT) == 1){
            replacemove(1, MOVE_SECRET_POWER, MOVE_NONE)
        }
        clearflag(FLAG_SECRET_POWER_LEARNED)


        // add back Thief if necessary
        clearflag(FLAG_TEMP_2)
        if(flag(FLAG_THIEF_REPLACED)){
            addmonmove(SPECIES_CACNEA, MOVE_THIEF)
            addmonmove(SPECIES_CACTURNE, MOVE_THIEF)
            clearflag(FLAG_THIEF_REPLACED)
            setflag(FLAG_TEMP_2)
        }

        // secret power removed message
        checkpartymon(SPECIES_CACNEA)
        if(var(VAR_RESULT) != PARTY_SIZE){
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot
        }
        checkpartymon(SPECIES_CACTURNE)
        if(var(VAR_RESULT) != PARTY_SIZE){
            copyvar(VAR_0x8004, VAR_RESULT) // store monslot
        }

        playse(SE_SUCCESS)
        waitse
        special(BufferMonNickname)
        msgbox(MonForgotSecretPower, MSGBOX_DEFAULT)
        waitmessage
        lockall

        // thief restored message
        if(flag(FLAG_TEMP_2)){
            msgbox(MonThiefRestored, MSGBOX_AUTOCLOSE)
            waitmessage
            lockall
        }
    }

    // move player away
    applymovement(OBJ_EVENT_ID_PLAYER, SecretGarden_PlayerMoveLeft)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    releaseall
}

movement SecretGarden_NPC_move_down {
    walk_fast_down * 2
    face_left
}
movement SecretGarden_NPC_move_up {
    face_up
    walk_up * 2
    face_left
}
movement SecretGarden_PlayerMoveUp {
    face_up
    walk_up * 2
    face_right
}
movement SecretGarden_PlayerMoveLeft {
    face_left
    walk_left
}


