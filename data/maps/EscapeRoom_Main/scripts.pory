////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_Main_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: EscapeRoom_MapScript_OnTransitionScripts
    MAP_SCRIPT_ON_RESUME: EscapeRoom_MapScript_OnResumeScripts

    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_WARP_COUNTER, 0: EscapeRoom_MapScript_OnWarpIntoScripts
    ]

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 0: EscapeRoom_MapScript_GameStartScripts
        VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1: EscapeRoom_MapScripts_FindBallAferUse
        VAR_RETRIEVED_HELD_ITEM, 1: EscapeRoom_MapScripts_RetrievedItemMessage
        VAR_DO_STICKY_BARB_RETURN, 1: EscapeRoom_MapScripts_ReturnStickyBarb
        VAR_ASK_RESET_PREDAMAGE, 1: EscapeRoom_MapScripts_AskResetPredamage
        VAR_ASK_WARP_BACK, 1: EscapeRoom_MapScripts_AskWarpBack
        VAR_ROCK_SMASH_NPC_STATE, 1: EscapeRoom_MapScripts_CheckIfRockSmashed
        VAR_DO_ERROR_MESSAGE, 1: EscapeRoom_MapScripts_DoErrorMessage
    ] 
}



script EscapeRoom_MapScript_OnTransitionScripts{
    // set annihilape hint npc movement
    if(flag(FLAG_HIDE_ANNIHILAPE) == FALSE){
        setobjectmovementtype(LOCALID_APE_HINT_NPC, MOVEMENT_TYPE_LOOK_AROUND)
    }

    // keep trainer 3 moved from the door
    if(flag(FLAG_TRAINER3_DEFEATED)){
        setobjectxyperm(LOCALID_TRAINER3, 62, 10)
        setobjectmovementtype(LOCALID_TRAINER3, MOVEMENT_TYPE_FACE_LEFT)
    }
}

script EscapeRoom_MapScript_OnResumeScripts{
    // check if pokemon caught -- sets flag if true
    if(!flag(FLAG_ZERAORA_CAUGHT)){
        call(EscapeRoom_MapScripts_CheckIfPokemonCaught)
    }

    // check for ball return -- sets frame table var if true
    if(flag(FLAG_BALL_USED) && !flag(FLAG_ZERAORA_CAUGHT)){
        setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1)
    }

    // check if held item was retrieved -- sets frame table var if true
    if(flag(FLAG_DO_RECOVERED_ITEM_MESSAGE))
    {
        setvar(VAR_RETRIEVED_HELD_ITEM, 1)
    }

    // check if TM Secret power was stolen
    call(EscapeRoom_MapScripts_CheckIfSecretPowerObtained)

    // check if mental herb sack used
    if(flag(FLAG_DUNSPARCE_TRADE_ACCEPTED) == TRUE && flag(FLAG_TRAINER6_DEFEATED) == FALSE){
        call(EscapeRoom_MapScripts_CheckIfMentalHerbSackUsed)
    }

    // check if Rayquaza's item is succesfully stolen
    if(flag(FLAG_SPACE_ITEM_STOLEN) == FALSE){
        call(EscapeRoom_MapScripts_CheckSpaceItemStolen)
    }

    // check if sticky barb was stolen after trainer 0
    // sets a var to return the item
    if(flag(FLAG_TRAINER0_DEFEATED) == FALSE){
        call(EscapeRoom_MapScripts_CheckStickyBarbStolen)
    }

    // disable bag use 
    if(flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
    
    // check if ask pre-damage restore
    // sets var if true
    call(EscapeRoom_MapScripts_CheckIfAskPreDamage)

    // check if ask warp back to previous section
    // sets var if true
    call(EscapeRoom_MapScripts_CheckIfAskWarpBack)

    // clear flag used in CheckIfAskPreDamage and CheckIfAskWarpBack
    if(flag(FLAG_PLAYER_JUST_LOST)){
        clearflag(FLAG_PLAYER_JUST_LOST)  
    }
} 

script EscapeRoom_MapScript_OnWarpIntoScripts{
    // set NPC facing
}


//// ON TRANSITION ////



//// ON RESUME ////

script EscapeRoom_MapScripts_CheckIfPokemonCaught{
    // check if pokemon caught -- sets flag if true
    getpartysize
    if (var(VAR_RESULT) >= 3){
        setflag(FLAG_ZERAORA_CAUGHT)

        // prevent Ether recovery if used
        clearflag(FLAG_RETURN_ETHER)

        // prevent Custap restore after catching zera
        removelostitem(ITEM_CUSTAP_BERRY)

        // prevent recovered item message
        clearflag(FLAG_DO_RECOVERED_ITEM_MESSAGE)


        // ERROR CHECK
        // - 500 money
        // - custap used
        // - ether used
        checkpartyitem(0)
        copyvar(VAR_0x8006, VAR_0x8005)
        checkpartyitem(1)
        copyvar(VAR_0x8007, VAR_0x8005)

        checkitem(ITEM_ETHER)
        copyvar(VAR_TEMP_4, VAR_RESULT)

        checkitem(ITEM_CUSTAP_BERRY)
        copyvar(VAR_TEMP_5, VAR_RESULT)

        checkexactmoney(500)
        if(var(VAR_RESULT) == FALSE 
            || (var(VAR_0x8006) == ITEM_CUSTAP_BERRY || var(VAR_0x8007) == ITEM_CUSTAP_BERRY)
            || (var(VAR_0x8006) == ITEM_ETHER || var(VAR_0x8007) == ITEM_ETHER)
            || var(VAR_TEMP_4) == TRUE
            || var(VAR_TEMP_5) == TRUE)
        {
            // do error message
            setvar(VAR_DO_ERROR_MESSAGE, 1)
        }
    }
}

script EscapeRoom_MapScripts_CheckSpaceItemStolen{
    checkitem(ITEM_MOON_STONE) // in bag
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_SPACE_ITEM_STOLEN)
    }
    checkpartyitem(0) // held by pokemon slot 1
    if(var(VAR_0x8005) == ITEM_MOON_STONE) {
        setflag(FLAG_SPACE_ITEM_STOLEN)
    }
    checkpartyitem(1) // held by pokemon slot 2
    if(var(VAR_0x8005) == ITEM_MOON_STONE) {
        setflag(FLAG_SPACE_ITEM_STOLEN)
    }
    checkpartyitem(2) // held by pokemon slot 3
    if(var(VAR_0x8005) == ITEM_MOON_STONE) {
        setflag(FLAG_SPACE_ITEM_STOLEN)
    }
}

script EscapeRoom_MapScripts_CheckStickyBarbStolen{
    checkitem(ITEM_STICKY_BARB) // in bag
    if(var(VAR_RESULT) == TRUE){
        setvar(VAR_DO_STICKY_BARB_RETURN, 1)
    }
    checkpartyitem(0) // held by pokemon slot 1
    if(var(VAR_0x8005) == ITEM_STICKY_BARB) {
        setvar(VAR_DO_STICKY_BARB_RETURN, 1)
    }
    checkpartyitem(1) // held by pokemon slot 2
    if(var(VAR_0x8005) == ITEM_STICKY_BARB) {
        setvar(VAR_DO_STICKY_BARB_RETURN, 1)
    }
    checkpartyitem(2) // held by pokemon slot 3
    if(var(VAR_0x8005) == ITEM_STICKY_BARB) {
        setvar(VAR_DO_STICKY_BARB_RETURN, 1)
    }
}

script EscapeRoom_MapScripts_CheckIfAskPreDamage{
    // lost battles
    if(flag(FLAG_PLAYER_JUST_LOST) == TRUE){
        partybackupisdifferent
        if(var(VAR_RESULT) == TRUE){
            setvar(VAR_ASK_RESET_PREDAMAGE, 1)
        }
    }

    // zera catch sequence (to include pre damage on win)
    if(flag(FLAG_JUST_HAD_ZERA_BATTLE) == TRUE && flag(FLAG_ZERAORA_CAUGHT) == FALSE){
        partybackupisdifferent
        if(var(VAR_RESULT) == TRUE){
            setvar(VAR_ASK_RESET_PREDAMAGE, 1)
            
            // flag to prevent dupe items (returned via backup)
            setflag(FLAG_ZERA_FIGHT_BACKUP_CHECK)
        }
        clearflag(FLAG_JUST_HAD_ZERA_BATTLE)
    }

    // other wild battles are currently skipped on wins (no relevant pre damage scenarios)
}

script EscapeRoom_MapScripts_CheckIfMentalHerbSackUsed{
    // check if Mental Herb was not already lost, or Liepard not already sacked 
    // (these should be set at the same time for the main Herb Sack flag to be set)
    clearflag(FLAG_TEMP_1)
    if(flag(FLAG_LIEPARD_SACKED) || flag(FLAG_MENTAL_HERB_IS_LOST)){
        setflag(FLAG_TEMP_1)
    }

    // check if Liepard sacked
    partymonhasfainted
    if(var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_LIEPARD){
        setflag(FLAG_LIEPARD_SACKED)
    }
    else{
        clearflag(FLAG_LIEPARD_SACKED)
    }

    // check if mental herb lost
    isitemlost(ITEM_MENTAL_HERB)
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_MENTAL_HERB_IS_LOST)
    }
    else{
        clearflag(FLAG_MENTAL_HERB_IS_LOST)
    }


    // mental herb has been used to sack Liepard
    // FLAG_TEMP_1 == one flag was already set at the start
    if(flag(FLAG_LIEPARD_SACKED) && flag(FLAG_MENTAL_HERB_IS_LOST) && !flag(FLAG_TEMP_1)){  
        setflag(FLAG_MENTAL_HERB_SACK_ACTIVE)
    }

    // clear flag if Liepard fully healed (i.e. not Rare Candy heal)
    checkpartymonfullhp(SPECIES_LIEPARD)
    if(var(VAR_RESULT) == TRUE && flag(FLAG_MENTAL_HERB_SACK_ACTIVE)){
        clearflag(FLAG_MENTAL_HERB_SACK_ACTIVE)
    }
}

script EscapeRoom_MapScripts_CheckIfAskWarpBack{
    // if just lost a battle
    if(flag(FLAG_PLAYER_JUST_LOST) && flag(FLAG_LIEPARD_OBTAINED)){

        // check if prev player location and spawn are different
        compare_var_to_var(VAR_LOCATED_AT_SECTION_X, VAR_RESPAWN_AT_SECTION_X)
        goto_if_eq(Equal)
        setvar(VAR_ASK_WARP_BACK, 1)
    }
    Equal:
}

script EscapeRoom_MapScripts_CheckIfSecretPowerObtained{
    if(flag(FLAG_SECRET_POWER_OBTAINED) && !flag(FLAG_SECRET_POWER_COMPLETED)){
        setflag(FLAG_SECRET_POWER_COMPLETED)

        // ERROR CHECK
        // - 0 money
        // - Annihilape learned Thief
        // - Annihilape is in party
        // - Toxic Orb Stolen
        // - Trainer9 defeated
        // - Trainer10 not defeated
        istaughtmovepresent(SPECIES_ANNIHILAPE, MOVE_THIEF)
        copyvar(VAR_TEMP_4, VAR_RESULT)
        checkpartymon(SPECIES_ANNIHILAPE)
        copyvar(VAR_TEMP_5, VAR_RESULT)
        checkexactmoney(0)
        if(var(VAR_RESULT) == FALSE ||
            var(VAR_TEMP_4) == FALSE ||
            var(VAR_TEMP_5) == PARTY_SIZE ||
            !flag(FLAG_TOXIC_ORB_OBTAINED) ||
            !flag(FLAG_TRAINER9_DEFEATED) ||
            flag(FLAG_TRAINER10_DEFEATED)) 
        {
            setvar(VAR_DO_SOMETHING_WRONG_MESSAGE, 1)
        }

        // remove Annihilape Thief undo option
        removetaughtmove(SPECIES_ANNIHILAPE, MOVE_THIEF)
    }
}


//// ON FRAME //// 

script EscapeRoom_MapScripts_FindBallAferUse{
    lockall
    msgbox(NewBallMessage, MSGBOX_AUTOCLOSE)
    waitmessage
    finditem(ITEM_ULTRA_BALL)
    clearflag(FLAG_BALL_USED)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 0)
    releaseall
}

script EscapeRoom_MapScripts_RetrievedItemMessage{
    lockall

    // main message
    if(flag(FLAG_DO_RECOVERED_ITEM_MESSAGE)){
        msgbox(HeldItemRecoveredMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        clearflag(FLAG_DO_RECOVERED_ITEM_MESSAGE)
    }

    setvar(VAR_RETRIEVED_HELD_ITEM, 0)
    releaseall
}

script EscapeRoom_MapScripts_ReturnStickyBarb{
    setvar(VAR_DO_STICKY_BARB_RETURN, 0)

    checkitem(ITEM_STICKY_BARB) // in bag
    if(var(VAR_RESULT) == TRUE){
        removeitem(ITEM_STICKY_BARB)
    }
    // check if pokemon 1 carries sticky barb
    checkpartyitem(0)
    if(var(VAR_0x8005) == ITEM_STICKY_BARB){
        removepartyitem(0)
    }
    // check if pokemon 2 carries sticky barb
    checkpartyitem(1)
    if(var(VAR_0x8005) == ITEM_STICKY_BARB){
        removepartyitem(1)
    }
    // check if pokemon 3 carries sticky barb
    checkpartyitem(2)
    if(var(VAR_0x8005) == ITEM_STICKY_BARB){
        removepartyitem(2)
    }

    // do message
    msgbox(HeldStickyBarbReturnedMessage, MSGBOX_AUTOCLOSE)
    waitmessage

}

script EscapeRoom_MapScripts_AskResetPredamage{
    lockall

    // reset var
    setvar(VAR_ASK_RESET_PREDAMAGE, 0)

    // check warp required
    if(var(VAR_ASK_WARP_BACK) == 1){
        // reset warp var
        setvar(VAR_ASK_WARP_BACK, 0)

        // ask warp and damage reset
        msgbox(AskResetPredamageAndWarpMessage, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            // reset pre-damage
            call(EscapeRoom_MapScripts_ResetPredamage)

            // warp to previous 
            call(EscapeRoom_EventScript_WarpToPreviousLocation)
        }
        else{
            // reset location 
            call(EscapeRoom_EventScript_SetLocationToSpawn)
        }
    }
    // normal predamage reset
    else{
        msgbox(AskResetPredamageMessage, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            // reset pre-damage
            call(EscapeRoom_MapScripts_ResetPredamage)

            // prevent zera fight item dupes via backup + lostItems
            if(flag(FLAG_ZERA_FIGHT_BACKUP_CHECK) == TRUE){
                clearflag(FLAG_ZERA_FIGHT_BACKUP_CHECK)
                call(EscapeRoom_MapScripts_RemoveDuplicateCustap)
            }
        }
    }
    releaseall
}

script EscapeRoom_MapScripts_ResetPredamage{
    clearflag(FLAG_TEMP_1)
    clearflag(FLAG_TEMP_2)

    // check if pokemon carries Moon Stone (just stolen) 
    checkpartyitem(0)
    if(var(VAR_RESULT) && var(VAR_0x8005) == ITEM_MOON_STONE){
        setflag(FLAG_TEMP_1)
    }
    checkpartyitem(1)
    if(var(VAR_RESULT) && var(VAR_0x8005) == ITEM_MOON_STONE){
        setflag(FLAG_TEMP_2)
    }

    // restore pokemon state
    restoreplayerparty
    msgbox(PreDamagedStateRestoredMessage, MSGBOX_AUTOCLOSE)
    waitmessage

    // return moon stone item
    if(flag(FLAG_TEMP_1)){
        givepartyitem(ITEM_MOON_STONE, 0) // slot 0
    }
    elif(flag(FLAG_TEMP_2)){
        givepartyitem(ITEM_MOON_STONE, 1) // slot 1
    }

}

script EscapeRoom_MapScripts_AskWarpBack{
    lockall

    // reset warp var
    setvar(VAR_ASK_WARP_BACK, 0)

    // ask warp
    msgbox(AskWarpBackMessage, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        // warp to previous 
        call(EscapeRoom_EventScript_WarpToPreviousLocation)
    }
    else{
        // reset location 
        call(EscapeRoom_EventScript_SetLocationToSpawn)
    }
    releaseall
}

script EscapeRoom_MapScripts_RemoveDuplicateCustap{
    // check if pokemon 1 carries custap
    checkpartyitem(0)
    if(var(VAR_0x8005) == ITEM_CUSTAP_BERRY){
        removelostitem(ITEM_CUSTAP_BERRY)
    }

    // check if pokemon 2 carries custap
    checkpartyitem(1)
    if(var(VAR_0x8005) == ITEM_CUSTAP_BERRY){
        removelostitem(ITEM_CUSTAP_BERRY)
    }
}

script EscapeRoom_MapScripts_CheckIfRockSmashed{
    call(EscapeRoom_MoveRockSmashNPC)
    setvar(VAR_ROCK_SMASH_NPC_STATE, 0)
}

script EscapeRoom_MapScripts_DoErrorMessage{
    setvar(VAR_DO_ERROR_MESSAGE, 0)
    lockall
    msgbox(SomethingsGoneWrongMessage, MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}

