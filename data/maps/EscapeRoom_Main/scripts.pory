    setflag(FLAG_SYS_NATIONAL_DEX)
}

script EscapeRoom_MapScripts_GetFirstPokemon{
    givemon(
        SPECIES_FLORGES,
        22,
        item=ITEM_EXP_CANDY_S,
        abilityNum=2, // symbiosis
        nature=21, // gentle
        gender=1, // female
        move1=MOVE_NATURE_POWER,
        move2=MOVE_GRASS_KNOT,
        move3=MOVE_GRASSY_TERRAIN,
        move4=MOVE_CAMOUFLAGE,
        // EVs:
        hpEv=252,
        spDefEv=252,
        // IVs:
        hpIv=31,
        atkIv=1,
        defIv=3,
        speedIv=31,
        spAtkIv=0,
        spDefIv=30
    )

    givemon(
        SPECIES_FERROTHORN,
        28,
        abilityNum=2, // anticipation
        nature=4, // naughty
        gender=0, 
        move1=MOVE_STEEL_ROLLER,
        move2=MOVE_BLOCK,
        move3=MOVE_INGRAIN,
        move4=MOVE_SUNNY_DAY,
        // EVs:
        hpEv=0, 
        atkEv=252,
        spDefEv=0, 
        defEv=0,
        // IVs:
        hpIv=0,
        atkIv=31,
        defIv=0,
        speedIv=31,
        spAtkIv=31,
        spDefIv=0
    )

    setflag(FLAG_SYS_POKEMON_GET)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 2)
}

