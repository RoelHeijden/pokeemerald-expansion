//// POKEMON TRADES ////

script EscapeRoom_EventScript_TradeZeraForHMCut{
    end
}

script EscapeRoom_EventScript_TradeFerroVsDunsparce{
    lockall
    faceplayer
    msgbox(format("Trade Ferrothorn for Dunsparce?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        removemon(SPECIES_FERROTHORN)
        givemon(
            SPECIES_DUNSPARCE,
            50,
            abilityNum=2, // rattled
            nature=8, // impish
            gender=0, 
            move1=MOVE_TRUMP_CARD,
            move2=MOVE_AIR_SLASH,
            move3=MOVE_HEX,
            move4=MOVE_COUNTER,
            // EVs:
            hpEv=0, 
            defEv=252,
            // IVs:
            hpIv=0,
            atkIv=0,
            defIv=31,
            speedIv=31,
            spAtkIv=10,
            spDefIv=31
        )
    }
    releaseall
}

script EscapeRoom_EventScript_TradeFlorgesForEgg{
    end
}

script EscapeRoom_EventScript_ObtainLiepard{
    givemon(
        SPECIES_LIEPARD,
        50,
        abilityNum=2, // Prankster
        nature=16, // Mild
        gender=0, 
        move1=MOVE_ASSIST,
        move2=MOVE_TRICK,
        move3=MOVE_ROCK_SMASH,
        move4=MOVE_ECHOED_VOICE,
        // EVs:
        atkEv=148, 
        spAtkEv=252,
        speedEv=108,
        // IVs:
        hpIv=31,
        atkIv=31,
        defIv=31,
        speedIv=31,
        spAtkIv=31,
        spDefIv=31
    )
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox(LiepardObtainMessage, MSGBOX_AUTOCLOSE)
    waitfanfare
}

script EscapeRoom_EventScript_SellDunsparce{
    end
}

script EscapeRoom_EventScript_TradePoochForSmeargle{
