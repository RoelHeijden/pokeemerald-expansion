        hpEv=0, 
        atkEv=252,
        spDefEv=0, 
        defEv=0,
        // IVs:
        hpIv=0,
        atkIv=31,
        defIv=0,
        speedIv=31,
        spAtkIv=31,
        spDefIv=0
