script EscapeRoom_EventScript_SpawnAnnihilape{
    fadeoutbgm(0)
    clearflag(FLAG_HIDE_ANNIHILAPE)
	special(DoSealedChamberShakingEffect_Short)
    msgbox(GravestoneAnnihilapesRoar, MSGBOX_AUTOCLOSE)
	waitmessage
    fadeinbgm(0)
}


