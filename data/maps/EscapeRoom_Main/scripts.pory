script EscapeRoom_MoveDeleterNPC{
    lockall
    faceplayer
    msgbox(AskDeleteMove, MSGBOX_DEFAULT)

    // ask menu: delete a move / restore moveset
    dynmultichoice(20, 8, FALSE, 6, 0, 0, 
    "Delete a move", 
    "Restore deleted moves")

    // standard move deleter script
    if(var(VAR_RESULT) == 0){
        call(EscapeRoom_ChooseMoveToDelete)
    }
    // restore moves
    elif(var(VAR_RESULT) == 1){
        call(EscapeRoom_RestoreMoveset)
    }
    // cancel or B press
    else{
        msgbox(MoveDeleterComeAgain, MSGBOX_AUTOCLOSE)
    }
    releaseall
}

script EscapeRoom_ChooseMoveToDelete{
	special(ChoosePartyMon)
	waitstate

    // end if no mon chosen
	if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        msgbox(MoveDeleterComeAgain, MSGBOX_AUTOCLOSE)
        releaseall
        end
    }

    // end if mon only has 1 move
    special(GetNumMovesSelectedMonHas)
    if (var(VAR_RESULT) == 1) {
        msgbox(MoveDeleterOnlyOneMove, MSGBOX_AUTOCLOSE)
        releaseall
        end
    }

    // end if no mon chosen
	if (var(VAR_MOVE_DELETER_CHOSEN_SLOT) == MAX_MON_MOVES) {
        msgbox(MoveDeleterComeAgain, MSGBOX_AUTOCLOSE)
        releaseall
        end
    }

    // buffer move and -- TODO: set move flag
    copyvar(VAR_0x8005, VAR_MOVE_DELETER_CHOSEN_SLOT)
    setvar(VAR_MOVE_DELETER_CHOSEN_SLOT, MAX_MON_MOVES)
    special(BufferMoveDeleterNicknameAndMove)

    // delete move
    special(MoveDeleterForgetMove)
    // playse(SE_SUCCESS)
    playse(SE_SHOP)
    waitse
    msgbox(MoveDeleterMoveDeleted, MSGBOX_AUTOCLOSE)
    end
}

script EscapeRoom_RestoreMoveset{
    // flag to detect if no moves were restored
    setflag(FLAG_TEMP_5)

    // --- POOCHYENA ---
    checkpartymon(SPECIES_POOCHYENA)
    if (var(VAR_RESULT) != PARTY_SIZE && flag(FLAG_POOCH_MOVE_DELETED) == TRUE)
    {
        // check if all moves have 0 pp
        // if true: set flag
        monhas0pp(SPECIES_POOCHYENA)
        if(var(VAR_RESULT) == TRUE){
            setflag(FLAG_MON_HAS_0_PP_WHEN_RESTORING)
        }

        if (flag(FLAG_ICE_FANG_DELETED) == TRUE)
        {
            addmonmove(SPECIES_POOCHYENA, MOVE_ICE_FANG)
            clearflag(FLAG_ICE_FANG_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_ICE_FANG_DELETED_0_PP)){
                setmonmove0pp(SPECIES_POOCHYENA, MOVE_ICE_FANG)
                clearflag(FLAG_ICE_FANG_DELETED_0_PP)
            }
        }

        if (flag(FLAG_SLEEP_TALK_DELETED) == TRUE)
        {
            addmonmove(SPECIES_POOCHYENA, MOVE_SLEEP_TALK)
            clearflag(FLAG_SLEEP_TALK_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_SLEEP_TALK_DELETED_0_PP)){
                setmonmove0pp(SPECIES_POOCHYENA, MOVE_SLEEP_TALK)
                clearflag(FLAG_SLEEP_TALK_DELETED_0_PP)
            }
        }

        if (flag(FLAG_ENDEAVOR_DELETED) == TRUE)
        {
            addmonmove(SPECIES_POOCHYENA, MOVE_ENDEAVOR)
            clearflag(FLAG_ENDEAVOR_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_ENDEAVOR_DELETED_0_PP)){
                setmonmove0pp(SPECIES_POOCHYENA, MOVE_ENDEAVOR)
                clearflag(FLAG_ENDEAVOR_DELETED_0_PP)
            }
        }

        if (flag(FLAG_TAUNT_DELETED) == TRUE)
        {
            addmonmove(SPECIES_POOCHYENA, MOVE_TAUNT)
            clearflag(FLAG_TAUNT_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_TAUNT_DELETED_0_PP)){
                setmonmove0pp(SPECIES_POOCHYENA, MOVE_TAUNT)
                clearflag(FLAG_TAUNT_DELETED_0_PP)
            }
        }

        call(EscapeRoom_MoveRestoredSound)
        msgbox(PoochMovesRestoredMessage, MSGBOX_DEFAULT)
        waitmessage
        clearflag(FLAG_POOCH_MOVE_DELETED)
        clearflag(FLAG_TEMP_5) // indicate that at least one move was restored
        clearflag(FLAG_MON_HAS_0_PP_WHEN_RESTORING)
    }

    // --- LIEPARD ---
    checkpartymon(SPECIES_LIEPARD)
    if (var(VAR_RESULT) != PARTY_SIZE && flag(FLAG_LIEPARD_MOVE_DELETED) == TRUE)
    {
        // check if all moves have 0 pp
        // if true: set flag
        monhas0pp(SPECIES_LIEPARD)
        if(var(VAR_RESULT) == TRUE){
            setflag(FLAG_MON_HAS_0_PP_WHEN_RESTORING)
        }

        if (flag(FLAG_ASSIST_DELETED) == TRUE)
        {
            addmonmove(SPECIES_LIEPARD, MOVE_ASSIST)
            clearflag(FLAG_ASSIST_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_ASSIST_DELETED_0_PP)){
                setmonmove0pp(SPECIES_LIEPARD, MOVE_ASSIST)
                clearflag(FLAG_ASSIST_DELETED_0_PP)
            }
        }

        if (flag(FLAG_ROCK_SMASH_DELETED) == TRUE)
        {
            addmonmove(SPECIES_LIEPARD, MOVE_ROCK_SMASH)
            clearflag(FLAG_ROCK_SMASH_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_ROCK_SMASH_DELETED_0_PP)){
                setmonmove0pp(SPECIES_LIEPARD, MOVE_ROCK_SMASH)
                clearflag(FLAG_ROCK_SMASH_DELETED_0_PP)
            }
        }

        if (flag(FLAG_ECHOED_VOICE_DELETED) == TRUE)
        {
            addmonmove(SPECIES_LIEPARD, MOVE_ECHOED_VOICE)
            clearflag(FLAG_ECHOED_VOICE_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_ECHOED_VOICE_DELETED_0_PP)){
                setmonmove0pp(SPECIES_LIEPARD, MOVE_ECHOED_VOICE)
                clearflag(FLAG_ECHOED_VOICE_DELETED_0_PP)
            }
        }

        if (flag(FLAG_TRICK_DELETED) == TRUE)
        {
            addmonmove(SPECIES_LIEPARD, MOVE_TRICK)
            clearflag(FLAG_TRICK_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_TRICK_DELETED_0_PP)){
                setmonmove0pp(SPECIES_LIEPARD, MOVE_TRICK)
                clearflag(FLAG_TRICK_DELETED_0_PP)
            }
        }

        call(EscapeRoom_MoveRestoredSound)
        msgbox(LiepardMovesRestoredMessage, MSGBOX_DEFAULT)
        waitmessage
        clearflag(FLAG_LIEPARD_MOVE_DELETED)
        clearflag(FLAG_TEMP_5)
        clearflag(FLAG_MON_HAS_0_PP_WHEN_RESTORING)
    }

    // --- DUNSPARCE ---
    checkpartymon(SPECIES_DUNSPARCE)
    if (var(VAR_RESULT) != PARTY_SIZE && flag(FLAG_DUNSPARCE_MOVE_DELETED) == TRUE)
    {
        // check if all moves have 0 pp
        // if true: set flag
        monhas0pp(SPECIES_DUNSPARCE)
        if(var(VAR_RESULT) == TRUE){
            setflag(FLAG_MON_HAS_0_PP_WHEN_RESTORING)
        }

        if (flag(FLAG_TRUMP_CARD_DELETED) == TRUE)
        {
            addmonmove(SPECIES_DUNSPARCE, MOVE_TRUMP_CARD)
            clearflag(FLAG_TRUMP_CARD_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_TRUMP_CARD_DELETED_0_PP)){
                setmonmove0pp(SPECIES_DUNSPARCE, MOVE_TRUMP_CARD)
                clearflag(FLAG_TRUMP_CARD_DELETED_0_PP)
            }
        }

        if (flag(FLAG_HEX_DELETED) == TRUE)
        {
            addmonmove(SPECIES_DUNSPARCE, MOVE_HEX)
            clearflag(FLAG_HEX_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_HEX_DELETED_0_PP)){
                setmonmove0pp(SPECIES_DUNSPARCE, MOVE_HEX)
                clearflag(FLAG_HEX_DELETED_0_PP)
            }
        }

        if (flag(FLAG_COUNTER_DELETED) == TRUE)
        {
            addmonmove(SPECIES_DUNSPARCE, MOVE_COUNTER)
            clearflag(FLAG_COUNTER_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_COUNTER_DELETED_0_PP)){
                setmonmove0pp(SPECIES_DUNSPARCE, MOVE_COUNTER)
                clearflag(FLAG_COUNTER_DELETED_0_PP)
            }
        }

        if (flag(FLAG_AIR_SLASH_DELETED) == TRUE)
        {
            addmonmove(SPECIES_DUNSPARCE, MOVE_AIR_SLASH)
            clearflag(FLAG_AIR_SLASH_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_AIR_SLASH_DELETED_0_PP)){
                setmonmove0pp(SPECIES_DUNSPARCE, MOVE_AIR_SLASH)
                clearflag(FLAG_AIR_SLASH_DELETED_0_PP)
            }
        }

        call(EscapeRoom_MoveRestoredSound)
        msgbox(DunsparceMovesRestoredMessage, MSGBOX_DEFAULT)
        waitmessage
        clearflag(FLAG_DUNSPARCE_MOVE_DELETED)
        clearflag(FLAG_TEMP_5)
        clearflag(FLAG_MON_HAS_0_PP_WHEN_RESTORING)
    }

    // --- SMEARGLE ---
    checkpartymon(SPECIES_SMEARGLE)
    if (var(VAR_RESULT) != PARTY_SIZE && flag(FLAG_SMEARGLE_MOVE_DELETED) == TRUE)
    {
        // check if all moves have 0 pp
        // if true: set flag
        monhas0pp(SPECIES_SMEARGLE)
        if(var(VAR_RESULT) == TRUE){
            setflag(FLAG_MON_HAS_0_PP_WHEN_RESTORING)
        }

        if (flag(FLAG_SURF_DELETED) == TRUE)
        {
            addmonmove(SPECIES_SMEARGLE, MOVE_SURF)
            clearflag(FLAG_SURF_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_SURF_DELETED_0_PP)){
                setmonmove0pp(SPECIES_SMEARGLE, MOVE_SURF)
                clearflag(FLAG_SURF_DELETED_0_PP)
            }
        }

        if (flag(FLAG_SWITCHEROO_DELETED) == TRUE)
        {
            addmonmove(SPECIES_SMEARGLE, MOVE_SWITCHEROO)
            clearflag(FLAG_SWITCHEROO_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_SWITCHEROO_DELETED_0_PP)){
                setmonmove0pp(SPECIES_SMEARGLE, MOVE_SWITCHEROO)
                clearflag(FLAG_SWITCHEROO_DELETED_0_PP)
            }
        }

        if (flag(FLAG_UPROAR_DELETED) == TRUE)
        {
            addmonmove(SPECIES_SMEARGLE, MOVE_UPROAR)
            clearflag(FLAG_UPROAR_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_UPROAR_DELETED_0_PP)){
                setmonmove0pp(SPECIES_SMEARGLE, MOVE_UPROAR)
                clearflag(FLAG_UPROAR_DELETED_0_PP)
            }
        }
        
        if (flag(FLAG_CONVERSION_2_DELETED) == TRUE)
        {
            addmonmove(SPECIES_SMEARGLE, MOVE_CONVERSION_2)
            clearflag(FLAG_CONVERSION_2_DELETED)
            if(flag(FLAG_MON_HAS_0_PP_WHEN_RESTORING) || flag(FLAG_CONVERSION_2_DELETED_0_PP)){
                setmonmove0pp(SPECIES_SMEARGLE, MOVE_CONVERSION_2)
                clearflag(FLAG_CONVERSION_2_DELETED_0_PP)
            }
        }

        call(EscapeRoom_MoveRestoredSound)
        msgbox(SmeargleMovesRestoredMessage, MSGBOX_DEFAULT)
        waitmessage
        clearflag(FLAG_SMEARGLE_MOVE_DELETED)
        clearflag(FLAG_TEMP_5)
        clearflag(FLAG_MON_HAS_0_PP_WHEN_RESTORING)
    }

    // no moves restored
    if (flag(FLAG_TEMP_5) == TRUE)
    {
        msgbox(NoMovesRestoredMessage, MSGBOX_AUTOCLOSE)
        clearflag(FLAG_TEMP_5)
    }
}

script EscapeRoom_MoveRestoredSound{
    delay(10)
    playse(SE_NOTE_E)
    delay(7)
    playse(SE_NOTE_G)
    delay(7)
    playse(SE_NOTE_C_HIGH)
    waitse
}

script EscapeRoom_UltraBallNPC{
    lockall
    faceplayer

    if(flag(FLAG_POKE_BALL_OBTAINED) == FALSE){
        // start quiz
        msgbox(UltraBallQuizStart, MSGBOX_DEFAULT)

        // TODO: quiz

        // give ultra ball
        giveitem(ITEM_ULTRA_BALL)
        setflag(FLAG_POKE_BALL_OBTAINED)
    }
    else{
        // post script message
        msgbox(UltaBallQuizPostScript, MSGBOX_NPC)

    }
    releaseall
}


//// RANDOM HINT NPCS ////

script EscapeRoom_AnnihilapeHintNPC{
    lockall

    // initial message
    if(flag(FLAG_ANNIHILAPE_HINT_RECEIVED) == FALSE){
        // standard message
        if(flag(FLAG_HIDE_ANNIHILAPE) == TRUE){
            msgbox(AnnihilapeHintNoMessage1, MSGBOX_AUTOCLOSE)
            waitmessage
            delay(20)
            faceplayer
            msgbox(AnnihilapeHintNoMessage2, MSGBOX_AUTOCLOSE)
            waitmessage
            applymovement(LOCALID_APE_HINT_NPC, face_npc_up)
            waitmovement(LOCALID_APE_HINT_NPC)
        }
        // if ape has spawned
        else{
            faceplayer

            // esclamation mark
            playse(SE_PIN)
            applymovement(LOCALID_APE_HINT_NPC, Common_Movement_ExclamationMark)
            waitmovement(LOCALID_APE_HINT_NPC)
            delay(30)

            msgbox(AnnihilapeHintMessage, MSGBOX_NPC)
            setflag(FLAG_ANNIHILAPE_HINT_RECEIVED)
        }
    }
    // post script message
    else{
        faceplayer
        msgbox(AnnihilapeHintMessagePostScript, MSGBOX_NPC)
    }
    releaseall
}

movement face_npc_up{
    face_up
}

script EscapeRoom_ZeraoraHintNPC{
    lockall
    if(flag(FLAG_ZERAORA_CAUGHT) == FALSE){
        msgbox(ZeraoraHintMessage, MSGBOX_NPC)
    }
    else{
        msgbox(ZeraoraHintPostCatchMessage, MSGBOX_NPC)
    }
    releaseall
}

script EscapeRoom_TabletsHintNPC{
    lockall
    if(flag(FLAG_MAP_SWITCH_4_FOUND) == FALSE){
        msgbox(FourTabletsHintMessage1, MSGBOX_NPC)
    }
    elif(flag(FLAG_MAP_SWITCHES_SOLVED) == FALSE){
        msgbox(FourTabletsHintMessage2, MSGBOX_NPC)
    }
    elif(flag(FLAG_CHOICE_SPECS_OBTAINED) == FALSE){
        msgbox(FourTabletsHintMessage3, MSGBOX_NPC)
    }
    else{
        msgbox(FourTabletsHintMessage4, MSGBOX_NPC)
    }
    releaseall
}


