    }

    if (flag(FLAG_GRAVESTONE_CHECK1) == FALSE &&
        flag(FLAG_GRAVESTONE_CHECK2) == FALSE &&
        flag(FLAG_GRAVESTONE_CHECK3) == FALSE){
        msgbox(GravestoneClick1Message, MSGBOX_AUTOCLOSE)
