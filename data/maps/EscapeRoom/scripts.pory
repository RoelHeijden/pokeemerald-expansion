script EscapeRoom_EventScript_DoubleBattle1{
    trainerbattle_double(
        TRAINER_MY_CUSTOM_DOUBLE_BATTLE1, 
        Double1Puzzle_Intro, 
        Double1Puzzle_Outro, 
        Double1Puzzle_NotEnoughMons,
        event_script=EscapeRoom_EventScript_Double1WalkAwayAndHeal,
    )
    msgbox(Double1Puzzle_PostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

script EscapeRoom_EventScript_Double1WalkAwayAndHeal{
    lockall
    msgbox(Double1Finalwords)
    waitmessage
    applymovement(1, EscapeRoom_Movement_Double1End)
    applymovement(2, EscapeRoom_Movement_Double1End)
    waitmovement(0)
    copyobjectxytoperm(1)
    copyobjectxytoperm(2)
    call(EscapeRoom_EventScript_PostMatchHeal)
    setflag(FLAG_DOUBLE1_COMPLETED)
    releaseall
    end
}

movement EscapeRoom_Movement_Double1End{
    walk_left * 3
    face_right
}

script EscapeRoom_EventScript_PostMatchHeal{
    // fadescreen(FADE_TO_BLACK)
    special(HealPlayerParty)
    // fadescreen(FADE_FROM_BLACK)
}

script EscapeRoom_EventScript_GetSitrusBerriesAndHeal{
    call(EscapeRoom_EventScript_PostMatchHeal)
    giveitem(ITEM_SITRUS_BERRY, 99)
}

script EscapeRoom_EventScript_BikeShop{
    lockall
    faceplayer
    msgbox(BikeShopHelloMessage)
    waitmessage
    pokemart(EscapeRoom_Mart_BikeShop)
    msgbox(BikeShoptGoodbyeMessage)
    waitmessage
    releaseall
    end
}

mart EscapeRoom_Mart_BikeShop{
    ITEM_MACH_BIKE
}

script EscapeRoom_EventScript_HeartscaleTutor{
    lockall
    faceplayer
    msgbox(MoveTutorStartMessage, MSGBOX_AUTOCLOSE)
    waitmessage
    checkitem(ITEM_HEART_SCALE)
    if(var(VAR_RESULT) == FALSE){
        msgbox(MoveTutorNoHeartScales, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    else{
        checkpartymove(MOVE_TRICK_ROOM)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_GARDEVOIR){  // player has Gardevoir
            msgbox(AskTeachGardevoirDisable, MSGBOX_YESNO)
            waitmessage
            if (var(VAR_RESULT) == YES){  // TEACH DISABLE
                checkpartymove(MOVE_TRICK_ROOM)
                if (var(VAR_RESULT) == 0){
                    setmonmove(0, 2, MOVE_DISABLE)
                }
                elif (var(VAR_RESULT) == 1){
                    setmonmove(1, 2, MOVE_DISABLE)
                }
                else{
                    msgbox("something went wrong.")
                    releaseall
                    end
                }
                removeitem(ITEM_HEART_SCALE, 1)
                playfanfare(MUS_LEVEL_UP)
                msgbox(GardevoirLearntDisable)
                waitmessage

                setflag(FLAG_DISABLE_TAUGHT)
                msgbox(MoveTutorTaughtDisable, MSGBOX_AUTOCLOSE)
                waitmessage
            }
            else{
                msgbox(MoveTutorTradeDeclined, MSGBOX_AUTOCLOSE)
                waitmessage
            }
        }
        else{  // player has no Gardevoir
            msgbox(MoveTutorNoSuitablePokemonMessage, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    releaseall
    end
}

script EscapeRoom_EventScript_CreepySilentNPC{
    lock
    faceplayer
    msgbox(SilentNPCMessage, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

script EscapeRoom_EventScript_PerishExplain_NPC{
    lockall
    faceplayer
    msgbox(PerishNPCexplain)
    waitmessage
    releaseall
}

script EscapeRoom_EventScript_EndEscapeRoomSign{
    lockall
    if(!flag(FLAG_END_ESCAPE_ROOM)){
        setflag(FLAG_END_ESCAPE_ROOM)
        playfanfare(MUS_OBTAIN_BADGE)
        msgbox(EscapeRoomEndCongratz)
        waitfanfare
    }
    else{
        msgbox(EscapeRoomEndCongratz)
        waitmessage
    }
    msgbox(EndEscapeRoomSignMessage)
    waitmessage
    releaseall
}

