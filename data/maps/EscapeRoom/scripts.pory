script EscapeRoom_EventScript_GoodSmeargle_NPC{
    lockall
    faceplayer
    if (flag(FLAG_OBTAINED_PERFECT_SMEARGLE)){
        msgbox(SmeargleMessageCompleted)
        waitmessage
        releaseall
        end
    }

    // no smeargle in party
    checkpartymon(SPECIES_SMEARGLE)
    if(var(VAR_RESULT) == PARTY_SIZE){
        msgbox(SmeargleMessageInitial)
        waitmessage
        releaseall
        end
    }
    // a smeargle caught
    else{
        // set var to 1 if perfect smeargle caught
        checkpartymove(MOVE_SKETCH)
        setvar(VAR_0x8001, 0)
        if(var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){
            setvar(VAR_0x8001, 1)
        }
        checkpartymove(MOVE_PROTECT)
        if(var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){
            setvar(VAR_0x8001, 1)
        }

        // set var to 1 if no second pokemon in party
        getpartysize
        setvar(VAR_0x8000, 0)
        if(var(VAR_RESULT) < 2){ 
            setvar(VAR_0x8000, 1)
        }

        // perfect smeargle
        if(var(VAR_0x8001) == 1 && var(VAR_0x8000) == 0){
            msgbox(SmeargleMessagePerfect, MSGBOX_YESNO)
            waitmessage
            call(EscapeRoom_EventScript_IniitializeGardevoirTrade)
            releaseall
            end
        }

        // perfect smeargle, but starter pokemon in box
        if(var(VAR_0x8001) == 1 && var(VAR_0x8000) == 1){
            msgbox(SmeargleMessagePerfectButToxicroakInBox)
            waitmessage
            releaseall
            end
        }

        // bad smeargle
        if(var(VAR_0x8001) == 0){
            msgbox(SmeargleMessageBad, MSGBOX_YESNO)

            // trade accepted
            if (var(VAR_RESULT) == YES){

                // if starter has fainted
                partymonhasfainted
                if (var(VAR_0x8004) == SPECIES_TOXICROAK){
                    msgbox(SmeargleReleaseHealSecondMonMessage, MSGBOX_AUTOCLOSE)
                    waitmessage
                }
                // if starter in box
                elif(var(VAR_0x8000) == 1){
                    msgbox(SmeargleReleaseGetSecondMonMessage, MSGBOX_AUTOCLOSE)
                    waitmessage
                }
                // release smeargle
                else{
                    removemon(SPECIES_SMEARGLE)
                    clearflag(FLAG_POKEMON_CAUGHT)
                    clearflag(FLAG_GREAT_BALL_USED)
                    giveitem(ITEM_GREAT_BALL)

                    checkpartyitem(0)
                    if(var(VAR_0x8004) == ITEM_FLAME_ORB) {
                        removepartyitem(0)
                    }
                    removeitem(ITEM_FLAME_ORB)

                    msgbox(ReleaseSmeargleMessage, MSGBOX_AUTOCLOSE)
                    waitmessage
                }
            }
            // trade declined
            else{
                msgbox(SmeargleReleaseDeclinedMessage, MSGBOX_AUTOCLOSE)
                waitmessage
            }
        }
        releaseall
        end
    }
}

script EscapeRoom_EventScript_IniitializeGardevoirTrade{
    if(var(VAR_RESULT) == YES){
        removemon(SPECIES_TOXICROAK)
        givemon(
            SPECIES_GARDEVOIR, 
            30, 
            abilityNum=0,
            // item=ITEM_NUGGET
            nature=7, // Relaxed 
            move1=MOVE_TRICK_ROOM,
            move2=MOVE_SKILL_SWAP, 
            move3=MOVE_NONE, 
            move4=MOVE_NONE,
            // EVS:
            hpEv=132,
            defEv=212,
            spDefEv=164,
            // IVS:
            hpIv=31,
            atkIv=0,
            defIv=31,
            speedIv=10,
            spAtkIv=31,
            spDefIv=31,
        )
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox(GardevoirObtainedMessage, MSGBOX_AUTOCLOSE)
        waitfanfare
        msgbox(TradeAcceptedMessage, MSGBOX_AUTOCLOSE)
        setflag(FLAG_OBTAINED_PERFECT_SMEARGLE)
    }
    else{
        msgbox(TradeDeclinedMessage)
    }
}

