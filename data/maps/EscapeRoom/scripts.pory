
////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: CaveHole_FixCrackedGround
    MAP_SCRIPT_ON_RESUME: EscapeRoom_MapScripts_SetHoleWarp
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 0: EscapeRoom_MapScripts_PlayStartMessage
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 1: EscapeRoom_MapScripts_GetFirstPokemon
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 2: EscapeRoom_MapScripts_GetBadges
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 3: EscapeRoom_MapScripts_SetRespawn
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 4: EscapeRoom_MapScripts_GetItems
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 5: EscapeRoom_MapScripts_TurnOfBagUse
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 6: EscapeRoom_MapScripts_FixCrackedGround
        VAR_ICE_STEP_COUNT, 0: EventScript_FallDownHole
    ] 
}

script EscapeRoom_MapScripts_SetHoleWarp{
    setstepcallback(STEP_CB_CRACKED_FLOOR)
    setholewarp(MAP_ESCAPE_ROOM_ICE_PUZZLE)
}

script EscapeRoom_MapScripts_FixCrackedGround{
    setvar(VAR_ICE_STEP_COUNT, 1)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 7)
}

script EscapeRoom_MapScripts_PlayStartMessage{
    lockall
    msgbox(StartMessage)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 1)
    releaseall
}

script EscapeRoom_MapScripts_GetFirstPokemon{
    givemon(
        SPECIES_GOTHITA, 
        30, 
        item=ITEM_HEART_SCALE,
        abilityNum=2,
        nature=11, // Hasty 
        move1=MOVE_THIEF,
        move2=MOVE_HELPING_HAND, 
        move3=MOVE_NONE, 
        move4=MOVE_NONE,
        // EVS:
        speedEv=236,
        // IVS:
        hpIv=0,
        atkIv=31,
        defIv=0,
        speedIv=31,
        spAtkIv=31,
        spDefIv=31,
        )
    setflag(FLAG_SYS_POKEMON_GET)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 2)
}

script EscapeRoom_MapScripts_GetBadges{
    setflag(FLAG_DEFEATED_RUSTBORO_GYM)
    setflag(FLAG_BADGE01_GET)
    setflag(FLAG_DEFEATED_DEWFORD_GYM)
    setflag(FLAG_BADGE02_GET)
    setflag(FLAG_DEFEATED_MAUVILLE_GYM)
    setflag(FLAG_BADGE03_GET)
    setflag(FLAG_DEFEATED_LAVARIDGE_GYM)
    setflag(FLAG_BADGE04_GET)
    setflag(FLAG_DEFEATED_PETALBURG_GYM)
    setflag(FLAG_BADGE05_GET)
    setflag(FLAG_DEFEATED_FORTREE_GYM)
    setflag(FLAG_BADGE06_GET)
    setflag(FLAG_DEFEATED_MOSSDEEP_GYM)
    setflag(FLAG_BADGE07_GET)
    setflag(FLAG_DEFEATED_SOOTOPOLIS_GYM)
    setflag(FLAG_BADGE08_GET)

    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 3)
    end
}

script EscapeRoom_MapScripts_SetRespawn{
    setrespawn(HEAL_LOCATION_ESCAPE_ROOM_NURSE)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 4)
}

script EscapeRoom_MapScripts_GetItems{
    additem(ITEM_IRON_BALL)
    additem(ITEM_MACH_BIKE)
    additem(ITEM_NUGGET, 14)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 5)
}

script EscapeRoom_MapScripts_TurnOfBagUse{
    if (flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 6)
}


////////////////////////////////////////// EVENT SCRIPTS //////////////////////////////////////////


script EscapeRoom_EventScript_TestSign {
    lockall
    msgbox(SignMessage1)
    waitmessage
    releaseall
}

script EscapeRoom_Nurse_Heal_Pokemon{
    lockall
    fadescreen(FADE_TO_BLACK)
	special(HealPlayerParty)
	fadescreen(FADE_FROM_BLACK)
    msgbox(Nurse_Heal_End)
    waitmessage
    releaseall
}

script EscapeRoom_Wild_Smeargle{
    if (flag(FLAG_TOGGLE_BAG_USE) == TRUE){
        clearflag(FLAG_TOGGLE_BAG_USE)
    }
    createmon(
        side=1,
        slot=0,
        species=SPECIES_SMEARGLE,
        level=20,
        abilityNum=0,
        nature=7, // Bold 
        move1=MOVE_SKETCH,
        move2=MOVE_NONE, 
        move3=MOVE_NONE, 
        move4=MOVE_NONE,
        // EVS:
        defEv=208,
        // IVS:
        hpIv=11,
        atkIv=0,
        defIv=31,
        speedIv=0,
        spAtkIv=31,
        spDefIv=31,
    )
    dowildbattle
    setflag(FLAG_TOGGLE_BAG_USE)
}

script EscapeRoom_Wild_Shedinja{
    if (flag(FLAG_TOGGLE_BAG_USE) == TRUE){
        clearflag(FLAG_TOGGLE_BAG_USE)
    }
    createmon(
        side=1,
        slot=0,
        species=SPECIES_SHEDINJA,
        level=10,
        item=ITEM_FLAME_ORB, 
        move1=MOVE_PROTECT,
        move2=MOVE_NONE, 
        move3=MOVE_NONE, 
        move4=MOVE_NONE,
    )
    dowildbattle
    setflag(FLAG_TOGGLE_BAG_USE)
}

script EscapeRoom_EventScript_DoubleBattle1{
    trainerbattle_double(
        TRAINER_MY_CUSTOM_DOUBLE_BATTLE1, 
        Double1Puzzle_Intro, 
        Double1Puzzle_Outro, 
        Double1Puzzle_NotEnoughMons,
        event_script=EscapeRoom_EventScript_PostDouble1Heal,
    )
    msgbox(Double1Puzzle_PostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

script EscapeRoom_EventScript_PostDouble1Heal{
    msgbox(Double1Puzzle_Heal, MSGBOX_AUTOCLOSE)
    fadescreen(FADE_TO_BLACK)
    special(HealPlayerParty)
    fadescreen(FADE_FROM_BLACK)
}

script EscapeRoom_EventScript_PostSingle2Heal{
    msgbox(Single2Puzzle_Heal, MSGBOX_AUTOCLOSE)
    fadescreen(FADE_TO_BLACK)
    special(HealPlayerParty)
    fadescreen(FADE_FROM_BLACK)
}

script EscapeRoom_EventScript_FindRareCandy{
    lockall
    giveitem(ITEM_RARE_CANDY)
    removeobject(1)
    setflag(FLAG_RARE_CANDY_OBTAINED)
    releaseall
}

script EscapeRoom_EventScript_FindNugget2{
    lockall
    giveitem(ITEM_NUGGET)
    removeobject(1)
    setflag(FLAG_NUGGET2_OBTAINED)
    releaseall
}

script EscapeRoom_EventScript_FindNugget3{
    lockall
    giveitem(ITEM_NUGGET)
    removeobject(1)
    setflag(FLAG_NUGGET3_OBTAINED)
    releaseall
}

script EscapeRoom_EventScript_GoodSmeargle_NPC{
    lockall
    faceplayer
    if (flag(FLAG_OBTAINED_PERFECT_SMEARGLE)){
        msgbox(SmeargleMessageCompleted)
        waitmessage
        releaseall
        end
    }
    getpartysize
    if (var(VAR_RESULT) < 2){  # no extra pokemon was caught
        checkpartymove(MOVE_THIEF)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_GOTHITA){  // mon is Gothita
            msgbox(SmeargleMessageInitial)
            waitmessage
            releaseall
            end
        }
        checkpartymove(MOVE_PROTECT)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SHEDINJA){  // mon is Shedinja
            msgbox(SmeargleMessageInitial)
            waitmessage
            releaseall
            end
        }
        checkpartymove(MOVE_SKETCH)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){   # Smeargle has Sketch
            msgbox(SmeargleMessagePerfectButGothitaInBox)
            waitmessage
            releaseall
            end
        }
        checkpartymove(MOVE_PROTECT)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Protect
            msgbox(SmeargleMessagePerfectButGothitaInBox)
            waitmessage
            releaseall
            end
        }
    }
    else{  // user has a second pokemon
        checkpartymove(MOVE_SKETCH)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Sketch
            msgbox(SmeargleMessagePerfect, MSGBOX_YESNO)
            waitmessage
            call(EscapeRoom_EventScript_IniitializeGardevoirTrade)
            releaseall
            end
        }
        checkpartymove(MOVE_PROTECT)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Protect
            msgbox(SmeargleMessagePerfect, MSGBOX_YESNO)
            waitmessage
            call(EscapeRoom_EventScript_IniitializeGardevoirTrade)
            releaseall
            end
        }
    }
    msgbox(SmeargleMessageBad)
    waitmessage
    releaseall
    end 
}

script EscapeRoom_EventScript_IniitializeGardevoirTrade{
    if(var(VAR_RESULT) == YES){
        checkpartymove(MOVE_HELPING_HAND)
        if (var(VAR_RESULT) == 0){
            createmon(
                0, // side
                0, // slot
                SPECIES_GARDEVOIR, 
                30, 
                abilityNum=0,
                item=ITEM_NUGGET
                nature=5, // Bold 
                move1=MOVE_TRICK_ROOM,
                move2=MOVE_SKILL_SWAP, 
                move3=MOVE_NONE, 
                move4=MOVE_NONE,
                // EVS:
                hpEv=132,
                defEv=212,
                speedEv=52,
                // IVS:
                hpIv=31,
                atkIv=0,
                defIv=31,
                speedIv=31,
                spAtkIv=31,
                spDefIv=31,
            )
        }
        elif (var(VAR_RESULT) == 1){
            createmon(
                0, // side
                1, // slot
                SPECIES_GARDEVOIR, 
                30, 
                abilityNum=0,
                item=ITEM_NUGGET
                nature=5, // Bold 
                move1=MOVE_TRICK_ROOM,
                move2=MOVE_SKILL_SWAP, 
                move3=MOVE_NONE, 
                move4=MOVE_NONE,
                // EVS:
                hpEv=132,
                defEv=212,
                speedEv=52,
                // IVS:
                hpIv=31,
                atkIv=0,
                defIv=31,
                speedIv=31,
                spAtkIv=31,
                spDefIv=31,
            )
        }
        else{
            msgbox("something has gone wrong")
            end
        }

        playfanfare(MUS_OBTAIN_ITEM)
        msgbox("Received Gardevoir") // REPLACE
        msgbox(TradeAcceptedMessage)
        setflag(FLAG_OBTAINED_PERFECT_SMEARGLE)
    }
    else{
        msgbox(TradeDeclinedMessage)
    }
}
    
