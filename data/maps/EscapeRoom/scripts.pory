    )
    call(EscapeRoom_EventScript_TeleportBackOverLedge)
    end
}

script EscapeRoom_EventScript_TeleportBackOverLedge{
    // check if item stolen
    lockall
    if(flag(FLAG_TOXIC_ORB_STOLEN) == TRUE){
        msgbox(Single3Puzzle_PostBattleStolen, MSGBOX_YESNO)
    }
    else{
        msgbox(Single3Puzzle_PostBattleNotStolen, MSGBOX_YESNO)
    }
    if(var(VAR_RESULT) == YES){
        // teleport out
        msgbox(YesTeleportOutMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        warpteleport(MAP_ESCAPE_ROOM, 11, 25)

        // heal party
        special(HealPlayerParty)

        // return money
        removemoney(78999)

        // reset trainer flag
        cleartrainerflag(TRAINER_MY_CUSTOM_SINGLE_BATTLE3)

        // set smeargle final gambit to sketch if it has the move
        checkpartymove(MOVE_FINAL_GAMBIT)
        if(var(VAR_RESULT) != PARTY_SIZE){
            setvar(VAR_TEMP_0, MOVE_FINAL_GAMBIT)
            setvar(VAR_TEMP_1, MOVE_SKETCH)
            replacemove(VAR_RESULT, VAR_TEMP_0, VAR_TEMP_1)
        }

        // set smeargle mimic to sketch if it has the move
        checkpartymove(MOVE_MIMIC)
        if(var(VAR_RESULT) != PARTY_SIZE){
            setvar(VAR_TEMP_0, MOVE_MIMIC)
            setvar(VAR_TEMP_1, MOVE_SKETCH)
            replacemove(VAR_RESULT, VAR_TEMP_0, VAR_TEMP_1)
        }

        // if item was stolen
        if(flag(FLAG_TOXIC_ORB_STOLEN) == TRUE){
            // locate and return item    
            checkpartyitem(0)
            if(var(VAR_0x8004) == ITEM_TOXIC_ORB) {  // if item in party slot 0
                removepartyitem(0)
            }
            checkpartyitem(1)
            if(var(VAR_0x8004) == ITEM_TOXIC_ORB) {  // if item in party slot 1
                removepartyitem(1)
            }
            removeitem(ITEM_TOXIC_ORB)

            // reset item stolen flag
            clearflag(FLAG_TOXIC_ORB_STOLEN)
        }
    }
    else{
        msgbox(NoTeleportPleaseMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
}

