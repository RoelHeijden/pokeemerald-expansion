script EscapeRoom_EventScript_EndEscapeRoomSign{
    lockall
    if(!flag(FLAG_END_ESCAPE_ROOM)){
        setflag(FLAG_END_ESCAPE_ROOM)
        playfanfare(MUS_OBTAIN_BADGE)
        msgbox(EscapeRoomEndCongratz)
        waitfanfare
    }
    else{
        msgbox(EscapeRoomEndCongratz)
        waitmessage
    }
    msgbox(EndEscapeRoomSignMessage)
    waitmessage
    releaseall
}


