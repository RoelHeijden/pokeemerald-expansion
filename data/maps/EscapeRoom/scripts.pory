script EscapeRoom_EventScript_HeartscaleTutor{
    lockall
    faceplayer
    checkitem(ITEM_HEART_SCALE)

    // no heart scales
    if(var(VAR_RESULT) == FALSE && !flag(FLAG_TUTOR_MOVE_LEARNED)){
        msgbox(MoveTutorStartMessage)
        msgbox(MoveTutorNoHeartScales, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    // no heart scales but already learned a tutor move
    elif(var(VAR_RESULT) == FALSE && flag(FLAG_TUTOR_MOVE_LEARNED)){

        checktutormoveslearned(SPECIES_GARDEVOIR)
        if(var(VAR_0x8004) == MOVE_NONE && var(VAR_RESULT) != MOVE_NONE){  // Gardevoir in party with exactly one tutor move
            msgbox(MoveTutorReplaceSingleMove, MSGBOX_YESNO)
        }
        else{
            msgbox(MoveTutorReplaceMove, MSGBOX_YESNO)
        }
        waitmessage
        if (var(VAR_RESULT) == YES){

            // check if player has Gardevoir
            checkpartymon(SPECIES_GARDEVOIR)
            copyvar(VAR_TEMP_0, VAR_RESULT) // store pokemon slot
            if (var(VAR_RESULT) != PARTY_SIZE){

                // get tutor moves learned
                checktutormoveslearned(SPECIES_GARDEVOIR)
                copyvar(VAR_0x800A, VAR_RESULT)
                copyvar(VAR_0x800B, VAR_0x8004)

                // choose move if two tutor moves learned
                if(var(VAR_0x800B) != MOVE_NONE){
                    msgbox(MoveTutorWhichMoveReplaceMessage, MSGBOX_REPLACEMOVE)
                    if(var(VAR_RESULT) == 0){ // top option
                        copyvar(VAR_0x800A, VAR_0x800A) // set VAR_0x800A as chosen move -- so it's excluded in TeachMoveRelearnerMove script
                    }
                    elif(var(VAR_RESULT) == 1){ // bottom option
                        copyvar(VAR_0x800A, VAR_0x800B) // set VAR_0x800A as chosen move -- so it's excluded in TeachMoveRelearnerMove script
                    }
                    elif(var(VAR_RESULT) == 127){ // B pressed
                        msgbox(MoveTutorTradeDeclined, MSGBOX_AUTOCLOSE)
                        waitmessage
                        releaseall
                        end
                    }
                }
                // remove move
                setvar(VAR_TEMP_1, MOVE_NONE)
                replacemove(VAR_TEMP_0, VAR_0x800A, VAR_TEMP_1)

                // learn new move
                copyvar(VAR_0x8004, VAR_TEMP_0) // set pokemon slot in VAR_0x8004 for TeachMoveRelearnerMove script
                special(TeachMoveRelearnerMove)
                waitstate
                lockall

                // declined
                if(var(VAR_0x8004) == 0){
                    msgbox(MoveTutorTradeDeclined, MSGBOX_AUTOCLOSE)
                    waitmessage 

                    // find pokemon slot
                    checkpartymon(SPECIES_GARDEVOIR)
                    copyvar(VAR_TEMP_0, VAR_RESULT) // store pokemon slot
                    setvar(VAR_TEMP_1, MOVE_NONE)


                    // add old move back
                    replacemove(VAR_TEMP_0, VAR_TEMP_1, VAR_0x800A)
                }
                // accepted
                else{
                    msgbox(MoveTutorTaughtMove, MSGBOX_AUTOCLOSE)
                    waitmessage
                }
            }
            else{
                msgbox(MoveTutorBringReplaceMonMessage, MSGBOX_AUTOCLOSE)
                waitmessage
            }
        }
        else{
            msgbox(MoveTutorTradeDeclined, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    else{
        msgbox(MoveTutorStartMessage)
        // check if player has Gardevoir
        checkpartymon(SPECIES_GARDEVOIR)
        if (var(VAR_RESULT) != PARTY_SIZE){
            copyvar(VAR_0x8004, VAR_RESULT) // set pokemon slot
            msgbox(AskTeachGardevoirDisable, MSGBOX_YESNO)

            // learn move
            if (var(VAR_RESULT) == YES){
                setvar(VAR_0x800A, MOVE_NONE) // this var gets the previously learned move in the no-heart-scale script above
                special(TeachMoveRelearnerMove)
                waitstate
                lockall

                // declined
                if(var(VAR_0x8004) == 0){
                    msgbox(MoveTutorTradeDeclined, MSGBOX_AUTOCLOSE)
                    waitmessage 
                }
                // accepted
                else{
                    msgbox(MoveTutorTaughtMove, MSGBOX_AUTOCLOSE)
                    waitmessage
                    removeitem(ITEM_HEART_SCALE, 1)
                    setflag(FLAG_TUTOR_MOVE_LEARNED)
                }
            }
            // declined
            else{
                msgbox(MoveTutorTradeDeclined, MSGBOX_AUTOCLOSE)
                waitmessage
            }
        }
        // player has no Gardevoir
        else{  
            msgbox(MoveTutorNoSuitablePokemonMessage, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    releaseall
    end
}

