
////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: EscapeRoom_MapScript_OnTransitionScripts
    MAP_SCRIPT_ON_RESUME: EscapeRoom_MapScript_OnResumeScripts

    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_WARP_COUNTER, 0: EscapeRoom_MapScript_OnWarpIntoScripts
    ]

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 0: EscapeRoom_MapScripts_PlayStartMessage
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 1: EscapeRoom_MapScripts_GetFirstPokemon
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 2: EscapeRoom_MapScripts_GetBadges
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 3: EscapeRoom_MapScripts_SetRespawn
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 4: EscapeRoom_MapScripts_GetItems
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 5: EscapeRoom_MapScripts_TurnOfBagUse
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 6: EscapeRoom_MapScripts_FixCrackedGround
        VAR_ICE_STEP_COUNT, 0: EventScript_FallDownHole
        VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1: EscapeRoom_MapScripts_FindGreatBallAferUse
        VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_PECHA, 1: EscapeRoom_MapScripts_FindPechaBerryAferUse
    ] 
}


script EscapeRoom_MapScript_OnTransitionScripts{
    call(EscapeRoom_MapScript_KeepDouble1Moved)
    call(CaveHole_FixCrackedGround)
}


script EscapeRoom_MapScript_OnResumeScripts{
    // set cracked hole map location
    call(EscapeRoom_MapScripts_SetHoleWarp)

    // check if pokemon caught -- sets flag if true
    call(EscapeRoom_MapScripts_CheckIfMonCaught)

    // check if tm 10 succesfully stolen
    if(flag(FLAG_TM_10_STOLEN) == FALSE){
        call(EscapeRoom_MapScript_checkTM10stolen)
    }
    // check for great ball return
    call(EscapeRoom_MapScripts_CheckAfterBattleGreatBall)

    // check for berry return
    call(EscapeRoom_MapScripts_CheckAfterBattlePecha)

    // check for party heal
    call(EscapeRoom_MapScripts_CheckAfterBattleHeal)

    // set flags used for hints
    call(EscapeRoom_MapScript_CheckHintFlags)

    // disable bag use 
    if(flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
} 

script EscapeRoom_MapScript_OnWarpIntoScripts{
    // set NPC facing
    call(EscapeRoom_MapScript_setNPCfacing)

    // check for HM strengh stolen
    call(EscapeRoom_MapScript_checkHMRockSmash)

    // clear offscreen object unload flag
    clearflag(FLAG_DONT_REMOVE_OFFSCREEN_OBJECT)
}

script EscapeRoom_MapScript_CheckHintFlags{
    // PECHA BERRY
    checkitem(ITEM_PECHA_BERRY)
    if(var(VAR_RESULT) == TRUE) {
        setflag(FLAG_PECHA_BERRY_FOUND)
    }
    checkpartyitem(0)
    if(var(VAR_0x8005) == ITEM_PECHA_BERRY) {
        setflag(FLAG_PECHA_BERRY_FOUND)
    }
    checkpartyitem(1)
    if(var(VAR_0x8005) == ITEM_PECHA_BERRY) {
        setflag(FLAG_PECHA_BERRY_FOUND)
    }

    // GREAT BALL
    checkitem(ITEM_GREAT_BALL)
    if(var(VAR_RESULT) == TRUE) {
        setflag(FLAG_GREAT_BALL_FOUND)
    }
    checkpartyitem(0)
    if(var(VAR_0x8005) == ITEM_GREAT_BALL) {
        setflag(FLAG_GREAT_BALL_FOUND)
    }

    // SITRUS BERRY
    checkitem(ITEM_SITRUS_BERRY)
    if(var(VAR_RESULT) == TRUE) {
        setflag(FLAG_SITRUS_STOLEN)
    }
    checkpartyitem(0)
    if(var(VAR_0x8005) == ITEM_SITRUS_BERRY) {
        setflag(FLAG_SITRUS_STOLEN)
    }
    checkpartyitem(1)
    if(var(VAR_0x8005) == ITEM_SITRUS_BERRY) {
        setflag(FLAG_SITRUS_STOLEN)
    }
}

script EscapeRoom_MapScript_checkTM10stolen{
    checkitem(ITEM_TM10) // in bag
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_TM_10_STOLEN)
    }
    checkpartyitem(0) // held by pokemon
    if(var(VAR_0x8005) == ITEM_TM10) {
        setflag(FLAG_TM_10_STOLEN)
    }
}

script EscapeRoom_MapScript_checkHMRockSmash{
    if(flag(FLAG_HM_ROCK_SMASH_STOLEN) == TRUE){
        setflag(FLAG_HM06_STEAL_SUCCES)
    }
}

script EscapeRoom_MapScripts_CheckAfterBattleHeal{
    // check if all pokemon fainted
    checkentirepartyfainted
    if(var(VAR_RESULT) == TRUE && flag(FLAG_SYS_POKEMON_GET)){
        setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_HEAL_IF_ALL_FAINTED, 1)
    }
}

script EscapeRoom_MapScripts_CheckIfMonCaught{
    getpartysize
    if (var(VAR_RESULT) >= 2){
        setflag(FLAG_POKEMON_CAUGHT)
    }
}

script EscapeRoom_MapScripts_CheckAfterBattleGreatBall{
    if(flag(FLAG_GREAT_BALL_USED) && !flag(FLAG_POKEMON_CAUGHT)){
        // set var to retrieve great ball
        setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 1)
    }
}

script EscapeRoom_MapScripts_CheckAfterBattlePecha{
    // check if berry 'use' was clicked
    if(flag(FLAG_PECHA_BERRY_USED) && !flag(FLAG_POKEMON_CAUGHT)){
        // check if berry in bag
        checkitem(ITEM_PECHA_BERRY)
        if(var(VAR_RESULT) == FALSE) {
            // check if berry carried by pokemon in slot 0
            checkpartyitem(0)
            if(var(VAR_0x8005) != ITEM_PECHA_BERRY) {
                // set var to retrieve pecha
                setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_PECHA, 1)
            }
        }
    }
}

script EscapeRoom_MapScripts_FindPechaBerryAferUse{
    lockall
    msgbox(NewPechaBerryMessage, MSGBOX_AUTOCLOSE)
    waitmessage
    finditem(ITEM_PECHA_BERRY)
    clearflag(FLAG_PECHA_BERRY_USED)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_PECHA, 0)
    msgbox(ThanksMomMessage, MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}

script EscapeRoom_MapScripts_FindGreatBallAferUse{
    lockall
    msgbox(NewGreatBallMessage, MSGBOX_AUTOCLOSE)
    waitmessage
    finditem(ITEM_GREAT_BALL)
    clearflag(FLAG_GREAT_BALL_USED)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_RETRIEVE_BALL, 0)
    releaseall
}

script EscapeRoom_MapScripts_SetHoleWarp{
    setstepcallback(STEP_CB_CRACKED_FLOOR)
    setholewarp(MAP_ESCAPE_ROOM_ICE_PUZZLE)
}

script EscapeRoom_MapScripts_FixCrackedGround{
    setvar(VAR_ICE_STEP_COUNT, 1)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 7)
}

script EscapeRoom_MapScript_setNPCfacing{
    turnobject(8, DIR_SOUTH) // mart npc
    turnobject(9, DIR_EAST) // tutor
    turnobject(10, DIR_NORTH) // misdirection
    turnobject(11, DIR_SOUTH) // perf smeargle
    turnobject(12, DIR_WEST) // nugget
    turnobject(13, DIR_WEST) // ice cave
    turnobject(14, DIR_EAST) // asshole
    turnobject(16, DIR_SOUTH) // salazzle
}

script EscapeRoom_MapScript_KeepDouble1Moved {
    if(flag(FLAG_DOUBLE1_COMPLETED)){
        setobjectxyperm(1, 6, 12)
        setobjectxyperm(2, 6, 11)
    }
}

script EscapeRoom_MapScripts_PlayStartMessage{
    lockall
    // msgbox(StartMessage)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 1)
    releaseall
}

script EscapeRoom_MapScripts_GetFirstPokemon{
    givemon(
        SPECIES_TOXICROAK, 
        53, 
        item=ITEM_HEART_SCALE,
        abilityNum=1,
        nature=4, // naughty 
        gender=0,
        move1=MOVE_THIEF,
        move2=MOVE_ROLE_PLAY, 
        move3=MOVE_SUNNY_DAY, 
        move4=MOVE_NONE,
        // EVS:
        hpEv=8,
        atkEv=252,
        spAtkEv=160,
        // IVS:
        hpIv=31,
        atkIv=31,
        defIv=0,
        speedIv=30,
        spAtkIv=30,
        spDefIv=0,
        )
    setflag(FLAG_SYS_POKEMON_GET)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 2)
}

