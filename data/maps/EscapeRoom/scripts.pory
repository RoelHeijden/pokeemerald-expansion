script EscapeRoom_EventScript_TeleportBackOverLedge{
    lockall
    msgbox(Single3Puzzle_PostBattle, MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES)
    {
        msgbox(YesTeleportOutMessage, MSGBOX_AUTOCLOSE)
        waitmessage

        // heal party
        special(HealPlayerParty)

        // return money
        removemoney(99999)

        // reset trainer flag
        cleartrainerflag(TRAINER_MY_CUSTOM_SINGLE_BATTLE3)

        // set smeargle final gambit to sketch if it has the move
        checkpartymove(MOVE_FINAL_GAMBIT)
        if(var(VAR_RESULT) != PARTY_SIZE){
            setvar(VAR_TEMP_0, MOVE_FINAL_GAMBIT)
            setvar(VAR_TEMP_1, MOVE_SKETCH)
            replacemove(VAR_RESULT, VAR_TEMP_0, VAR_TEMP_1)
        }

        // set smeargle mimic to sketch if it has the move
        checkpartymove(MOVE_MIMIC)
        if(var(VAR_RESULT) != PARTY_SIZE){
            setvar(VAR_TEMP_0, MOVE_MIMIC)
            setvar(VAR_TEMP_1, MOVE_SKETCH)
            replacemove(VAR_RESULT, VAR_TEMP_0, VAR_TEMP_1)
        }

        // return HM if not yet stolen outside of the softlock
        if(flag(FLAG_HM06_STEAL_SUCCES) == FALSE){
            // locate and return item    
            checkpartyitem(0)
            if(var(VAR_0x8005) == ITEM_HM06) {  // if item in party slot 0
                removepartyitem(0)
            }
            checkpartyitem(1)
            if(var(VAR_0x8005) == ITEM_HM06) {  // if item in party slot 1
                removepartyitem(1)
            }
            removeitem(ITEM_HM06)
        }
        // remove duplicate held item TM if already succesfully stolen before
        else{
            checkitem(ITEM_HM06)
            if(var(VAR_RESULT) == TRUE){
                checkpartyitem(0)
                if(var(VAR_0x8005) == ITEM_HM06) {  // if item in party slot 0
                    removepartyitem(0)
                }
                checkpartyitem(1)
                if(var(VAR_0x8005) == ITEM_HM06) {  // if item in party slot 1
                    removepartyitem(1)
                }
            }
        } 

        // reset item stolen flag
        clearflag(FLAG_HM_ROCK_SMASH_STOLEN)

        // teleport out
        warpteleport(MAP_ESCAPE_ROOM, 11, 26)
    }
    else{
        msgbox(NoTeleportPleaseMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
}

