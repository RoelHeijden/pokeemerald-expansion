script EscapeRoom_EventScript_AntiSoftlockGuy{
    faceplayer
    lockall

    // SMEARGLE RELEASE
    // if pokemon caught
    if(flag(FLAG_POKEMON_CAUGHT)){
        // if Gardevoir trade has not happened
        if(flag(FLAG_GARDEVOIR_TRADE_SUCCESS) == FALSE){
            call(EscapeRoom_EventScript_UndoSmeargleCatch)
            releaseall
            end
        }
    }

    // RARE CANDY UNDO
    // if rare candy used
    if(flag(FLAG_RARE_CANDY_USED) == TRUE){
        setvar(VAR_TEMP_0, 0)

        // check Smeargle
        checkpartymove(MOVE_SKETCH)
        if(var(VAR_RESULT) != PARTY_SIZE){
            setvar(VAR_TEMP_0, 1) // Smeargle got rare candy and still has Sketch
        }
        // check Gardevoir
        checkpartymonlevel(31)
        if(var(VAR_RESULT) != PARTY_SIZE){
            setvar(VAR_TEMP_0, 2) // Gardevoir got rare candy
        }

        if(var(VAR_TEMP_0) == 1 || var(VAR_TEMP_0) == 2){
            call(EscapeRoom_EventScript_UndoRareCandy)
            releaseall
            end
        }
    }
    
    // SKETCH REVERT
    // if smeargle in party and game is post-Gardy trade
    checkpartymon(SPECIES_SMEARGLE)
    if(var(VAR_RESULT) != PARTY_SIZE && flag(FLAG_GARDEVOIR_TRADE_SUCCESS) == TRUE){
        copyvar(VAR_TEMP_0, VAR_RESULT) // store smeargle slot

        // if smeargle does not have Sketch
        checkpartymove(MOVE_SKETCH)
        if(var(VAR_RESULT) == PARTY_SIZE){

            // moves == 1
            checkpartymonmoves(VAR_TEMP_0)
            if(var(VAR_RESULT) == 1){ 

                // check if DS. Abel defeated
                if (flag(FLAG_DS_ABEL_DEFEATED) == FALSE){
                    call(EscapeRoom_EventScript_UndoSketch1)
                    releaseall
                    end
                }
            }
            // moves == 2
            elif(var(VAR_RESULT) == 2){ 

                // check if Roel defeated
                if (flag(FLAG_ROEL_DEFEATED) == FALSE){
                    call(EscapeRoom_EventScript_UndoSketch2)
                    releaseall
                    end
                }
            }
        }
    }

    // if no potential softlocks:
    msgbox(AntiSoftlockIntroMessage)
    msgbox(AntiSoftlockNoActionMessage)
    releaseall
}

script EscapeRoom_EventScript_UndoSmeargleCatch{
    msgbox(AskReleaseSmeargleMessage, MSGBOX_YESNO)

    // release accepted
    if (var(VAR_RESULT) == YES){

        // if smeargle in box
        checkpartymon(SPECIES_SMEARGLE)
        if(var(VAR_RESULT) == PARTY_SIZE){
            msgbox(SmeargleReleaseBringSmeargleMessage, MSGBOX_AUTOCLOSE)
            waitmessage
            releaseall
            end
        }

        // if starter has fainted
        partymonhasfainted
        if (var(VAR_0x8004) == SPECIES_TOXICROAK){
            msgbox(SmeargleReleaseHealSecondMonMessage, MSGBOX_AUTOCLOSE)
            waitmessage
        }
        // if starter in box
        getpartysize
        if(var(VAR_RESULT) < 2){ 
            msgbox(SmeargleReleaseGetSecondMonMessage, MSGBOX_AUTOCLOSE)
            waitmessage
        }
        // release smeargle
        else{
            removemon(SPECIES_SMEARGLE)
            clearflag(FLAG_POKEMON_CAUGHT)
            clearflag(FLAG_GREAT_BALL_USED)
            
            // check flameorb and add dialogue
            setvar(VAR_TEMP_0, 0)
            checkitem(ITEM_FLAME_ORB) // remove from bag
            if(var(VAR_RESULT) == TRUE){
                setvar(VAR_TEMP_0, 1)
                removeitem(ITEM_FLAME_ORB)
            }
            checkpartyitem(0) // remove from pokemon
            if(var(VAR_0x8005) == ITEM_FLAME_ORB) {
                setvar(VAR_TEMP_0, 1)
                removepartyitem(0)
            }

            // extra dialogue if orb was taken.
            if(var(VAR_TEMP_0) == 1){
                msgbox(TakeFlameOrbMessage, MSGBOX_AUTOCLOSE)
                waitmessage
            }

            giveitem(ITEM_GREAT_BALL)
            msgbox(ReleaseSmeargleMessage, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    // trade declined
    else{
        msgbox(AntiSoftlockDeclinedMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
}

script EscapeRoom_EventScript_UndoRareCandy{
    msgbox(UndoRareCandyMessage, MSGBOX_YESNO)

    // undo accepted
    if (var(VAR_RESULT) == YES){
        if(var(VAR_TEMP_0) == 1){
            levelDownMon(SPECIES_SMEARGLE)
        }
        elif(var(VAR_TEMP_0) == 2){
            levelDownMon(SPECIES_GARDEVOIR)
        }
        clearflag(FLAG_RARE_CANDY_USED)
        giveitem(ITEM_RARE_CANDY)
    }
    // undo declined
    else{
        msgbox(AntiSoftlockDeclinedMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
}

script EscapeRoom_EventScript_UndoSketch1{
    msgbox(UndoSketchMessage, MSGBOX_YESNO)

    // revert Sketch
    if (var(VAR_RESULT) == YES){
        setvar(VAR_TEMP_1, 0)  // moveslot
        getpartymonmove(VAR_TEMP_0, VAR_TEMP_1)

        setvar(VAR_TEMP_2, MOVE_SKETCH)
        replacemove(VAR_TEMP_0, VAR_RESULT, VAR_TEMP_2)

        // msgbox(SmeargleForgotMove, MSGBOX_AUTOCLOSE)
        // waitmessage
        playfanfare(MUS_LEVEL_UP)
        msgbox(SmeargleLearnedSketch)
        waitfanfare
    }
    // undo declined
    else{
        msgbox(AntiSoftlockDeclinedMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
}

script EscapeRoom_EventScript_UndoSketch2{
    msgbox(UndoSketchMessage, MSGBOX_YESNO)

    // revert Sketch
    if (var(VAR_RESULT) == YES){

        setvar(VAR_TEMP_1, 0)  // moveslot
        getpartymonmove(VAR_TEMP_0, VAR_TEMP_1)

        // check other moveslot if move is Protect
        if (var(VAR_RESULT) == MOVE_PROTECT){ 
            setvar(VAR_TEMP_1, 1)
            getpartymonmove(VAR_TEMP_0, VAR_TEMP_1)
        }

        setvar(VAR_TEMP_2, MOVE_SKETCH)
        replacemove(VAR_TEMP_0, VAR_RESULT, VAR_TEMP_2)

        // msgbox(SmeargleForgotMove, MSGBOX_AUTOCLOSE)
        // waitmessage
        playfanfare(MUS_LEVEL_UP)
        msgbox(SmeargleLearnedSketch)
        waitfanfare
    }
    // undo declined
    else{
        msgbox(AntiSoftlockDeclinedMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
}

