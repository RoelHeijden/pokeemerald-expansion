
////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: EscapeRoom_MapScript_OnTransitionScripts
    MAP_SCRIPT_ON_RESUME: EscapeRoom_MapScripts_SetHoleWarp
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_WARP_COUNTER, 0: EscapeRoom_MapScript_setNPCfacing
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 0: EscapeRoom_MapScripts_PlayStartMessage
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 1: EscapeRoom_MapScripts_GetFirstPokemon
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 2: EscapeRoom_MapScripts_GetBadges
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 3: EscapeRoom_MapScripts_SetRespawn
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 4: EscapeRoom_MapScripts_GetItems
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 5: EscapeRoom_MapScripts_TurnOfBagUse
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 6: EscapeRoom_MapScripts_FixCrackedGround
        VAR_ICE_STEP_COUNT, 0: EventScript_FallDownHole
    ] 
}

script EscapeRoom_MapScript_OnTransitionScripts{
    call(EscapeRoom_MapScript_KeepDouble1Moved)
    call(CaveHole_FixCrackedGround)
}

script EscapeRoom_MapScript_setNPCfacing{
    turnobject(7, DIR_SOUTH)
    turnobject(11, DIR_EAST)
    turnobject(12, DIR_NORTH)
    turnobject(15, DIR_WEST)
    turnobject(16, DIR_SOUTH)
    turnobject(17, DIR_EAST)
    turnobject(18, DIR_NORTH)
    turnobject(19, DIR_WEST)
    turnobject(20, DIR_SOUTH)
    end
}

script EscapeRoom_MapScript_KeepDouble1Moved {
    if(flag(FLAG_DOUBLE1_COMPLETED)){
        setobjectxyperm(1, 6, 11)
        setobjectxyperm(2, 6, 10)
    }
}

script EscapeRoom_MapScripts_SetHoleWarp{
    setstepcallback(STEP_CB_CRACKED_FLOOR)
    setholewarp(MAP_ESCAPE_ROOM_ICE_PUZZLE)
}

script EscapeRoom_MapScripts_FixCrackedGround{
    setvar(VAR_ICE_STEP_COUNT, 1)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 7)
}

script EscapeRoom_MapScripts_PlayStartMessage{
    lockall
    msgbox(StartMessage)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 1)
    releaseall
}

script EscapeRoom_MapScripts_GetFirstPokemon{
    givemon(
        SPECIES_GOTHITA, 
        30, 
        item=ITEM_IRON_BALL,
        abilityNum=2,
        nature=11, // Hasty 
        move1=MOVE_THIEF,
        move2=MOVE_HELPING_HAND, 
        move3=MOVE_NONE, 
        move4=MOVE_NONE,
        // EVS:
        speedEv=236,
        // IVS:
        hpIv=0,
        atkIv=31,
        defIv=0,
        speedIv=31,
        spAtkIv=31,
        spDefIv=31,
        )
    setflag(FLAG_SYS_POKEMON_GET)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 2)
}

script EscapeRoom_MapScripts_GetBadges{
    setflag(FLAG_DEFEATED_RUSTBORO_GYM)
    setflag(FLAG_BADGE01_GET)
    setflag(FLAG_DEFEATED_DEWFORD_GYM)
    setflag(FLAG_BADGE02_GET)
    setflag(FLAG_DEFEATED_MAUVILLE_GYM)
    setflag(FLAG_BADGE03_GET)
    setflag(FLAG_DEFEATED_LAVARIDGE_GYM)
    setflag(FLAG_BADGE04_GET)
    setflag(FLAG_DEFEATED_PETALBURG_GYM)
    setflag(FLAG_BADGE05_GET)
    setflag(FLAG_DEFEATED_FORTREE_GYM)
    setflag(FLAG_BADGE06_GET)
    setflag(FLAG_DEFEATED_MOSSDEEP_GYM)
    setflag(FLAG_BADGE07_GET)
    setflag(FLAG_DEFEATED_SOOTOPOLIS_GYM)
    setflag(FLAG_BADGE08_GET)

    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 3)
    end
}

script EscapeRoom_MapScripts_SetRespawn{
    setrespawn(HEAL_LOCATION_ESCAPE_ROOM_NURSE)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 4)
}

script EscapeRoom_MapScripts_GetItems{
    additem(ITEM_HEART_SCALE)
    additem(ITEM_NUGGET, 13)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 5)
}

script EscapeRoom_MapScripts_TurnOfBagUse{
    if (flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 6)
}


