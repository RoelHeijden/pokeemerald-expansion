script EscapeRoom_EventScript_Double1WalkAwayAndHeal{
    lockall
    msgbox(Double1Finalwords)
    waitmessage
    applymovement(1, EscapeRoom_Movement_Double1End)
    applymovement(2, EscapeRoom_Movement_Double1End)
