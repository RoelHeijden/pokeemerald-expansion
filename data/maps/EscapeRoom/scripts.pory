script EscapeRoom_EventScript_GoodSmeargle_NPC{
    lockall
    faceplayer
    if (flag(FLAG_OBTAINED_PERFECT_SMEARGLE)){
        msgbox(SmeargleMessageCompleted)
        waitmessage
        releaseall
        end
    }
    getpartysize
    if (var(VAR_RESULT) < 2){  # no extra pokemon in party
        checkpartymove(MOVE_THIEF)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_GOTHITA){  // mon is Gothita
            msgbox(SmeargleMessageInitial)
            waitmessage
            releaseall
            end
        }
        checkpartymove(MOVE_PROTECT)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SHEDINJA){  // mon is Shedinja
            msgbox(SmeargleMessageInitial)
            waitmessage
            releaseall
            end
        }
        checkpartymove(MOVE_SKETCH)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){   # Smeargle has Sketch
            msgbox(SmeargleMessagePerfectButGothitaInBox)
            waitmessage
            releaseall
            end
        }
        checkpartymove(MOVE_PROTECT)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Protect
            msgbox(SmeargleMessagePerfectButGothitaInBox)
            waitmessage
            releaseall
            end
        }
    }
    else{  // user has a second pokemon
        checkpartymove(MOVE_SKETCH)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Sketch
            msgbox(SmeargleMessagePerfect, MSGBOX_YESNO)
            waitmessage
            call(EscapeRoom_EventScript_IniitializeGardevoirTrade)
            releaseall
            end
        }
        checkpartymove(MOVE_PROTECT)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Protect
            msgbox(SmeargleMessagePerfect, MSGBOX_YESNO)
            waitmessage
            call(EscapeRoom_EventScript_IniitializeGardevoirTrade)
            releaseall
            end
        }
    }
    msgbox(SmeargleMessageBad, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES){
        getpartysize
        if (var(VAR_RESULT) >= 2){
            partymonhasfainted
            if (var(VAR_0x8004) == SPECIES_GOTHITA){
                msgbox(SmeargleReleaseHealSecondMonMessage, MSGBOX_AUTOCLOSE)
                waitmessage
            }
            else{
                removemon(SPECIES_SMEARGLE)
                clearflag(FLAG_POKEMON_CAUGHT)
                clearflag(FLAG_GREAT_BALL_USED)
                giveitem(ITEM_GREAT_BALL)
                msgbox(ReleaseSmeargleMessage, MSGBOX_AUTOCLOSE)
                waitmessage
            }
        }
        else{
            msgbox(SmeargleReleaseGetSecondMonMessage, MSGBOX_AUTOCLOSE)
            waitmessage
        }
    }
    else{
        msgbox(SmeargleReleaseDeclinedMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
    releaseall
    end 
}

script EscapeRoom_EventScript_IniitializeGardevoirTrade{
    if(var(VAR_RESULT) == YES){
        removemon(SPECIES_GOTHITA)
        givemon(
            SPECIES_GARDEVOIR, 
            30, 
            abilityNum=0,
            item=ITEM_NUGGET
            nature=5, // Bold 
            move1=MOVE_TRICK_ROOM,
            move2=MOVE_SKILL_SWAP, 
            move3=MOVE_NONE, 
            move4=MOVE_NONE,
            // EVS:
            hpEv=132,
            defEv=212,
            speedEv=52,
            // IVS:
            hpIv=31,
            atkIv=0,
            defIv=31,
            speedIv=31,
            spAtkIv=31,
            spDefIv=31,
        )
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox(GardevoirObtainedMessage, MSGBOX_AUTOCLOSE)
        waitfanfare
        msgbox(TradeAcceptedMessage, MSGBOX_AUTOCLOSE)
        setflag(FLAG_OBTAINED_PERFECT_SMEARGLE)
    }
    else{
        msgbox(TradeDeclinedMessage)
    }
}

