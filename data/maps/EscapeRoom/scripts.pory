        clearflag(FLAG_TOGGLE_BAG_USE)
    }
    createmon(
        side=1,
        slot=0,
        species=SPECIES_SMEARGLE,
        level=20,
        abilityNum=0,
        nature=7, // Bold 
        move1=MOVE_SKETCH,
        move2=MOVE_NONE, 
        move3=MOVE_NONE, 
        move4=MOVE_NONE,
        // EVS:
        defEv=208,
        // IVS:
        hpIv=11,
        atkIv=0,
        defIv=31,
        speedIv=0,
        spAtkIv=31,
        spDefIv=31,
    )
    dowildbattle
    setflag(FLAG_TOGGLE_BAG_USE)
}

