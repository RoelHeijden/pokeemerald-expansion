
////////////////////////////////////////// MAP SCRIPTS //////////////////////////////////////////

mapscripts EscapeRoom_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 0: EscapeRoom_MapScripts_PlayStartMessage
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 1: EscapeRoom_MapScripts_GetFirstPokemon
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 2: EscapeRoom_MapScripts_GetBadges
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 3: EscapeRoom_MapScripts_SetRespawn
        VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 4: EscapeRoom_MapScripts_GetIronBall
    ] 
}

script EscapeRoom_MapScripts_PlayStartMessage{
    lockall
    msgbox(StartMessage)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 1)
    releaseall
}

script EscapeRoom_MapScripts_GetFirstPokemon{
    // givemon species:req, level:req, item, ball, nature, abilityNum, gender, hpEv, atkEv, defEv, speedEv, spAtkEv, spDefEv, 
    // hpIv, atkIv, defIv, speedIv, spAtkIv, spDefIv, move1, move2, move3, move4, isShiny, ggMaxFactor, teraType
    givemon(
        SPECIES_GARDEVOIR, 
        30, 
        abilityNum=0,
        nature=5, // Bold 
        move1=MOVE_DISABLE,
        move2=MOVE_SKILL_SWAP, 
        move3=MOVE_NONE, 
        move4=MOVE_NONE,
        // EVS:
        hpEv=132,
        defEv=252,
        speedEv=52,
        // IVS:
        hpIv=31,
        atkIv=0,
        defIv=31,
        speedIv=31,
        spAtkIv=31,
        spDefIv=31,
        )
    setflag(FLAG_SYS_POKEMON_GET)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 2)
}

script EscapeRoom_MapScripts_GetBadges{
    setflag(FLAG_DEFEATED_RUSTBORO_GYM)
    setflag(FLAG_BADGE01_GET)
    setflag(FLAG_DEFEATED_DEWFORD_GYM)
    setflag(FLAG_BADGE02_GET)
    setflag(FLAG_DEFEATED_MAUVILLE_GYM)
    setflag(FLAG_BADGE03_GET)
    setflag(FLAG_DEFEATED_LAVARIDGE_GYM)
    setflag(FLAG_BADGE04_GET)
    setflag(FLAG_DEFEATED_PETALBURG_GYM)
    setflag(FLAG_BADGE05_GET)
    setflag(FLAG_DEFEATED_FORTREE_GYM)
    setflag(FLAG_BADGE06_GET)
    setflag(FLAG_DEFEATED_MOSSDEEP_GYM)
    setflag(FLAG_BADGE07_GET)
    setflag(FLAG_DEFEATED_SOOTOPOLIS_GYM)
    setflag(FLAG_BADGE08_GET)

    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 3)
    end
}

script EscapeRoom_MapScripts_SetRespawn{
    setrespawn(HEAL_LOCATION_ESCAPE_ROOM_NURSE)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 4)
}

script EscapeRoom_MapScripts_GetIronBall{
    additem(ITEM_IRON_BALL)
    setvar(VAR_ESCAPE_ROOM_MAPSCRIPT_COUNTER, 5)
}



////////////////////////////////////////// EVENT SCRIPTS //////////////////////////////////////////


script EscapeRoom_EventScript_TestSign {
    lockall
    msgbox(SignMessage1)
    releaseall
}

script EscapeRoom_Nurse_Heal_Pokemon{
    lockall
    fadescreen(FADE_TO_BLACK)
	special(HealPlayerParty)
	fadescreen(FADE_FROM_BLACK)
    msgbox(Nurse_Heal_End)
    releaseall
}

script EscapeRoom_Wild_Smeargle{
    createmon(
        side=1,
        slot=0,
        species=SPECIES_SMEARGLE,
        level=20,
        item=ITEM_TM_TRICK_ROOM, 
        abilityNum=0,
        nature=7, // Bold 
        move1=MOVE_SKETCH,
        move2=MOVE_NONE, 
        move3=MOVE_NONE, 
        move4=MOVE_NONE,
        // EVS:
        defEv=208,
        // IVS:
        hpIv=11,
        atkIv=0,
        defIv=31,
        speedIv=9,
        spAtkIv=31,
        spDefIv=31,
    )
    dowildbattle
}

script EscapeRoom_Wild_Shedinja{
    createmon(
        side=1,
        slot=0,
        species=SPECIES_SHEDINJA,
        level=12,
        item=ITEM_FLAME_ORB, 
        move1=MOVE_PROTECT,
        move2=MOVE_HARDEN, 
        move3=MOVE_NONE, 
        move4=MOVE_NONE,
    )
    dowildbattle
}

script EscapeRoom_EventScript_DoubleBattle1{
    if (flag(FLAG_TOGGLE_BAG_USE) == FALSE){
        setflag(FLAG_TOGGLE_BAG_USE)
    }
    trainerbattle_double(
        TRAINER_MY_CUSTOM_DOUBLE_BATTLE1, 
        Double1Puzzle_Intro, 
        Double1Puzzle_Outro, 
        Double1Puzzle_NotEnoughMons,
        event_script=EscapeRoom_EventScript_PostDouble1Heal,
    )
    msgbox(Double1Puzzle_PostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

script EscapeRoom_EventScript_PostDouble1Heal{
    setflag(FLAG_TOGGLE_BAG_USE)
    msgbox(Double1Puzzle_Heal, MSGBOX_AUTOCLOSE)
    fadescreen(FADE_TO_BLACK)
    special(HealPlayerParty)
    fadescreen(FADE_FROM_BLACK)
}

script EscapeRoom_EventScript_FindRareCandy{
    lockall
    giveitem(ITEM_RARE_CANDY)
    removeobject(1)
    setflag(FLAG_RARE_CANDY_OBTAINED)
    releaseall
}

script EscapeRoom_EventScript_GoodSmeargle_NPC{
    lockall
    if (flag(FLAG_OBTAINED_PAIN_SPLIT)){
        msgbox(SmeargleMessageCompleted)
        releaseall
        end
    }
    
    # check amount of pokemon
    getpartysize
    if (var(VAR_RESULT) >= 2)  # smeargle/shedinja obtained
    {
        checkpartymove(MOVE_HARDEN)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SHEDINJA){  # Shedinja is caught
            msgbox(SmeargleMessageInitial)
            releaseall
            end
        }
        else{  # Smeargle is caught

            checkpartymove(MOVE_SKETCH)
            if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Sketch

                checkpartymove(MOVE_PROTECT)
                if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Protect as well
                    msgbox(SmeargleMessagePerfect)
                    EscapeRoom_EventScript_GetPainSplit
                    releaseall
                    end
                }
                checkpartymove(MOVE_PERISH_SONG)
                if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Perish Song as well
                    msgbox(SmeargleMessageConfusedButGood)
                    EscapeRoom_EventScript_GetPainSplit
                    releaseall
                    end
                }
                if (!flag(FLAG_RARE_CANDY_USED)){  # rare candy hasnt been used yet
                    msgbox(SmeargleMessageGood)
                    EscapeRoom_EventScript_GetPainSplit
                    releaseall
                    end
                }
                else{  # rare candy has already been used
                    msgbox(SmeargleMessageUnsaveable)
                    releaseall
                    end
                }

            }
            checkpartymove(MOVE_PROTECT)
            if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Protect

                checkpartymove(MOVE_PERISH_SONG)
                if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Perish Song as well
                    msgbox(SmeargleMessagePerfect)
                    EscapeRoom_EventScript_GetPainSplit
                    releaseall
                    end
                }  
                if (!flag(FLAG_RARE_CANDY_USED)){  # rare candy hasnt been used yet
                    msgbox(SmeargleMessageGood)
                    EscapeRoom_EventScript_GetPainSplit
                    releaseall
                    end
                }
                else{  # rare candy has already been used
                    msgbox(SmeargleMessageUnsaveable)
                    releaseall
                    end
                }
            }
            # Smeargle was caught but has none of the good moves
            msgbox(SmeargleMessageBad)
            releaseall
            end 
        }
    }
    else{  # no extra pokemon was caught
        msgbox(SmeargleMessageInitial)
    }
    releaseall
    end
}

script EscapeRoom_EventScript_GetPainSplit{
    giveitem(ITEM_TM_PAIN_SPLIT)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("Recieved TM202!")
    setflag(FLAG_OBTAINED_PAIN_SPLIT)
}



