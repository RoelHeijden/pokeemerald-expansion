    end
}

script EscapeRoom_EventScript_TeleportBackOverLedge{
    // check if item stolen
    if(flag(FLAG_TM_18_STOLEN) == TRUE){
        msgbox(Single3Puzzle_PostBattleStolen, MSGBOX_YESNO)
    }
    else{
        msgbox(Single3Puzzle_PostBattleNotStolen, MSGBOX_YESNO)
    }
    if(var(VAR_RESULT) == YES){
        msgbox(YesTeleportOutMessage, MSGBOX_AUTOCLOSE)
        waitmessage
        warpteleport(MAP_ESCAPE_ROOM, 10, 26)

        // TBD: return money

        // reset trainer flag
        clearflag(FLAG_SINGLE_BATTLE3)

        // if item was stolen
        if(flag(FLAG_TM_18_STOLEN) == TRUE){
            // locate and return item    
            checkpartyitem(0)
            if(var(VAR_0x8004) == ITEM_TM18) {  // if item in party slot 0
                removepartyitem(0)
            }
            checkpartyitem(1)
            if(var(VAR_0x8004) == ITEM_TM18) {  // if item in party slot 1
                removepartyitem(1)
            }
            removeitem(ITEM_TM18)

            // unlearn move if learnt
            checkpartymove(MOVE_RAIN_DANCE)
            if (var(VAR_RESULT) != PARTY_SIZE){ // move is learnt
                if(var(VAR_RESULT) == 0){
                    // checkpartymoveslot(0, MOVE_RAIN_DANCE)
                    // copyvar(VAR_TEMP_1, VAR_RESULT)  
                    // setmonmove(0, VAR_TEMP_1, MOVE_NONE)
                    setmonmove(0, 0, MOVE_THIEF)
                    setmonmove(0, 1, MOVE_HELPING_HAND)
                    setmonmove(0, 2, MOVE_NONE)
                    setmonmove(0, 3, MOVE_NONE)
                }
                elif(var(VAR_RESULT) == 1){
                    setmonmove(0, 0, MOVE_THIEF)
                    setmonmove(0, 1, MOVE_HELPING_HAND)
                    setmonmove(0, 2, MOVE_NONE)
                    setmonmove(0, 3, MOVE_NONE)
                }
            }
            // reset item stolen flag
            clearflag(FLAG_TM_18_STOLEN)
        }
    }
    else{
        msgbox(NoTeleportPleaseMessage, MSGBOX_AUTOCLOSE)
        waitmessage
    }
}

script EscapeRoom_EventScript_DoubleBattle1{
    trainerbattle_double(
        TRAINER_MY_CUSTOM_DOUBLE_BATTLE1, 
        Double1Puzzle_Intro, 
        Double1Puzzle_Outro, 
        Double1Puzzle_NotEnoughMons,
        event_script=EscapeRoom_EventScript_Double1WalkAwayAndHeal,
        // music=FALSE,
    )
    msgbox(Double1Puzzle_PostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

script EscapeRoom_EventScript_Double1WalkAwayAndHeal{
    lockall
    msgbox(Double1Finalwords)
    waitmessage
    applymovement(1, EscapeRoom_Movement_Double1End)
    applymovement(2, EscapeRoom_Movement_Double1End)
    waitmovement(0)
    copyobjectxytoperm(1)
    copyobjectxytoperm(2)
    call(EscapeRoom_EventScript_PostMatchHeal)
    setflag(FLAG_DOUBLE1_COMPLETED)
    releaseall
    end
}

movement EscapeRoom_Movement_Double1End{
    walk_left * 3
    face_right
}

script EscapeRoom_EventScript_PostMatchHeal{
    // fadescreen(FADE_TO_BLACK)
    special(HealPlayerParty)
    // fadescreen(FADE_FROM_BLACK)
}

script EscapeRoom_EventScript_GetSitrusBerriesAndHeal{
