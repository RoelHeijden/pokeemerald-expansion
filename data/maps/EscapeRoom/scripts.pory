script EscapeRoom_EventScript_GoodSmeargle_NPC{
    lockall
    faceplayer
    if (flag(FLAG_OBTAINED_PERFECT_SMEARGLE)){
        msgbox(SmeargleMessageCompleted)
        waitmessage
        releaseall
        end
    }
    getpartysize
    if (var(VAR_RESULT) < 2){  # no extra pokemon was caught
        checkpartymove(MOVE_THIEF)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_GOTHITA){  // mon is Gothita
            msgbox(SmeargleMessageInitial)
            waitmessage
            releaseall
            end
        }
        checkpartymove(MOVE_PROTECT)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SHEDINJA){  // mon is Shedinja
            msgbox(SmeargleMessageInitial)
            waitmessage
            releaseall
            end
        }
        checkpartymove(MOVE_SKETCH)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){   # Smeargle has Sketch
            msgbox(SmeargleMessagePerfectButGothitaInBox)
            waitmessage
            releaseall
            end
        }
        checkpartymove(MOVE_PROTECT)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Protect
            msgbox(SmeargleMessagePerfectButGothitaInBox)
            waitmessage
            releaseall
            end
        }
    }
    else{  // user has a second pokemon
        checkpartymove(MOVE_SKETCH)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Sketch
            msgbox(SmeargleMessagePerfect, MSGBOX_YESNO)
            waitmessage
            call(EscapeRoom_EventScript_IniitializeGardevoirTrade)
            releaseall
            end
        }
        checkpartymove(MOVE_PROTECT)
        if (var(VAR_RESULT) != PARTY_SIZE && var(VAR_0x8004) == SPECIES_SMEARGLE){  # Smeargle has Protect
            msgbox(SmeargleMessagePerfect, MSGBOX_YESNO)
            waitmessage
            call(EscapeRoom_EventScript_IniitializeGardevoirTrade)
            releaseall
            end
        }
    }
    msgbox(SmeargleMessageBad)
    waitmessage
    releaseall
    end 
}

script EscapeRoom_EventScript_IniitializeGardevoirTrade{
    if(var(VAR_RESULT) == YES){
        // get gothita party slot
        checkpartymove(MOVE_HELPING_HAND)

        // slot 0
        if(var(VAR_RESULT) == 0){  
            // add held item to inventory
            checkpartyitem(0)
            if (var(VAR_RESULT) == 1) {  
                copyvar(VAR_TEMP_1, VAR_0x8004) // VAR_TEMP_1 = item
                additem(VAR_TEMP_1, 1) 
            }
            // override with new Pokemon
            createmon(
                0, // side
                0, // slot
                SPECIES_GARDEVOIR, 
                30, 
                abilityNum=0,
                item=ITEM_NUGGET
                nature=5, // Bold 
                move1=MOVE_TRICK_ROOM,
                move2=MOVE_SKILL_SWAP, 
                move3=MOVE_NONE, 
                move4=MOVE_NONE,
                // EVS:
                hpEv=132,
                defEv=212,
                speedEv=52,
                // IVS:
                hpIv=31,
                atkIv=0,
                defIv=31,
                speedIv=31,
                spAtkIv=31,
                spDefIv=31,
            )
        }
        // slot 1
        else{
            // add held item to inventory
            checkpartyitem(1)
            if (var(VAR_RESULT) == 1) {  
                copyvar(VAR_TEMP_1, VAR_0x8004) // VAR_TEMP_1 = item
                additem(VAR_TEMP_1, 1) 
            }
            // override with new Pokemon
            createmon(
                0, // side
                1, // slot
                SPECIES_GARDEVOIR, 
                30, 
                abilityNum=0,
                item=ITEM_NUGGET
                nature=5, // Bold 
                move1=MOVE_TRICK_ROOM,
                move2=MOVE_SKILL_SWAP, 
                move3=MOVE_NONE, 
                move4=MOVE_NONE,
                // EVS:
                hpEv=132,
                defEv=212,
                speedEv=52,
                // IVS:
                hpIv=31,
                atkIv=0,
                defIv=31,
                speedIv=31,
                spAtkIv=31,
                spDefIv=31,
            )
        }
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox(GardevoirObtainedMessage)
        waitfanfare
        msgbox(TradeAcceptedMessage, MSGBOX_AUTOCLOSE)
        setflag(FLAG_OBTAINED_PERFECT_SMEARGLE)
    }
    else{
        msgbox(TradeDeclinedMessage)
    }
}

